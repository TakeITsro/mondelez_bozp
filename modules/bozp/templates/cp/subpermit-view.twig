{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{# ---------------------------------------------------------------------------
   CP Subpermit detail — read-only view for HSE officer.
   Variables from QueueController::actionSubpermitView():
     permit (PermitRecord), subpermit (SubpermitRecord),
     subpermitType (SubpermitType|null), values (decoded data array),
     signatures (keyed by role), canApprove (bool),
     subpermitTypes (SubpermitType::cases())
--------------------------------------------------------------------------- #}

{% set appendixN = subpermitType ? subpermitType.appendixNumber() : '?' %}
{% set typeLabel = subpermitType ? subpermitType.label() : subpermit.type %}

{% set title = ('Príloha č. {n} — {type}'|t('bozp'))|replace({'{n}': appendixN, '{type}': typeLabel}) %}
{% set selectedSubnavItem = 'queue' %}

{% set crumbs = [
    { label: 'BOZP Permity'|t('bozp'), url: cpUrl('bozp') },
    { label: permit.permitNumber, url: cpUrl('bozp/permit/' ~ permit.id) },
    { label: ('Príloha č. {n}'|t('bozp'))|replace({'{n}': appendixN}), url: '' }
] %}

{% set statusLabels = {
    'pending':   'Čaká na schválenie'|t('bozp'),
    'approved':  'Schválené'|t('bozp'),
    'rejected':  'Zamietnuté'|t('bozp'),
    'cancelled': 'Zrušené'|t('bozp'),
} %}

{% block headHtml %}
<style>
.bozp-status{display:inline-block;padding:2px 10px;border-radius:12px;font-size:.8em;font-weight:600;line-height:1.6;white-space:nowrap;color:#fff}
.bozp-status--draft{background:#6b7280}.bozp-status--submitted{background:#d97706}
.bozp-status--approved{background:#16a34a}.bozp-status--rejected{background:#dc2626}
.bozp-status--signed{background:#2563eb}.bozp-status--active{background:#0891b2}
.bozp-status--pending_closure{background:#ea580c}.bozp-status--pending{background:#d97706}
.bozp-status--closed{background:#374151}.bozp-status--cancelled{background:#991b1b}
.bozp-status--expired{background:#9f1239}
.bozp-sp-sig-grid{display:flex;gap:24px;flex-wrap:wrap;margin-top:8px;}
.bozp-sp-sig-slot{flex:1;min-width:220px;border:1px solid #e3e5e8;border-radius:4px;padding:14px;}
.bozp-sp-sig-slot h4{margin:0 0 10px;font-size:13px;font-weight:600;}
.bozp-sp-sig-slot img{display:block;max-width:280px;max-height:110px;border:1px solid #eee;background:#fff;margin-bottom:8px;}
</style>
{% endblock %}

{% block content %}
<div class="content-pane">

    {# ---- Header ---- #}
    <div class="flex flex-nowrap" style="justify-content:space-between;align-items:flex-start;margin-bottom:4px;">
        <div>
            <h2 style="margin:0;">
                {{ 'Príloha č. {n}'|t('bozp', {n: appendixN}) }} — {{ typeLabel }}
            </h2>
            <div style="margin-top:6px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <span class="bozp-status bozp-status--{{ subpermit.status }}">
                    {{ statusLabels[subpermit.status] ?? subpermit.status }}
                </span>
                <span class="light" style="font-size:12px;">
                    {{ 'Permit'|t('bozp') }}:
                    <a href="{{ cpUrl('bozp/permit/' ~ permit.id) }}">{{ permit.permitNumber }}</a>
                </span>
                {% if subpermit.status == 'approved' and subpermit.expiresAt %}
                    <span class="light" style="font-size:12px;">
                        {{ 'Platný do'|t('bozp') }}: <strong>{{ subpermit.expiresAt|date('d.m.Y H:i') }}</strong>
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="flex" style="gap:8px;">
            <a href="{{ url('bozp/permit/' ~ permit.id ~ '/subpermit/' ~ subpermit.id ~ '/pdf') }}"
               target="_blank" rel="noopener"
               class="btn small">⬇ {{ 'Zobraziť PDF'|t('bozp') }}</a>
            {% if canApprove %}
                <a href="{{ cpUrl('bozp/permit/' ~ permit.id ~ '/subpermit/' ~ subpermit.id ~ '/edit') }}"
                   class="btn">{{ 'Upraviť'|t('bozp') }}</a>
            {% endif %}
            <a href="{{ cpUrl('bozp/permit/' ~ permit.id) }}" class="btn">← {{ 'Späť'|t('bozp') }}</a>
        </div>
    </div>

    <hr>

    {# ---- Rejection note ---- #}
    {% if subpermit.status == 'rejected' and subpermit.rejectionNote %}
        <p class="error" style="margin-bottom:16px;">
            <strong>{{ 'Dôvod zamietnutia'|t('bozp') }}:</strong> {{ subpermit.rejectionNote }}
        </p>
    {% endif %}

    {# ---- Common fields ---- #}
    <h3>{{ 'Základné informácie'|t('bozp') }}</h3>
    <table class="data fullwidth">
        <tbody>
            <tr>
                <th style="width:220px;">{{ 'Dátum'|t('bozp') }}</th>
                <td>{{ values.date ? values.date|date('d.m.Y') : '—' }}</td>
            </tr>
            <tr>
                <th>{{ 'Miesto výkonu'|t('bozp') }}</th>
                <td>{{ values.placeOfWork ?: '—' }}</td>
            </tr>
            <tr>
                <th>{{ 'Zodpovedná osoba MDLZ'|t('bozp') }}</th>
                <td>{{ values.responsiblePerson ?: '—' }}</td>
            </tr>
            {% if values.participants ?? '' %}
                <tr>
                    <th>{{ 'Zúčastnení dodávatelia / osoby'|t('bozp') }}</th>
                    <td>{{ values.participants }}</td>
                </tr>
            {% endif %}
            {% if values.workDescription ?? '' %}
                <tr>
                    <th>{{ 'Popis vykonávanej práce'|t('bozp') }}</th>
                    <td>{{ values.workDescription|nl2br }}</td>
                </tr>
            {% endif %}
            {% set hasSteps = false %}
            {% for i in 1..5 %}{% if attribute(values, 'workStep' ~ i) ?? '' %}{% set hasSteps = true %}{% endif %}{% endfor %}
            {% if hasSteps %}
                <tr>
                    <th>{{ 'Hlavné kroky'|t('bozp') }}</th>
                    <td>
                        <ol style="margin:0;padding-left:18px;">
                            {% for i in 1..5 %}
                                {% set step = attribute(values, 'workStep' ~ i) ?? '' %}
                                {% if step %}<li>{{ step }}</li>{% endif %}
                            {% endfor %}
                        </ol>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <th>{{ 'Vytvorené'|t('bozp') }}</th>
                <td>{{ subpermit.dateCreated|date('d.m.Y H:i') }}</td>
            </tr>
        </tbody>
    </table>

    {# ---- Command B — action grid rendered separately (nested array) ---- #}
    {% set commandBActions = (subpermitType and subpermitType.value == 'command_b')
        ? (values.actions ?? {})
        : {} %}
    {% if commandBActions|length > 0 %}
        {% set commandBGroups = {
            'turn_off':              'Vypnúť'|t('bozp'),
            'disconnected':          'Odpojené'|t('bozp'),
            'further_measures':      'Ďalšie opatrenia'|t('bozp'),
            'check_de_energized':    'Ako overiť, že inštalácia je bez napätia'|t('bozp'),
            'grounding_shorting':    'Uzemnenie a skratovanie'|t('bozp'),
            'workplace_marking':     'Spôsob označenia pracoviska'|t('bozp'),
            'workplace_definition':  'Vymedzenie pracoviska'|t('bozp'),
            'additional_safety':     'Doplnkové bezpečnostné opatrenia'|t('bozp'),
        } %}
        <h3 style="margin-top:24px;">{{ 'Opatrenia na zabezpečenie pracoviska'|t('bozp') }}</h3>
        {% for groupKey, groupLabel in commandBGroups %}
            {% set rows = commandBActions[groupKey] ?? [] %}
            {% if rows|length > 0 %}
                <h4>{{ groupLabel }}</h4>
                <table class="data fullwidth" style="margin-bottom:12px;">
                    <thead>
                        <tr>
                            <th>{{ 'Miesto'|t('bozp') }}</th>
                            <th>{{ 'Úkon'|t('bozp') }}</th>
                            <th>{{ 'Por. č.'|t('bozp') }}</th>
                            <th>{{ 'Zodpovedný'|t('bozp') }}</th>
                            <th>{{ 'Dátum / čas'|t('bozp') }}</th>
                            <th>{{ 'Podpis'|t('bozp') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.place ?: '—' }}</td>
                                <td>{{ row.description ?: '—' }}</td>
                                <td>{{ row.serialNumber ?: '—' }}</td>
                                <td>{{ row.responsible ?: '—' }}</td>
                                <td>{{ row.performedAt ? row.performedAt|replace({'T': ' '}) : '—' }}</td>
                                <td>{{ row.signatureName ?: '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endfor %}
    {% endif %}

    {# ---- Type-specific fields ---- #}
    {# 'actions' excluded — rendered above for command_b, and would break the
       generic |join() on its nested structure for any other type that adopts
       a similar shape. #}
    {% set commonKeys = ['date','placeOfWork','responsiblePerson','participants','workDescription',
        'workStep1','workStep2','workStep3','workStep4','workStep5','actions'] %}
    {% set typeValues = {} %}
    {% for k, v in values %}
        {% if k not in commonKeys and v is not empty %}
            {% set typeValues = typeValues|merge({(k): v}) %}
        {% endif %}
    {% endfor %}

    {% if typeValues|length > 0 %}
        <h3 style="margin-top:24px;">{{ 'Špecifické podmienky'|t('bozp') }}</h3>
        <table class="data fullwidth">
            <tbody>
                {% for k, v in typeValues %}
                    <tr>
                        <th style="width:220px;">{{ k }}</th>
                        <td>
                            {% if v is iterable %}
                                {# Guard against nested arrays — flat |join would PHP-throw
                                   "Array to string conversion" if any inner element is itself
                                   an array. Show a placeholder for nested data instead. #}
                                {% set hasNested = false %}
                                {% for el in v %}{% if el is iterable %}{% set hasNested = true %}{% endif %}{% endfor %}
                                {% if hasNested %}
                                    <em class="light">{{ '(zložené dáta)'|t('bozp') }}</em>
                                {% else %}
                                    {{ v|join(', ') }}
                                {% endif %}
                            {% elseif v == 'yes' %}
                                {{ 'Áno'|t('bozp') }}
                            {% elseif v == 'no' %}
                                {{ 'Nie'|t('bozp') }}
                            {% else %}
                                {{ v }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {# ---- Signatures ---- #}
    {% macro sigSlot(sig, label) %}
        <div class="bozp-sp-sig-slot">
            <h4>{{ label }}</h4>
            {% if sig %}
                {% set sigAsset = craft.assets().id(sig.signatureAssetId).one() %}
                {% if sigAsset %}
                    <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}">
                {% endif %}
                <table class="data" style="font-size:12px;">
                    <tr><th style="width:100px;">{{ 'Meno'|t('bozp') }}</th><td>{{ sig.signerName }}</td></tr>
                    {% if sig.signerEmployer %}
                        <tr><th>{{ 'Firma'|t('bozp') }}</th><td>{{ sig.signerEmployer }}</td></tr>
                    {% endif %}
                    <tr>
                        <th>{{ 'Dátum'|t('bozp') }}</th>
                        <td>{{ sig.signatureDate ? sig.signatureDate|date('d.m.Y') : '—' }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'Podpísané'|t('bozp') }}</th>
                        <td>{{ sig.signedAt ? sig.signedAt|date('d.m.Y H:i') : '—' }}</td>
                    </tr>
                </table>
            {% else %}
                <p class="light" style="font-size:13px;">{{ 'Nepodpísané'|t('bozp') }}</p>
            {% endif %}
        </div>
    {% endmacro %}

    <h3 style="margin-top:24px;">{{ 'Podpisy pred prácou'|t('bozp') }}</h3>
    <div class="bozp-sp-sig-grid">
        {% for role, label in {
            'issuer_prework':     'Vydavateľ — pred prácou'|t('bozp'),
            'contractor_prework': 'Dodávateľ — pred prácou'|t('bozp'),
        } %}
            {{ _self.sigSlot(signatures[role] ?? null, label) }}
        {% endfor %}
    </div>

    <h3 style="margin-top:24px;">{{ 'Podpisy pri uzavretí'|t('bozp') }}</h3>
    <div class="bozp-sp-sig-grid">
        {% for role, label in {
            'contractor':     'Dodávateľ — uzavretie'|t('bozp'),
            'issuer_closure': 'Vydavateľ — uzavretie'|t('bozp'),
        } %}
            {{ _self.sigSlot(signatures[role] ?? null, label) }}
        {% endfor %}
    </div>

    {# Legacy 'issuer' role — only render if data exists from pre-reorder rows. #}
    {% if signatures['issuer'] is defined and signatures['issuer'] %}
        <h3 style="margin-top:24px;">{{ 'Podpisy (legacy)'|t('bozp') }}</h3>
        <div class="bozp-sp-sig-grid">
            {{ _self.sigSlot(signatures['issuer'], 'Vydavateľ (legacy)'|t('bozp')) }}
        </div>
    {% endif %}

    {# ---- HSE approve / reject (only if pending) ---- #}
    {% if subpermit.status == 'pending' and canApprove %}
        {% set preworkReady = (signatures['issuer_prework'] ?? null) and (signatures['contractor_prework'] ?? null) %}

        <hr style="margin-top:32px;">
        <h3>{{ 'Rozhodnutie HSE'|t('bozp') }}</h3>

        {% if not preworkReady %}
            <p class="warning" style="background:#fff4e0;border-left:4px solid #d97706;padding:10px 14px;color:#7a3e00;">
                <strong>{{ 'Nie je možné schváliť'|t('bozp') }}:</strong>
                {% if not (signatures['issuer_prework'] ?? null) %}
                    {{ 'chýba predpracovný podpis vydavateľa.'|t('bozp') }}
                {% elseif not (signatures['contractor_prework'] ?? null) %}
                    {{ 'chýba predpracovný podpis dodávateľa.'|t('bozp') }}
                {% endif %}
            </p>
        {% endif %}

        <div class="flex" style="gap:32px;align-items:flex-start;flex-wrap:wrap;">
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/queue/approve-subpermit">
                <input type="hidden" name="permitId" value="{{ permit.id }}">
                <input type="hidden" name="id" value="{{ subpermit.id }}">
                <button type="submit" class="btn submit" {% if not preworkReady %}disabled{% endif %}>
                    {{ 'Schváliť subpermit'|t('bozp') }}
                </button>
                <span class="light" style="font-size:12px;margin-left:6px;">
                    {{ 'Platnosť 8 hodín od schválenia'|t('bozp') }}
                </span>
            </form>

            <form method="post" accept-charset="UTF-8"
                  style="display:flex;gap:8px;align-items:flex-start;">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/queue/reject-subpermit">
                <input type="hidden" name="permitId" value="{{ permit.id }}">
                <input type="hidden" name="id" value="{{ subpermit.id }}">
                <input type="text" name="rejectionNote"
                       placeholder="{{ 'Dôvod zamietnutia (povinné)'|t('bozp') }}"
                       required style="width:280px;">
                <button type="submit" class="btn">{{ 'Zamietnuť'|t('bozp') }}</button>
            </form>
        </div>
    {% endif %}

    {# ---- Edit subpermit data ---- #}
    {% if canApprove %}
        <hr style="margin-top:32px;">
        <h3>{{ 'Upraviť subpermit'|t('bozp') }}</h3>
        <a href="{{ cpUrl('bozp/permit/' ~ permit.id ~ '/subpermit/' ~ subpermit.id ~ '/edit') }}"
           class="btn">{{ 'Upraviť údaje subpermitu'|t('bozp') }}</a>
    {% endif %}

</div>
{% endblock %}
