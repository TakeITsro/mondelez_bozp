{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = ('Permit {n}'|t('bozp'))|replace({'{n}': permit.permitNumber}) %}
{% set selectedSubnavItem = 'queue' %}

{% block headHtml %}
<style>
.bozp-status{display:inline-block;padding:2px 10px;border-radius:12px;font-size:.8em;font-weight:600;line-height:1.6;white-space:nowrap;color:#fff}
.bozp-status--draft{background:#6b7280}.bozp-status--submitted{background:#d97706}
.bozp-status--approved{background:#16a34a}.bozp-status--rejected{background:#dc2626}
.bozp-status--signed{background:#2563eb}.bozp-status--active{background:#0891b2}
.bozp-status--pending_closure{background:#ea580c}.bozp-status--pending{background:#d97706}
.bozp-status--closed{background:#374151}.bozp-status--cancelled{background:#991b1b}
.bozp-status--expired{background:#9f1239}
</style>
{% endblock %}

{% set crumbs = [
    { label: 'BOZP Permity'|t('bozp'), url: cpUrl('permits') },
    { label: permit.permitNumber, url: cpUrl('permits/' ~ permit.id) }
] %}

{% set statusLabels = {
    'draft':           'Koncept'|t('bozp'),
    'submitted':       'Odoslané'|t('bozp'),
    'approved':        'Schválené'|t('bozp'),
    'rejected':        'Zamietnuté'|t('bozp'),
    'signed':          'Podpísané'|t('bozp'),
    'active':          'Aktívne'|t('bozp'),
    'pending_closure': 'Čaká na uzavretie'|t('bozp'),
    'closed':          'Uzavreté'|t('bozp'),
    'cancelled':       'Zrušené'|t('bozp'),
    'expired':         'Vypršané'|t('bozp'),
} %}

{% set controlLabels = {
    'used':     'Použité'|t('bozp'),
    'not_used': 'Nepoužité'|t('bozp'),
    'other':    'Iné'|t('bozp'),
} %}

{% macro yn(val) %}
    {%- if val is null -%}
        <span class="bozp-yn bozp-yn--unset">—</span>
    {%- elseif val -%}
        <span class="bozp-yn bozp-yn--yes">{{ 'Áno'|t('bozp') }}</span>
    {%- else -%}
        <span class="bozp-yn bozp-yn--no">{{ 'Nie'|t('bozp') }}</span>
    {%- endif -%}
{% endmacro %}

{% block content %}

    <div class="content-pane">

        <div class="flex flex-nowrap" style="justify-content:space-between;align-items:flex-start;">
            <div>
                <h2 style="margin:0;">{{ permit.permitNumber }}</h2>
                <div style="margin-top:4px;">
                    <span class="bozp-status bozp-status--{{ permit.status }}">
                        {{ statusLabels[permit.status] ?? permit.status }}
                    </span>
                </div>
            </div>

            <div>
                <a href="{{ url('permits/' ~ permit.id ~ '/pdf') }}"
                   target="_blank" rel="noopener"
                   class="btn small">⬇ {{ 'Zobraziť PDF'|t('bozp') }}</a>
                {% if permit.submittedAt %}
                    <div class="light">
                        {{ 'Odoslané'|t('bozp') }}: {{ permit.submittedAt|date('d.m.Y H:i') }}
                    </div>
                {% endif %}
                {% if permit.approvedAt %}
                    <div class="light">
                        {{ 'Schválené'|t('bozp') }}: {{ permit.approvedAt|date('d.m.Y H:i') }}
                    </div>
                {% endif %}
                {% if permit.rejectedAt %}
                    <div class="light">
                        {{ 'Zamietnuté'|t('bozp') }}: {{ permit.rejectedAt|date('d.m.Y H:i') }}
                    </div>
                {% endif %}
            </div>
        </div>

        <hr>

        <h3>{{ 'Vydavateľ a dodávateľ'|t('bozp') }}</h3>
        <table class="data fullwidth">
            <tbody>
                <tr>
                    <th style="width:220px;">{{ 'Vydavateľ'|t('bozp') }}</th>
                    <td>{{ issuer ? issuer.fullName ?: issuer.username : '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Dodávateľ'|t('bozp') }}</th>
                    <td>{{ permit.contractorCompany ?: '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Kontaktná osoba'|t('bozp') }}</th>
                    <td>{{ permit.contractorPersonName ?: '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'E-mail'|t('bozp') }}</th>
                    <td>
                        {%- if permit.contractorEmail -%}
                            <a href="mailto:{{ permit.contractorEmail }}">{{ permit.contractorEmail }}</a>
                        {%- else -%}—{%- endif -%}
                    </td>
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top:24px;">{{ 'Práca'|t('bozp') }}</h3>
        <table class="data fullwidth">
            <tbody>
                <tr>
                    <th style="width:220px;">{{ 'Miesto výkonu'|t('bozp') }}</th>
                    <td>{{ permit.workLocation ?: '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Popis prác'|t('bozp') }}</th>
                    <td>{{ permit.workOverview|nl2br ?: '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Platnosť od'|t('bozp') }}</th>
                    <td>{{ permit.validFrom ? permit.validFrom|date('d.m.Y') : '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Platnosť do'|t('bozp') }}</th>
                    <td>{{ permit.validTo ? permit.validTo|date('d.m.Y H:i') : '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Zóny'|t('bozp') }}</th>
                    <td>
                        {%- if zones|length > 0 -%}
                            {% for zone in zones %}
                                <span class="label">{{ zone.name }}{% if zone.code %} ({{ zone.code }}){% endif %}</span>
                            {% endfor %}
                        {%- else -%}—{%- endif -%}
                    </td>
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top:24px;">{{ 'Príprava pracoviska'|t('bozp') }}</h3>
        <table class="data fullwidth">
            <tbody>
                <tr>
                    <th style="width:320px;">{{ 'Sú pracovné podmienky vhodné na vykonávanie prác?'|t('bozp') }}</th>
                    <td>{{ _self.yn(permit.conditionsSuitable) }}</td>
                </tr>
                <tr>
                    <th>{{ 'Je náradie a vybavenie v dobrom technickom stave?'|t('bozp') }}</th>
                    <td>{{ _self.yn(permit.toolsInGoodCondition) }}</td>
                </tr>
                <tr>
                    <th>{{ 'Existujú podmienky, pri ktorých je nutné práce zastaviť?'|t('bozp') }}</th>
                    <td>{{ _self.yn(permit.hasStopConditions) }}</td>
                </tr>
                <tr>
                    <th>{{ 'Popis podmienok pre zastavenie prác'|t('bozp') }}</th>
                    <td>{{ permit.stopConditionsDescription ? permit.stopConditionsDescription|nl2br : '—' }}</td>
                </tr>
                <tr>
                    <th>{{ 'Je zavedený LOTO (uzamknutie / označenie)?'|t('bozp') }}</th>
                    <td>{{ _self.yn(permit.lotoImplemented) }}</td>
                </tr>
                <tr>
                    <th>{{ 'Núdzový plán / postup v prípade mimoriadnej udalosti'|t('bozp') }}</th>
                    <td>{{ permit.emergencyPlan ? permit.emergencyPlan|nl2br : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top:24px;">{{ 'Riziká a OOPP'|t('bozp') }}</h3>
        {% set hasHazards = hazards is defined and hazards|length > 0 %}
        {% if not hasHazards %}
            <p class="light">{{ 'Neboli uvedené žiadne riziká.'|t('bozp') }}</p>
        {% else %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Riziko'|t('bozp') }}</th>
                        <th style="width:100px;">{{ 'Exponovaný?'|t('bozp') }}</th>
                        <th>{{ 'Opatrenie / OOPP'|t('bozp') }}</th>
                        <th>{{ 'Kontrola počas činnosti'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cat in hazardCategories %}
                        {% set row = hazards[cat.value] ?? null %}
                        {% if row %}
                            <tr>
                                <th scope="row">{{ cat.label()|t('bozp') }}</th>
                                <td>{{ _self.yn(row.exposed) }}</td>
                                <td>{{ row.measure ? row.measure|nl2br : '—' }}</td>
                                <td>
                                    {%- if row.controlDuringActivity -%}
                                        {{ controlLabels[row.controlDuringActivity] ?? row.controlDuringActivity }}
                                        {%- if row.controlDuringActivityOther -%}
                                            <br><span class="light">{{ row.controlDuringActivityOther }}</span>
                                        {%- endif -%}
                                    {%- else -%}—{%- endif -%}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {# ---------- Subpermits ---------------------------------------- #}
        {% if requiredSubpermitTypes|length > 0 or subpermits|length > 0 %}
            {# Build label / appendix maps from enum cases #}
            {% set spLabelMap = {} %}
            {% set spAppendixMap = {} %}
            {% for t in subpermitTypes %}
                {% set spLabelMap = spLabelMap|merge({(t.value): t.label()}) %}
                {% set spAppendixMap = spAppendixMap|merge({(t.value): t.appendixNumber()}) %}
            {% endfor %}

            <h3 style="margin-top:24px;">{{ 'Subpermity zvýšeného rizika'|t('bozp') }}</h3>

            {% if subpermits|length == 0 %}
                <p class="light">{{ 'Zatiaľ neboli pridané žiadne subpermity.'|t('bozp') }}</p>
            {% else %}
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th style="width:80px;">{{ 'Príloha'|t('bozp') }}</th>
                            <th>{{ 'Typ'|t('bozp') }}</th>
                            <th>{{ 'Miesto'|t('bozp') }}</th>
                            <th>{{ 'Dátum'|t('bozp') }}</th>
                            <th style="width:120px;">{{ 'Stav'|t('bozp') }}</th>
                            <th>{{ 'Platnosť do'|t('bozp') }}</th>
                            <th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sp in subpermits %}
                            {% set spData = sp.data is string ? sp.data|json_decode : (sp.data ?? {}) %}
                            <tr>
                                <td>{{ spAppendixMap[sp.type] is defined ? 'č. ' ~ spAppendixMap[sp.type] : sp.type }}</td>
                                <td>{{ spLabelMap[sp.type] ?? sp.type }}</td>
                                <td>{{ spData.placeOfWork ?? '—' }}</td>
                                <td>{{ spData.date ? spData.date|date('d.m.Y') : sp.dateCreated|date('d.m.Y') }}</td>
                                <td>
                                    <span class="bozp-status bozp-status--{{ sp.status }}">{{ sp.status|t('bozp') }}</span>
                                    {% if sp.type in requiredSubpermitTypes and sp.status != 'approved' %}
                                        <span class="bozp-badge bozp-badge--required" title="{{ 'Vyžadovaný'|t('bozp') }}">!</span>
                                    {% endif %}
                                </td>
                                <td>{{ (sp.status == 'approved' and sp.expiresAt) ? sp.expiresAt|date('d.m.Y H:i') : '—' }}</td>
                                <td>
                                    <a href="{{ cpUrl('permits/' ~ permit.id ~ '/subpermit/' ~ sp.id) }}" class="btn small">
                                        {{ 'Detail'|t('bozp') }}
                                    </a>
                                </td>
                            </tr>
                            {% if sp.status == 'pending' and canApprove %}
                                <tr class="bozp-subpermit-actions-row">
                                    <td colspan="7" style="background:#f7f8f9;padding:12px 16px;">
                                        <div class="flex" style="gap:24px;align-items:flex-start;flex-wrap:wrap;">
                                            <form method="post" accept-charset="UTF-8" style="display:inline;">
                                                {{ csrfInput() }}
                                                <input type="hidden" name="action" value="bozp/queue/approve-subpermit">
                                                <input type="hidden" name="permitId" value="{{ permit.id }}">
                                                <input type="hidden" name="id" value="{{ sp.id }}">
                                                <button type="submit" class="btn submit">
                                                    {{ 'Schváliť subpermit'|t('bozp') }}
                                                </button>
                                                <span class="light" style="font-size:12px;margin-left:6px;">
                                                    {{ 'Platnosť 8 hodín od schválenia'|t('bozp') }}
                                                </span>
                                            </form>

                                            <form method="post" accept-charset="UTF-8"
                                                  style="display:flex;gap:8px;align-items:flex-start;">
                                                {{ csrfInput() }}
                                                <input type="hidden" name="action" value="bozp/queue/reject-subpermit">
                                                <input type="hidden" name="permitId" value="{{ permit.id }}">
                                                <input type="hidden" name="id" value="{{ sp.id }}">
                                                <input type="text" name="rejectionNote"
                                                       placeholder="{{ 'Dôvod zamietnutia (povinné)'|t('bozp') }}"
                                                       required style="width:280px;">
                                                <button type="submit" class="btn">
                                                    {{ 'Zamietnuť'|t('bozp') }}
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                            {% if sp.status == 'rejected' and sp.rejectionNote %}
                                <tr>
                                    <td colspan="7" class="light" style="padding-left:16px;font-style:italic;">
                                        {{ 'Dôvod zamietnutia'|t('bozp') }}: {{ sp.rejectionNote }}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {# Warning for missing required subpermits #}
            {% set missingLabels = [] %}
            {% for typeValue in requiredSubpermitTypes %}
                {% set hasApproved = false %}
                {% for sp in subpermits %}
                    {% if sp.type == typeValue and sp.status == 'approved' %}{% set hasApproved = true %}{% endif %}
                {% endfor %}
                {% if not hasApproved %}
                    {% set missingLabels = missingLabels|merge([spLabelMap[typeValue] ?? typeValue]) %}
                {% endif %}
            {% endfor %}
            {% if missingLabels|length > 0 %}
                <p class="warning" style="margin-top:8px;">
                    <strong>{{ 'Chýbajúce schválené subpermity'|t('bozp') }}:</strong>
                    {{ missingLabels|join(', ') }}
                </p>
            {% endif %}
        {% endif %}

        {% if permit.approvalComment %}
            <h3 style="margin-top:24px;">{{ 'Komentár HSE'|t('bozp') }}</h3>
            <p>{{ permit.approvalComment|nl2br }}</p>
            {% if approver %}
                <p class="light">— {{ approver.fullName ?: approver.username }}</p>
            {% endif %}
        {% endif %}

        {% if permit.status == 'awaiting_hse_closure' and canApprove %}
            <hr>
            <h3>{{ 'Finálne uzavretie HSE'|t('bozp') }}</h3>
            <p class="light">
                {{ 'Vydavateľ podpísal uzavretie. Pre dokončenie procesu pridajte svoj podpis.'|t('bozp') }}
            </p>

            {% set hseUser = currentUser %}
            {% set defaultHseName = hseUser ? (hseUser.fullName ?: hseUser.username) : '' %}

            <form method="post" action="" accept-charset="UTF-8" id="bozp-hse-close-form" style="max-width:540px;">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/queue/hse-close">
                <input type="hidden" name="id" value="{{ permit.id }}">
                <input type="hidden" name="signatureData" value="">

                {{ forms.textField({
                    label: 'Meno HSE officera'|t('bozp'),
                    name: 'signerName',
                    value: defaultHseName,
                    required: true,
                }) }}
                {# Plain HTML date input — Craft's forms.dateField submits
                   `name[date]` + `name[time]` as an array, which trips the
                   `(string) $request->getBodyParam('signatureDate')` cast
                   in QueueController::actionHseClose. #}
                <div class="field">
                    <div class="heading">
                        <label for="bozp-hse-signature-date">{{ 'Dátum'|t('bozp') }}</label>
                    </div>
                    <div class="input">
                        <input type="date"
                               id="bozp-hse-signature-date"
                               name="signatureDate"
                               value="{{ now|date('Y-m-d') }}"
                               required>
                    </div>
                </div>

                <div class="field">
                    <div class="heading"><label>{{ 'Podpis'|t('bozp') }}</label></div>
                    <div class="input">
                        <canvas id="bozp-hse-sigpad"
                                style="width:100%;max-width:520px;height:160px;border:1px solid #cdc8d6;border-radius:4px;background:#fff;display:block;"></canvas>
                        <div style="margin-top:6px;">
                            <button type="button" class="btn small" id="bozp-hse-sigpad-clear">
                                {{ 'Vymazať podpis'|t('bozp') }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="buttons" style="margin-top:16px;">
                    <button type="submit" class="btn submit" id="bozp-hse-close-submit">
                        {{ 'Podpísať a uzavrieť'|t('bozp') }}
                    </button>
                </div>
            </form>

            <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
            <script>
                (function () {
                    var canvas = document.getElementById('bozp-hse-sigpad');
                    var hidden = document.querySelector('#bozp-hse-close-form input[name="signatureData"]');
                    var clearBtn = document.getElementById('bozp-hse-sigpad-clear');
                    var form = document.getElementById('bozp-hse-close-form');
                    if (!canvas || !window.SignaturePad) return;

                    var pad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)', penColor: '#000' });
                    function resize() {
                        var ratio = Math.max(window.devicePixelRatio || 1, 1);
                        canvas.width = canvas.offsetWidth * ratio;
                        canvas.height = canvas.offsetHeight * ratio;
                        canvas.getContext('2d').scale(ratio, ratio);
                        pad.clear();
                    }
                    window.requestAnimationFrame(resize);
                    window.addEventListener('resize', resize);

                    if (clearBtn) clearBtn.addEventListener('click', function () { pad.clear(); });

                    form.addEventListener('submit', function (e) {
                        if (pad.isEmpty()) {
                            e.preventDefault();
                            alert({{ 'Pridajte svoj podpis.'|t('bozp')|json_encode|raw }});
                            return;
                        }
                        hidden.value = pad.toDataURL('image/png');
                    });
                })();
            </script>
        {% endif %}

        {% if permit.status == 'submitted' and canApprove %}
            <hr>
            <h3>{{ 'Rozhodnutie HSE'|t('bozp') }}</h3>

            <form method="post" action="" accept-charset="UTF-8" id="bozp-approve-form">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/queue/approve">
                <input type="hidden" name="id" value="{{ permit.id }}">

                {{ forms.textareaField({
                    label: 'Komentár (nepovinné)'|t('bozp'),
                    name: 'comment',
                    rows: 3,
                }) }}

                <div class="buttons">
                    <button type="submit" class="btn submit">{{ 'Schváliť'|t('bozp') }}</button>
                </div>
            </form>

            <form method="post" action="" accept-charset="UTF-8" id="bozp-reject-form" style="margin-top:24px;">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/queue/reject">
                <input type="hidden" name="id" value="{{ permit.id }}">

                {{ forms.textareaField({
                    label: 'Dôvod zamietnutia'|t('bozp'),
                    instructions: 'Povinné pri zamietnutí.'|t('bozp'),
                    name: 'comment',
                    rows: 3,
                    required: true,
                }) }}

                <div class="buttons">
                    <button type="submit" class="btn">{{ 'Zamietnuť'|t('bozp') }}</button>
                </div>
            </form>
        {% endif %}

        {# ---------- Attachments (read-only list) ---------------------- #}
        <h3 style="margin-top:32px;">{{ 'Prílohy'|t('bozp') }}</h3>
        {% if attachments is not defined or attachments|length == 0 %}
            <p class="light">{{ 'Žiadne prílohy.'|t('bozp') }}</p>
        {% else %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Súbor'|t('bozp') }}</th>
                        <th>{{ 'Typ'|t('bozp') }}</th>
                        <th>{{ 'Nahral'|t('bozp') }}</th>
                        <th>{{ 'Kedy'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for a in attachments %}
                        {% set asset = craft.assets().id(a.assetId).one() %}
                        <tr>
                            <td>
                                {% if asset %}
                                    <a href="{{ asset.url }}" target="_blank" rel="noopener">{{ asset.filename }}</a>
                                {% else %}
                                    <span class="light">{{ 'Súbor nie je dostupný'|t('bozp') }}</span>
                                {% endif %}
                            </td>
                            <td><code>{{ a.attachmentType }}</code></td>
                            <td>{{ a.uploadedByName ?: '—' }}</td>
                            <td>{{ a.dateCreated|date('d.m.Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {# ---------- Akcie -------------------------------------------- #}
        {% set canResend = canApprove and permit.status in ['approved','signed','active','rejected'] %}
        <h3 style="margin-top:32px;">{{ 'Akcie'|t('bozp') }}</h3>
        <div class="flex" style="gap:12px;flex-wrap:wrap;">

            {# Edit permit — always available to HSE #}
            <a href="{{ cpUrl('permits/' ~ permit.id ~ '/edit') }}" class="btn">
                {{ 'Upraviť permit'|t('bozp') }}
            </a>

            {% if canResend %}
                <form method="post"
                      action="{{ cpUrl('permits/' ~ permit.id ~ '/resend') }}"
                      accept-charset="UTF-8">
                    {{ csrfInput() }}
                    <button type="submit" class="btn">
                        {% if permit.status == 'rejected' %}
                            {{ 'Znova odoslať e-mail o zamietnutí'|t('bozp') }}
                        {% else %}
                            {{ 'Znova odoslať schválenie (nové heslo)'|t('bozp') }}
                        {% endif %}
                    </button>
                </form>
            {% endif %}
        </div>

        {# ---- Control visits ---- #}
        {% if controls is defined and controls|length > 0 %}
            {% set resultLabels = {
                'ok':      'V poriadku'|t('bozp'),
                'issues':  'Zistené nedostatky'|t('bozp'),
                'stopped': 'Práce zastavené'|t('bozp'),
            } %}
            {% set resultColors = {'ok': '#16a34a', 'issues': '#d97706', 'stopped': '#dc2626'} %}
            <h3 style="margin-top:32px;">{{ 'Kontroly prevádzky'|t('bozp') }}</h3>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Dátum a čas'|t('bozp') }}</th>
                        <th>{{ 'Kontrolór'|t('bozp') }}</th>
                        <th>{{ 'Výsledok'|t('bozp') }}</th>
                        <th>{{ 'Poznámky'|t('bozp') }}</th>
                        <th>{{ 'Podpis'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in controls %}
                        <tr>
                            <td>{{ c.controlledAt|date('d.m.Y H:i') }}</td>
                            <td>{{ c.controllerName }}</td>
                            <td>
                                <span style="display:inline-block;padding:2px 8px;border-radius:10px;background:{{ resultColors[c.result] ?? '#6b7280' }};color:#fff;font-size:.8em;font-weight:600;">
                                    {{ resultLabels[c.result] ?? c.result }}
                                </span>
                            </td>
                            <td>{{ c.notes ?: '—' }}</td>
                            <td>
                                {% if c.signatureAssetId %}
                                    {% set sigAsset = craft.assets().id(c.signatureAssetId).one() %}
                                    {% if sigAsset %}
                                        <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                             style="max-width:120px;max-height:48px;border:1px solid #eee;background:#fff;display:block;">
                                    {% else %}
                                        <span class="light">—</span>
                                    {% endif %}
                                {% else %}
                                    <span class="light">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <h3 style="margin-top:32px;">{{ 'Audit'|t('bozp') }}</h3>
        {% if auditEntries|length == 0 %}
            <p class="light">{{ 'Žiadne záznamy.'|t('bozp') }}</p>
        {% else %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Kedy'|t('bozp') }}</th>
                        <th>{{ 'Akcia'|t('bozp') }}</th>
                        <th>{{ 'Zmena stavu'|t('bozp') }}</th>
                        <th>{{ 'Poznámka'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in auditEntries %}
                        <tr>
                            <td>{{ entry.dateCreated|date('d.m.Y H:i:s') }}</td>
                            <td><code>{{ entry.action }}</code></td>
                            <td>
                                {%- if entry.fromStatus or entry.toStatus -%}
                                    {{ entry.fromStatus ?: '—' }} → {{ entry.toStatus ?: '—' }}
                                {%- else -%}—{%- endif -%}
                            </td>
                            <td>
                                {%- set p = entry.payload -%}
                                {%- if p is iterable and p.note is defined -%}
                                    {{ p.note }}
                                {%- else -%}—{%- endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
