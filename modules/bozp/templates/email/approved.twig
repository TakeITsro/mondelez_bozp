{% extends 'bozp/email/_layout.twig' %}

{# Approval notification for the issuer (employee).
   Variables: permit, permitUrl, subpermits #}

{% block subject %}{{ 'Permit {n} bol schválený'|t('bozp', {n: permit.permitNumber}) }}{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;font-size:13px;color:#4F2170;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
        {{ 'Schválenie HSE'|t('bozp') }}
    </p>
    <h2 style="margin:0 0 24px;font-size:20px;color:#000000;">
        {{ 'Permit bol schválený'|t('bozp') }}
    </h2>

    <p style="margin:0 0 16px;">{{ 'Dobrý deň,'|t('bozp') }}</p>

    <p style="margin:0 0 20px;">
        {{
            'Váš permit <strong>{n}</strong> bol schválený oddelením HSE a môžete pokračovať v prípravách.'|t('bozp', {
                n: permit.permitNumber
            })|raw
        }}
    </p>

    {# Permit details block #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#FEFFFD;border-left:4px solid #4F2170;border-radius:0 4px 4px 0;margin:0 0 24px;">
        <tr>
            <td style="padding:16px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="4">
                    <tr>
                        <td style="font-size:13px;color:#000000;width:140px;padding-bottom:6px;">{{ 'Číslo permitu'|t('bozp') }}</td>
                        <td style="font-size:13px;font-weight:700;padding-bottom:6px;">{{ permit.permitNumber }}</td>
                    </tr>
                    {% if permit.contractorCompany %}
                        <tr>
                            <td style="font-size:13px;color:#000000;padding-bottom:6px;">{{ 'Dodávateľ'|t('bozp') }}</td>
                            <td style="font-size:13px;padding-bottom:6px;">{{ permit.contractorCompany }}</td>
                        </tr>
                    {% endif %}
                    {% if permit.validTo %}
                        <tr>
                            <td style="font-size:13px;color:#000000;">{{ 'Platnosť do'|t('bozp') }}</td>
                            <td style="font-size:13px;font-weight:700;">{{ permit.validTo|date('d.m.Y H:i') }}</td>
                        </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    {# Subpermit list #}
    {% if subpermits is defined and subpermits|length > 0 %}
        <p style="margin:0 0 8px;font-size:13px;font-weight:700;color:#4F2170;">
            {{ 'Vyžadované subpermity (prílohy)'|t('bozp') }}
        </p>
        <ul style="margin:0 0 24px;padding-left:20px;">
            {% for sp in subpermits %}
                <li style="margin-bottom:4px;font-size:13px;">
                    {{ sp.typeLabel }}
                    <span style="display:inline-block;margin-left:6px;padding:1px 7px;border-radius:8px;
                                 font-size:11px;font-weight:700;
                                 background:#4F2170;
                                 color:#FEFFFD;">
                        {{ sp.status|t('bozp') }}
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
        <tr>
            <td style="background:#4F2170;border-radius:4px;">
                <a href="{{ permitUrl }}"
                   style="display:inline-block;padding:12px 28px;color:#FEFFFD;font-size:15px;font-weight:700;text-decoration:none;">
                    {{ 'Zobraziť permit'|t('bozp') }} →
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
