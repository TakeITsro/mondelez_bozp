{% extends 'bozp/email/_layout.twig' %}

{# Sent to the issuer (employee) when the contractor signs the permit.
   Variables: permit, permitUrl, signerName, action ('close'|'cancel') #}

{% block subject %}
    {% if action == 'cancel' %}
        {{ 'Dodávateľ zrušil permit {n}'|t('bozp', {n: permit.permitNumber}) }}
    {% else %}
        {{ 'Dodávateľ podpísal dokončenie permitu {n}'|t('bozp', {n: permit.permitNumber}) }}
    {% endif %}
{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;font-size:13px;color:#4F2170;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
        {% if action == 'cancel' %}
            {{ 'Zrušenie prác dodávateľom'|t('bozp') }}
        {% else %}
            {{ 'Dokončenie prác dodávateľom'|t('bozp') }}
        {% endif %}
    </p>
    <h2 style="margin:0 0 24px;font-size:20px;color:#000000;">
        {% if action == 'cancel' %}
            {{ 'Dodávateľ podpísal zrušenie'|t('bozp') }}
        {% else %}
            {{ 'Dodávateľ potvrdil dokončenie'|t('bozp') }}
        {% endif %}
    </h2>

    <p style="margin:0 0 16px;">{{ 'Dobrý deň,'|t('bozp') }}</p>

    {% if action == 'cancel' %}
        <p style="margin:0 0 20px;">
            {{
                'Dodávateľ <strong>{signer}</strong> podpísal zrušenie prác na permitu <strong>{n}</strong>. Permit bol uzamknutý ako zrušený.'|t('bozp', {
                    signer: signerName,
                    n: permit.permitNumber
                })|raw
            }}
        </p>
    {% else %}
        <p style="margin:0 0 20px;">
            {{
                'Dodávateľ <strong>{signer}</strong> potvrdil dokončenie prác na permitu <strong>{n}</strong>. Permit je teraz v stave čakania na vaše uzavretie.'|t('bozp', {
                    signer: signerName,
                    n: permit.permitNumber
                })|raw
            }}
        </p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
               style="background:#FEFFFD;border-left:4px solid #4F2170;border-radius:0 4px 4px 0;margin:0 0 24px;">
            <tr>
                <td style="padding:12px 18px;font-size:13px;font-weight:700;color:#000000;">
                    {{ 'Na uzavretie permitu je teraz potrebný váš podpis.'|t('bozp') }}
                </td>
            </tr>
        </table>
    {% endif %}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#FEFFFD;border-left:4px solid #4F2170;border-radius:0 4px 4px 0;margin:0 0 24px;">
        <tr>
            <td style="padding:14px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="4">
                    <tr>
                        <td style="font-size:13px;color:#000000;width:140px;padding-bottom:4px;">{{ 'Číslo permitu'|t('bozp') }}</td>
                        <td style="font-size:13px;font-weight:700;padding-bottom:4px;">{{ permit.permitNumber }}</td>
                    </tr>
                    {% if permit.contractorCompany %}
                        <tr>
                            <td style="font-size:13px;color:#000000;padding-bottom:4px;">{{ 'Dodávateľ'|t('bozp') }}</td>
                            <td style="font-size:13px;padding-bottom:4px;">{{ permit.contractorCompany }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td style="font-size:13px;color:#000000;">{{ 'Podpísal'|t('bozp') }}</td>
                        <td style="font-size:13px;">{{ signerName }}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
        <tr>
            <td style="background:#4F2170;border-radius:4px;">
                <a href="{{ permitUrl }}"
                   style="display:inline-block;padding:12px 28px;color:#FEFFFD;font-size:15px;font-weight:700;text-decoration:none;">
                    {{ 'Zobraziť permit'|t('bozp') }} →
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
