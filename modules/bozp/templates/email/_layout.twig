<!doctype html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block subject %}BOZP Permity{% endblock %}</title>
    <!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
</head>
<body style="margin:0;padding:0;background:#4F2170;font-family:Arial,Helvetica,sans-serif;color:#000000;">

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#4F2170;">
        <tr>
            <td align="center" style="padding:32px 16px;">

                {# ── Header ── #}
                <table role="presentation" width="600" cellpadding="0" cellspacing="0"
                       style="max-width:600px;width:100%;background:#4F2170;border-radius:6px 6px 0 0;">
                    <tr>
                        <td style="padding:28px 36px;">
                            <p style="margin:0;font-size:11px;letter-spacing:2px;text-transform:uppercase;
                                      color:#FEFFFD;font-weight:400;">
                                Mondelez SR Production
                            </p>
                            <h1 style="margin:6px 0 0;font-size:22px;font-weight:700;color:#FEFFFD;line-height:1.2;">
                                BOZP Permity
                            </h1>
                        </td>
                    </tr>
                </table>

                {# ── Body ── #}
                <table role="presentation" width="600" cellpadding="0" cellspacing="0"
                       style="max-width:600px;width:100%;background:#FEFFFD;">
                    <tr>
                        <td style="padding:32px 36px;color:#000000;font-size:15px;line-height:1.6;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                </table>

                {# ── Footer ── #}
                <table role="presentation" width="600" cellpadding="0" cellspacing="0"
                       style="max-width:600px;width:100%;background:#4F2170;border-radius:0 0 6px 6px;">
                    <tr>
                        <td style="padding:16px 36px;">
                            <p style="margin:0;font-size:11px;color:#FEFFFD;line-height:1.5;">
                                {{ 'Toto je automatická správa zo systému BOZP Permity. Neodpovedajte na tento e-mail.'|t('bozp') }}
                            </p>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>

</body>
</html>
