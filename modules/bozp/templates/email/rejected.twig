{% extends 'bozp/email/_layout.twig' %}

{# Rejection notification for issuer and contractor.
   Variables: permit, permitUrl, reason #}

{% block subject %}{{ 'Permit {n} bol zamietnutý'|t('bozp', {n: permit.permitNumber}) }}{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;font-size:13px;color:#4F2170;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
        {{ 'Zamietnutie HSE'|t('bozp') }}
    </p>
    <h2 style="margin:0 0 24px;font-size:20px;color:#000000;">
        {{ 'Permit bol zamietnutý'|t('bozp') }}
    </h2>

    <p style="margin:0 0 16px;">{{ 'Dobrý deň,'|t('bozp') }}</p>

    <p style="margin:0 0 20px;">
        {{
            'Permit <strong>{n}</strong> bol zamietnutý oddelením HSE.'|t('bozp', {
                n: permit.permitNumber
            })|raw
        }}
    </p>

    {# Permit details #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#FEFFFD;border-left:4px solid #4F2170;border-radius:0 4px 4px 0;margin:0 0 20px;">
        <tr>
            <td style="padding:14px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="4">
                    <tr>
                        <td style="font-size:13px;color:#000000;width:140px;padding-bottom:4px;">{{ 'Číslo permitu'|t('bozp') }}</td>
                        <td style="font-size:13px;font-weight:700;padding-bottom:4px;">{{ permit.permitNumber }}</td>
                    </tr>
                    {% if permit.contractorCompany %}
                        <tr>
                            <td style="font-size:13px;color:#000000;">{{ 'Dodávateľ'|t('bozp') }}</td>
                            <td style="font-size:13px;">{{ permit.contractorCompany }}</td>
                        </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    {% if reason %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
               style="background:#FEFFFD;border-left:4px solid #000000;border-radius:0 4px 4px 0;margin:0 0 24px;">
            <tr>
                <td style="padding:14px 20px;">
                    <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#000000;">
                        {{ 'Dôvod zamietnutia'|t('bozp') }}
                    </p>
                    <p style="margin:0;font-size:14px;line-height:1.5;">{{ reason|nl2br }}</p>
                </td>
            </tr>
        </table>
    {% endif %}

    <p style="margin:0 0 24px;font-size:14px;">
        {{ 'V prípade otázok kontaktujte oddelenie HSE.'|t('bozp') }}
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
        <tr>
            <td style="background:#4F2170;border-radius:4px;">
                <a href="{{ permitUrl }}"
                   style="display:inline-block;padding:12px 28px;color:#FEFFFD;font-size:15px;font-weight:700;text-decoration:none;">
                    {{ 'Zobraziť permit'|t('bozp') }} →
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
