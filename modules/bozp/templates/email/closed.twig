{% extends 'bozp/email/_layout.twig' %}

{# Sent to both the issuer (Mondelez employee) and the contractor when
   a permit is officially closed. The final signed PDF is attached.
   Variables: permit, permitUrl, signerName, recipient ('issuer'|'contractor') #}

{% block subject %}
    {{ 'Permit {n} bol uzavretý'|t('bozp', {n: permit.permitNumber}) }}
{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;font-size:13px;color:#4F2170;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
        {{ 'Uzavretie permitu'|t('bozp') }}
    </p>
    <h2 style="margin:0 0 24px;font-size:20px;color:#000000;">
        {{ 'Permit bol oficiálne uzavretý'|t('bozp') }}
    </h2>

    <p style="margin:0 0 16px;">{{ 'Dobrý deň,'|t('bozp') }}</p>

    <p style="margin:0 0 20px;">
        {{
            'Vydavateľ <strong>{signer}</strong> uzavrel permit <strong>{n}</strong>. Finálny podpísaný dokument nájdete v prílohe.'|t('bozp', {
                signer: signerName,
                n: permit.permitNumber
            })|raw
        }}
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#FEFFFD;border-left:4px solid #4F2170;border-radius:0 4px 4px 0;margin:0 0 24px;">
        <tr>
            <td style="padding:14px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="4">
                    <tr>
                        <td style="font-size:13px;color:#000000;width:140px;padding-bottom:4px;">{{ 'Číslo permitu'|t('bozp') }}</td>
                        <td style="font-size:13px;font-weight:700;padding-bottom:4px;">{{ permit.permitNumber }}</td>
                    </tr>
                    {% if permit.contractorCompany %}
                        <tr>
                            <td style="font-size:13px;color:#000000;padding-bottom:4px;">{{ 'Dodávateľ'|t('bozp') }}</td>
                            <td style="font-size:13px;padding-bottom:4px;">{{ permit.contractorCompany }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td style="font-size:13px;color:#000000;padding-bottom:4px;">{{ 'Uzavrel'|t('bozp') }}</td>
                        <td style="font-size:13px;padding-bottom:4px;">{{ signerName }}</td>
                    </tr>
                    <tr>
                        <td style="font-size:13px;color:#000000;">{{ 'Príloha'|t('bozp') }}</td>
                        <td style="font-size:13px;">{{ 'Podpísaný permit (PDF)'|t('bozp') }}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {% if recipient == 'contractor' %}
        <p style="margin:0 0 20px;font-size:13px;color:#000000;">
            {{ 'Ďakujeme za spoluprácu pri dodržiavaní bezpečnostných predpisov.'|t('bozp') }}
        </p>
    {% endif %}

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
        <tr>
            <td style="background:#4F2170;border-radius:4px;">
                <a href="{{ permitUrl }}"
                   style="display:inline-block;padding:12px 28px;color:#FEFFFD;font-size:15px;font-weight:700;text-decoration:none;">
                    {{ 'Zobraziť permit'|t('bozp') }} →
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
