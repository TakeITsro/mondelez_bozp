<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: DejaVu Sans, Arial, sans-serif;
    font-size: 9pt;
    color: #000000;
    line-height: 1.4;
}
h1 {
    font-size: 13pt;
    color: #4F2170;
    margin-bottom: 4pt;
}
h2 {
    width: 100%;
    font-size: 10pt;
    color: #F8EFFF;
    background-color: #4F2170;
    padding: 8pt 4pt;
    border: 1pt solid #4F2170;
}
h3 { font-size: 9pt; color: #4F2170; margin: 5pt 0 3pt; }

.doc-header {
    border: 2pt solid #4F2170;
    padding: 8pt;
    margin-bottom: 10pt;
}
.doc-header table { width: 100%; border-collapse: collapse; }
.permit-number { font-size: 13pt; font-weight: bold; color: #4F2170; }
.status-badge {
    display: inline-block;
    background: #4F2170;
    color: #FEFFFD;
    padding: 2pt 6pt;
    font-size: 8pt;
    font-weight: bold;
}

.section { margin-bottom: 8pt; }

.shorts-table {
    width: 100%;
    margin: 4pt 0 8pt 0;
}
.shorts-table td {
    font-size: 7.5pt;
    color: #000000;
    margin-top: 3pt;
}

.general-table {
    width: 100%;
    border-spacing: 0;
    margin: 0 0 8pt 0;
}
.general-table td {
    height: 100%;
}
.general-table td .cell-box {
    min-height: 47pt;
    display: flex;
    align-items: stretch;
}
.general-table td .cell-box .label {
    width: 50%;
    background-color: rgba(79, 33, 112, 0.5);
    border: 1px solid #000000;
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.general-table td .cell-box .value {
    width: 50%;
    border: 1px solid #000000;
    font-size: 10pt;
    color: #000000;
    padding: 8pt 4pt;
}
.general-table td .cell-box .value.column {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.general-table td .cell-box.wide .label {
    width: 30%;
}
.general-table td .cell-box.wide .value {
    width: 70%;
}

.heights-table {
    width: 100%;
    border-spacing: 0;
    margin: 0 0 8pt 0;
}
.heights-table td {
    height: 100%;
}
.heights-table td .cell-box {
    min-height: 47pt;
    display: flex;
    align-items: stretch;
}
.heights-table td .cell-box .label {
    width: 50%;
    background-color: rgba(79, 33, 112, 0.5);
    border: 1px solid #000000;
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.heights-table td .cell-box .value {
    width: 50%;
    border: 1px solid #000000;
    font-size: 10pt;
    color: #000000;
    padding: 8pt 4pt;
}
.heights-table td .cell-box .value.column {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.heights-table td .cell-box.wide .label {
    width: 30%;
}
.heights-table td .cell-box.wide .value {
    width: 70%;
}

.signature-table {
    width: 100%;
}
.signature-table td .signature-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.signature-table td .signature-box .label {
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.signature-table td .signature-box .image {
    width: 100%;
}
.signature-table td .signature-box .meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.doc-footer {
    margin-top: 10pt;
    padding-top: 4pt;
    border-top: 0.5pt solid #000000;
    font-size: 7pt;
    color: #000000;
}

.checklist-item { display: block; }
</style>
</head>
<body>

{% macro yn(val) -%}
    {%- if val is null or val == '' -%}<span class="yn-null">—</span>
    {%- elseif val == 'yes' or val == true -%}<span class="yn-yes">Áno</span>
    {%- elseif val == 'no' or val == false -%}<span class="yn-no">Nie</span>
    {%- else -%}<span class="yn-null">—</span>
    {%- endif -%}
{%- endmacro %}

{# ── Status map ──────────────────────────────────────────────────────────── #}
{% set statusLabels = {
    'pending':           'Čaká na schválenie',
    'pending_signatures':'Čaká na podpisy',
    'approved':          'Schválené',
    'rejected':          'Zamietnuté',
    'cancelled':         'Zrušené',
} %}

{# ── Header ──────────────────────────────────────────────────────────────── #}
<div class="doc-header">
    <table>
        <tr>
            <td style="width:30%;vertical-align:middle;">
                <strong style="font-size:11pt;color:#4F2170;">MONDELĒZ</strong><br>
                <span style="font-size:8pt;">Bezpečnosť a ochrana zdravia pri práci</span>
            </td>
            <td style="vertical-align:middle;text-align:center;">
                <div style="font-size:9pt;font-weight:bold;color:#000000;margin-bottom:3pt;">
                    {{ subpermitType ? subpermitType.label() : subpermit.type|upper }}
                    {% if subpermitType %}
                        — Príloha č. {{ subpermitType.appendixNumber() }}
                    {% endif %}
                </div>
                <div class="permit-number">Permit: {{ permit.permitNumber }}</div>
            </td>
            <td style="width:30%;vertical-align:middle;text-align:right;font-size:8pt;">
                <div class="status-badge">{{ statusLabels[subpermit.status] ?? subpermit.status }}</div><br><br>
                <div>Vygenerované: {{ generatedAt }}</div>
                <div>Vydané: {{ subpermit.dateCreated|date('d.m.Y') }}</div>
                {% if subpermit.approvedAt %}
                    <div>Schválené: {{ subpermit.approvedAt|date('d.m.Y H:i') }}</div>
                {% endif %}
                {% if subpermit.expiresAt and subpermit.status == 'approved' %}
                    <div>Platné do: {{ subpermit.expiresAt|date('d.m.Y H:i') }}</div>
                {% endif %}
                {% if contractorQrDataUri %}
                    <div style="margin-top:6pt;">
                        <img src="{{ contractorQrDataUri }}" alt="QR" style="width:80pt;height:80pt;">
                    </div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Common fields ───────────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Pojmy a skratky"|t }}</h2>
    <table class="shorts-table">
        <tr>
            <td>{{ "GPTW – Všeobecné povolenie na prácu"|t }}</td>
        </tr>
        <tr>
            <td>{{ "HRA – Vysokorizikové práce"|t }}</td>
        </tr>
        <tr>
            <td>{{ "HSE – Health, Safety & Environment"|t }}</td>
        </tr>
        <tr>
            <td>{{ "OOPP – Osobné ochranné pracovné prostriedky"|t }}</td>
        </tr>
        <tr>
            <td>{{ "WAH – Práce vo výškach"|t }}</td>
        </tr>

    </table>

    <h2>{{ "Základné informácie"|t }}</h2>
    <table class="general-table">
        <tr>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Dátum"|t }}</strong></span>
                    <span class="value">{{ values.date ? values.date|date('d.m.Y') : '—' }}</span>
                </div>
            </td>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Miesto výkonu práce<br>(budova, oblasť):"|t|raw }}</strong></span>
                    <span class="value">{{ values.placeOfWork ?: '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Zodpovedná osoba MDLZ"|t }}</strong></span>
                    <span class="value">{{ values.responsiblePerson ?: '—' }}</span>
                </div>
            </td>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Zúčastnení<br>dodávatelia/osoby"|t|raw }}</strong></span>
                    <span class="value">{{ values.participants ?: '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            {% if permit.contractorCompany %}
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Dodávateľ"|t }}</strong></span>
                    <span class="value">{{ permit.contractorCompany }}</span>
                </div>
            </td>
            {% endif %}

            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Práca, ktorá sa bude vykonávať"|t }}</strong></span>
                    <span class="value">{{ values.workDescription ? values.workDescription|nl2br : '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell" colspan="2">
                <div class="cell-box wide">
                    <span class="label"><strong>{{ "Kroky práce"|t }}</strong><br>{{ "Pridajte popis a dostatok podrobností – najlepšie detaily krok za krokom"|t|raw }}</span>
                    <span class="value column">
                        {% set hasSteps = false %}
                        {% for i in 1..5 %}{% if attribute(values, 'workStep' ~ i) ?? '' %}{% set hasSteps = true %}{% endif %}{% endfor %}
                        {% if hasSteps %}
                            {% for i in 1..5 %}
                                {% set step = attribute(values, 'workStep' ~ i) ?? '' %}
                                {% if step %}<span>{{ step }}</span>{% endif %}
                            {% endfor %}
                        {% endif %}
                    </span>
                </div>
            </td>
        </tr>
    </table>
</div>

{# ── Type-specific fields ────────────────────────────────────────────────── #}
{% if subpermitType %}

{# --- Hot Work --- #}
{% if subpermitType.value == 'hot_work' %}
{% set hwPerformerLabels = {
    'employee':   'Zamestnanec',
    'contractor': 'Dodávateľ',
} %}
{% set hwTristateLabels = {
    'ok':  '✓ OK',
    'nok': '✗ NOK',
    'na':  '— N/A',
} %}
{% set hwBase = [
    {key: 'sprinklersOperational',         label: 'Sprinklery, hydranty a hasiace prístroje na mieste a funkčné'},
    {key: 'workEquipmentInGoodCondition',  label: 'Pracovné vybavenie v dobrom stave'},
] %}
{% set hwZone = [
    {key: 'dustEquipmentShutDown',         label: 'Zariadenia produkujúce horľavý prach / vlákna vypnuté'},
    {key: 'conveyorsIsolated',             label: 'Dopravníky / vzduchotechnika / dúchadlá izolované alebo vypnuté'},
    {key: 'combustibleMaterialsRemoved',   label: 'Horľavé materiály odstránené (inak prikryté nehorľavými plachtami)'},
    {key: 'explosiveAtmosphereEliminated', label: 'Výbušná atmosféra eliminovaná'},
    {key: 'floorSweptClean',               label: 'Podlaha riadne pozametaná'},
    {key: 'combustibleFloorWetDown',       label: 'Horľavá podlaha navlhčená / prikrytá'},
    {key: 'openingsCovered',               label: 'Otvory v stenách a podlahe prekryté'},
    {key: 'tarpaulinsSuspended',           label: 'Nehorľavé plachty zavesené pod miestom práce'},
] %}
{% set hwWalls = [
    {key: 'constructionNonCombustible',    label: 'Konštrukcia nehorľavá, bez horľavého obkladu / izolácie'},
    {key: 'combustiblesOnOtherSideMoved',  label: 'Horľavé materiály na druhej strane stien odstránené'},
    {key: 'enclosedEquipmentCleaned',      label: 'Uzavreté zariadenie vyčistené od horľavín'},
    {key: 'containersPurged',              label: 'Nádoby zbavené horľavých kvapalín a výparov'},
] %}
{% set hwPatrol = [
    {key: 'bucketOfWater',                 label: 'Vedro vody'},
    {key: 'fireBrigadeHasExtinguishers',   label: 'Požiarna hliadka má vhodné hasiace prístroje / vodu'},
    {key: 'firePatrolTrained',             label: 'Požiarna hliadka vyškolená a oboznámená s požiarnym poriadkom'},
    {key: 'additionalSupervisionIncluded', label: 'Dodatočný dozor nad priľahlými priestormi (nad / pod)'},
] %}
{% set hwOther = [
    {key: 'confinedSpacePermitsOrLoto',      label: 'Povolenia pre uzavreté priestory (CSE) alebo LOTO vydané'},
    {key: 'smokeOrHeatDetectionDeactivated', label: 'Detekcia dymu / tepla deaktivovaná (ak prítomná)'},
] %}

{% macro tri(val, labels) -%}
    {{- labels[val] ?? '—' -}}
{%- endmacro %}

<div class="section">
    <h2>Horúce práce — Hlavička</h2>
    <table class="dl-table">
        <tr><td class="label">Povolenie vydal</td><td class="value">{{ values.permitIssuedByName ?: '—' }}</td></tr>
        <tr><td class="label">Vykonáva</td><td class="value">{{ hwPerformerLabels[values.hwPerformerType] ?? '—' }}</td></tr>
        <tr><td class="label">Číslo pracovného príkazu / zmeny</td><td class="value">{{ values.jobOrderNumber ?: '—' }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Časové údaje</h2>
    <table class="dl-table">
        <tr><td class="label">Čas začiatku prác</td><td class="value">{{ values.workStartTime ?: '—' }}</td></tr>
        <tr><td class="label">Čas ukončenia prác</td><td class="value">{{ values.workCompletionTime ?: '—' }}</td></tr>
        <tr><td class="label">Schválené</td><td class="value">{{ subpermit.approvedAt ? subpermit.approvedAt|date('d.m.Y H:i') : '—' }}</td></tr>
        <tr><td class="label">Platnosť do (auto, +8 h od schválenia)</td><td class="value">{{ subpermit.expiresAt ? subpermit.expiresAt|date('d.m.Y H:i') : '—' }}</td></tr>
    </table>
</div>

{% macro tristateTable(rows, values, hwTristateLabels) %}
    <table class="hazard-table">
        <thead>
            <tr>
                <th>Požiadavka</th>
                <th style="width:14%">Stav</th>
            </tr>
        </thead>
        <tbody>
            {% for item in rows %}
                {% set v = attribute(values, item.key) ?? '' %}
                <tr>
                    <td>{{ item.label }}</td>
                    <td>{{ hwTristateLabels[v] ?? '—' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

<div class="section">
    <h2>Kontrolný zoznam preventívnych opatrení</h2>
    {{ _self.tristateTable(hwBase, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>Požiadavky v 11-metrovej pracovnej zóne</h2>
    {{ _self.tristateTable(hwZone, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>Práce na stenách, stropoch alebo uzavretých zariadeniach</h2>
    {{ _self.tristateTable(hwWalls, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>Požiadavky na požiarnu hliadku / monitoring</h2>
    {{ _self.tristateTable(hwPatrol, values, hwTristateLabels) }}
    <table class="dl-table">
        <tr><td class="label">Počet a typ hasiacich prístrojov</td><td class="value">{{ values.extinguisherCountAndType ?: '—' }}</td></tr>
        <tr><td class="label">Hodín monitorovania po prácach (min. 2 h)</td><td class="value">{{ values.monitoringHoursAfter ?: '—' }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Ďalšie bezpečnostné a protipožiarne opatrenia</h2>
    {{ _self.tristateTable(hwOther, values, hwTristateLabels) }}
    {% if values.otherPrecautions %}
        <table class="dl-table">
            <tr><td class="label">Iné opatrenia</td><td class="value">{{ values.otherPrecautions|nl2br }}</td></tr>
        </table>
    {% endif %}
    <p style="margin-top:4pt;font-size:8pt;">
        Požiarna hliadka a požiarny technik vykonávajú kontrolu na papieri.
        Pred uzavretím subpermitu je vyžadovaná naskenovaná príloha ako dôkaz.
    </p>
</div>

{# --- Confined Space --- #}
{% elseif subpermitType.value == 'confined_space' %}
<div class="section">
    <h2>Vstup do uzavretého priestoru — Hlavička</h2>
    <table class="dl-table">
        <tr><td class="label">Oprávnená osoba</td><td class="value">{{ values.authorizedPersonName ?: '—' }}</td></tr>
        <tr><td class="label">Oddelenie</td><td class="value">{{ values.department ?: '—' }}</td></tr>
        <tr><td class="label">Schválené</td><td class="value">{{ subpermit.approvedAt ? subpermit.approvedAt|date('d.m.Y H:i') : '—' }}</td></tr>
        <tr><td class="label">Platnosť do (auto, +8 h od schválenia)</td><td class="value">{{ subpermit.expiresAt ? subpermit.expiresAt|date('d.m.Y H:i') : '—' }}</td></tr>
        {% if values.emergencyRescuePlan %}
            <tr><td class="label">Havarijný / záchranný plán</td><td class="value">{{ values.emergencyRescuePlan|nl2br }}</td></tr>
        {% endif %}
    </table>
</div>

<div class="section">
    <h2>Izolácia zdroja energie (LOTO)</h2>
    <table class="dl-table">
        <tr><td class="label">Čerpadlá / potrubia zaslepené, odpojené, zablokované</td><td class="value">{{ _self.yn(values.pumpsLinesBlinded) }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Ventilácia</h2>
    <table class="dl-table">
        <tr><td class="label">Úprava ventilácie potrebná</td><td class="value">{{ _self.yn(values.ventilationModificationRequired) }}</td></tr>
        {% if values.ventilationNotRequiredReason %}
            <tr><td class="label">Dôvod (ak nie)</td><td class="value">{{ values.ventilationNotRequiredReason }}</td></tr>
        {% endif %}
        <tr><td class="label">Nútené vetranie — začiatok</td><td class="value">{{ values.forcedVentilationStart ?: '—' }}</td></tr>
        <tr><td class="label">Nútené vetranie — koniec</td><td class="value">{{ values.forcedVentilationStop ?: '—' }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Iniciálne meranie atmosféry</h2>
    <table class="dl-table">
        <tr><td class="label">Čas merania</td><td class="value">{{ values.atmosphereTestTime ?: '—' }}</td></tr>
        <tr><td class="label">Kyslík (O₂) %</td><td class="value">{{ values.oxygenPercent ?: '—' }}</td></tr>
        <tr><td class="label">% LEL</td><td class="value">{{ values.lelPercent ?: '—' }}</td></tr>
        <tr><td class="label">CO alebo H₂S (PPM)</td><td class="value">{{ values.coOrH2sPpm ?: '—' }}</td></tr>
        {% if values.otherChemical %}
            <tr><td class="label">Iné</td><td class="value">{{ values.otherChemical }}</td></tr>
        {% endif %}
    </table>
    <p style="margin-top:4pt;font-size:8pt;">
        Periodické testy (každých 30 minút) zaznamenané na papieri.
        Pred uzavretím subpermitu je vyžadovaná naskenovaná príloha s evidenciou testov.
    </p>
</div>

<div class="section">
    <h2>Komunikácia a pohotovostný tím</h2>
    <table class="dl-table">
        <tr><td class="label">Vstupujúci s dozorujúcim</td><td class="value">{{ values.communicationEntrantSupervisor ?: '—' }}</td></tr>
        <tr><td class="label">Dozorujúci s pohotovostnými službami</td><td class="value">{{ values.communicationSupervisorEmergency ?: '—' }}</td></tr>
        {% if values.emergencyTeamMembers %}
            <tr><td class="label">Členovia pohotovostného tímu</td><td class="value">{{ values.emergencyTeamMembers|nl2br }}</td></tr>
        {% endif %}
    </table>
</div>

<div class="section">
    <h2>Časové údaje vstupu</h2>
    <table class="dl-table">
        <tr><td class="label">Čas prvého vstupu</td><td class="value">{{ values.timeOfFirstEnter ?: '—' }}</td></tr>
        <tr><td class="label">Čas posledného výstupu</td><td class="value">{{ values.timeOfLastExit ?: '—' }}</td></tr>
    </table>
</div>

{# --- Heights --- #}
{% elseif subpermitType.value == 'heights' %}
<div class="section">
    <h2>{{ "Práce vo výškach — špecifické informácie"|t }}</h2>

    {# Fall-risk identification table #}
    {% set fallRiskLabels = {
        'elevated_walkways':  'Vyvýšené prechodové/pracovné plochy 1,2 m alebo viac nad úrovňou podlahy.',
        'roof_work':          'Práca na strechách, na ktoré pracovníci vstupujú, kde môžu spadnúť cez strešné okno, otvor, práca na okraji hrany pádu.',
        'wall_openings':      'Stenové otvory (napríklad: okná alebo dvere, cez ktoré by pracovníci mohli spadnúť).',
        'pits_excavations':   'Výkopy a jamy, ktoré nie sú ľahko viditeľné a pracovníci by mohli do nich spadnúť.',
        'mobile_platforms':   'Mobilné pracovné plošiny.',
        'removed_handrails':  'Vyvýšené priestory, kde boli odstránené zábradlia.',
        'unprotected_edges':  'Strany/okraje prechodových/pracovných plôch (podlahy, medziposchodia, balkóny, chodníky) 1,2 m alebo viac nad úrovňou podlahy bez zábradlia.',
        'unprotected_ramps':  'Rampy, prechody a cesty, ktoré nie sú chránené zábradlím.',
        'floor_openings':     'Studne, podlahové otvory, jamy alebo šachty bez zábradlia/plotov/bariér/krytov.',
    } %}
    <table class="fall-risks-pdf" style="width:100%;border-collapse:collapse;margin:0 0 8pt 0;">
        <thead>
            <tr>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:left;">{{ "Nebezpečenstvo pádu"|t }}</th>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:center;width:18%;">{{ "Aplikované"|t }}</th>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:center;width:22%;">{{ "Kontrola na pracovisku"|t }}</th>
            </tr>
        </thead>
        <tbody>
            {% for key, label in fallRiskLabels %}
                {% set r = (values.fallRisks ?? {})[key] ?? {} %}
                <tr>
