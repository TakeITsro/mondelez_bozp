<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8">
<style>
    @font-face{font-family:'Calibri';src:url('/assets/font/calibri-regular.ttf') format('truetype');font-weight:400;font-style:normal;font-display:swap}
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: "Calibri", Arial, Helvetica, sans-serif;}
body {
    font-family: "Calibri", Arial, Helvetica, sans-serif;
    font-size: 9pt;
    color: #000000;
    line-height: 1.4;

}
h1 { font-size: 20px; line-height: 24px; color: #4F2170;}
h2 { font-size: 18px; color: #FEFFFD; margin: 0; background-color: #4F2170; padding: 10px }
h3 { font-size: 9pt; color: #4F2170; margin: 6pt 0 3pt; }

/* Header */
.doc-header {
    background-color: #FAF4FF;
    padding: 20px;
}
.doc-header table { width: 100%; border-collapse: collapse; border-spacing: 20px}
.doc-header .logo-cell { width: 120px; vertical-align: middle; }
.doc-header .logo-cell img {width: 120px;}
.doc-header .title-cell {
    width: 40%;
    vertical-align: middle;
    text-align: center;
    padding: 0 20px;
}
.doc-header .meta-cell {
    width: 200px;
    vertical-align: middle;
    text-align: right;
    font-size: 8pt;
}
.doc-header .meta-cell td {
    font-family: "Calibri", Arial, Helvetica, sans-serif;
    font-size: 12px;
    color: #4F2170;
    line-height: 1.4;
}


/* Sections */
.section { margin-bottom: 0 }
.dl-table { width: 100%; border-spacing: 0; border-collapse: collapse; border: 0; padding: 0;}
.dl-table td {width: 50%;}

.data-table {width: 100%; border-spacing: 0; border-collapse: collapse; border: 0; padding: 0;}
.data-table .label { width: 50%; height: 50px; font-size: 14px; font-weight: 700; background-color: #F1E0FF; padding: 5px 10px}
.data-table .value { width: 50%; height: 50px; font-size: 14px; background-color: #FAF4FF; padding: 5px 10px}
.data-table .label.tall {height: 100px;}
.data-table .value.tall {height: 100px;}

.hints-table {height: 200px; background-color: #4F2170; padding: 10px; border-spacing: 0; border-collapse: collapse; border: 0;}
.hints-table td:nth-child(1) {font-size: 12px; color: #FEFFFD; line-height: 1.2; vertical-align: top; padding: 2px 10px}
.hints-table td:nth-child(2) {font-size: 12px; color: #FEFFFD; line-height: 1.2; vertical-align: top; padding: 2px 10px}


/* Hazards / matrix tables */
.hazard-table {width: 100%; border-spacing: 2px;}
.hazard-table th {font-size: 14px; color: #4F2170; line-height: 1.2; vertical-align: middle; text-align: left; padding: 5px 10px}
.hazard-table th:nth-child(1) { background-color: #F1E0FF;}
.hazard-table th:nth-child(2) { background-color: #FAF4FF;}
.hazard-table th:nth-child(3) { background-color: #F1E0FF;}
.hazard-table th:nth-child(4) { background-color: #F1E0FF;}
.hazard-table th:nth-child(5) { background-color: #FFCD30;}
.hazard-table td {font-size: 12px; color: #4F2170; line-height: 1.2; vertical-align: middle; text-align: left; padding: 5px 10px}
.hazard-table td:nth-child(1) { background-color: #FAF4FF;}
.hazard-table td:nth-child(2) { background-color: #F1E0FF;}
.hazard-table td:nth-child(3) { background-color: #FAF4FF;}
.hazard-table td:nth-child(4) { background-color: #F1E0FF;}
.hazard-table td:nth-child(5) { background-color: #FFCD30;}

/* Signatures */
.signature-table {width: 100%; border-collapse: collapse;}
.signature-table td {width: 50%; vertical-align: top; padding: 10px;}
.signature-table td .sig-label {font-size: 14px; color: #4F2170; font-weight: 700; line-height: 1.2; margin-bottom: 6pt;}
.signature-table td .sig-meta {font-size: 12px; color: #4F2170; line-height: 1.3;}
.signature-table td .sig-line {border-bottom: 1pt solid #4F2170; height: 30pt;}
.signature-table td .sig-image {max-width: 100%; max-height: 70pt;}

/* Signers (multi-signer requests) */
.signer-table {width: 100%; border-spacing: 2px;}
.signer-table th {font-size: 12px; color: #4F2170; background-color: #F1E0FF; padding: 5px 10px; text-align: left;}
.signer-table td {font-size: 11px; color: #4F2170; background-color: #FAF4FF; padding: 5px 10px;}
.signer-table td img {max-width: 80pt; max-height: 30pt;}

/* Checklist row */
.checklist-item { display: block; font-size: 12px; color: #4F2170; }

/* Yes/No */
.yn-yes { font-weight: bold; }
.yn-no { }
.yn-null { color: #555; }

/* Footer */
.doc-footer {
    margin-top: 10pt;
    padding-top: 4pt;
    border-top: 0.5pt solid #000000;
    font-size: 7pt;
    color: #000000;
}
.pagebreak { page-break-before: always; }
</style>
</head>
<body>

{# ── Status labels ──────────────────────────────────────────────────────── #}
{% set statusLabels = {
    'pending':           'Čaká na schválenie',
    'pending_signatures':'Čaká na podpisy',
    'approved':          'Schválené',
    'rejected':          'Zamietnuté',
    'cancelled':         'Zrušené',
    'expired':           'Vypršané',
} %}

{# ── yn macros (Áno/Nie/—) ─────────────────────────────────────────────── #}
{% macro yn(val) -%}
    {%- if val is null or val == '' -%}<span class="yn-null">—</span>
    {%- elseif val == 'yes' or val == true -%}<span class="yn-yes">Áno</span>
    {%- elseif val == 'no' or val == false -%}<span class="yn-no">Nie</span>
    {%- else -%}<span class="yn-null">—</span>
    {%- endif -%}
{%- endmacro %}

{% macro tri(val, labels) -%}
    {{- labels[val] ?? '—' -}}
{%- endmacro %}

{# ── Reusable macro: subpermit document header ─────────────────────────── #}
{% macro docHeader(permit, subpermit, subpermitType, generatedAt, statusLabels) %}
    {% set appendixN = subpermitType ? subpermitType.appendixNumber() : '?' %}
    {% set typeLabel = subpermitType ? subpermitType.label() : subpermit.type|upper %}
    <div class="doc-header">
        <table>
            <tr>
                <td class="logo-cell">
                    <img src="{{ siteUrl('assets/svg/pdf_logo.svg') }}" alt="Logo" width="120">
                </td>
                <td class="title-cell">
                    <h1>
                        {{ "HSE - Povolenie na prácu"|t('bozp') }}<br>
                        {{ "Príloha č."|t('bozp') }} {{ appendixN }}<br>
                        {{ typeLabel }}
                    </h1>
                </td>
                <td class="meta-cell">
                    <table class="data-table">
                        <tr>
                            <td>{{ "Kód permitu"|t('bozp') }}:</td>
                            <td>{{ permit.permitNumber }}</td>
                        </tr>
                        <tr>
                            <td>{{ "Dátum vydania"|t('bozp') }}:</td>
                            <td>{{ generatedAt|date('d.m.Y') }}</td>
                        </tr>
                        {% if subpermit.approvedAt %}
                            <tr>
                                <td>{{ "Schválené"|t('bozp') }}:</td>
                                <td>{{ subpermit.approvedAt|date('d.m.Y H:i') }}</td>
                            </tr>
                        {% endif %}
                        {% if subpermit.expiresAt and subpermit.status == 'approved' %}
                            <tr>
                                <td>{{ "Platné do"|t('bozp') }}:</td>
                                <td>{{ subpermit.expiresAt|date('d.m.Y H:i') }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td>{{ "Stav"|t('bozp') }}:</td>
                            <td>{{ statusLabels[subpermit.status] ?? subpermit.status }}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
{% endmacro %}

{# ── Header ──────────────────────────────────────────────────────────────── #}
{{ _self.docHeader(permit, subpermit, subpermitType, generatedAt, statusLabels) }}

{# ── Pojmy a skratky ────────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Pojmy a skratky"|t('bozp') }}</h2>
    <table>
        <tr>
            <td style="height: 120px">
                <table class="hints-table" style="height: 120px">
                    <tr>
                        <td style="padding: 10px 10px 2px 10px">{{ "PTW – Povolenie na prácu"|t('bozp') }}</td>
                        <td style="padding: 10px 10px 2px 10px">{{ "GPTW – Všeobecné povolenie na prácu"|t('bozp') }}</td>
                    </tr>
                    <tr>
                        <td>{{ "CSE – Práce v stiesnených priestoroch"|t('bozp') }}</td>
                        <td>{{ "WAH – Práce vo výškach"|t('bozp') }}</td>
                    </tr>
                    <tr>
                        <td>{{ "HW – Činnosť so zvýšeným nebezpečenstvom vzniku požiaru"|t('bozp') }}</td>
                        <td>{{ "OC – Povolenie na výkopové práce"|t('bozp') }}</td>
                    </tr>
                    <tr>
                        <td>{{ "EXC – Povolenie na zdvíhacie práce a práce so žeriavom"|t('bozp') }}</td>
                        <td>{{ "HRA – Vysokorizikové práce"|t('bozp') }}</td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 10px 10px 10px">{{ "OOPP – Osobné ochranné pracovné prostriedky"|t('bozp') }}</td>
                        <td style="padding: 2px 10px 10px 10px">{{ "LOTO – Lock Out Tag Out"|t('bozp') }}</td>
                    </tr>
                </table>
            </td>
            <td style="width: 120px; height: 120px; padding: 10px">
                {% if contractorQrDataUri %}
                    <img src="{{ contractorQrDataUri }}" alt="QR" style="width: 100px; height: 100px;">
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Core details ────────────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Základné informácie"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label">{{ "Dátum:"|t('bozp') }}</td>
                        <td class="value">{{ values.date ? values.date|date('d.m.Y') : '—' }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label">{{ "Zodpovedná osoba MDLZ:"|t('bozp') }}</td>
                        <td class="value">{{ values.responsiblePerson ?: (issuer ? (issuer.fullName ?: issuer.username) : '—') }}</td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label">{{ "Miesto výkonu práce:"|t('bozp') }}</td>
                        <td class="value">{{ values.placeOfWork ?: '—' }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label">{{ "Zúčastnení dodávatelia/osoby:"|t('bozp') }}</td>
                        <td class="value">
                            {{ values.participants ?: '—' }}
                            {% if permit.contractorCompany %}<br>{{ permit.contractorCompany }}{% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Práca, ktorá sa bude vykonávať:"|t('bozp') }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="value tall">{{ values.workDescription ? values.workDescription|nl2br : '—' }}</td>
                    </tr>
                </table>
            </td>
        </tr>
        {% set hasSteps = false %}
        {% for i in 1..5 %}{% if attribute(values, 'workStep' ~ i) ?? '' %}{% set hasSteps = true %}{% endif %}{% endfor %}
        {% if hasSteps %}
        <tr>
            <td colspan="2">
                <table class="data-table">
                    <tr>
                        <td class="label tall" style="width:30%;">
                            {{ "Kroky práce"|t('bozp') }}<br>
                            <span style="font-weight:400;font-size:11px;">{{ "Pridajte popis a dostatok podrobností – najlepšie detaily krok za krokom"|t('bozp') }}</span>
                        </td>
                        <td class="value tall" style="width:70%;">
                            {% for i in 1..5 %}
                                {% set step = attribute(values, 'workStep' ~ i) ?? '' %}
                                {% if step %}<div>{{ loop.index }}. {{ step }}</div>{% endif %}
                            {% endfor %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        {% endif %}
    </table>
</div>
<br>

{# ── Type-specific fields ────────────────────────────────────────────────── #}
{% if subpermitType %}

{# ============================================================
   HOT WORK
   ============================================================ #}
{% if subpermitType.value == 'hot_work' %}
{% set hwPerformerLabels = {
    'employee':   'Zamestnanec',
    'contractor': 'Dodávateľ',
} %}
{% set hwTristateLabels = {
    'ok':  '✓ OK',
    'nok': '✗ NOK',
    'na':  '— N/A',
} %}
{% set hwBase = [
    {key: 'sprinklersOperational',         label: 'Sprinklery, hydranty a hasiace prístroje na mieste a funkčné'},
    {key: 'workEquipmentInGoodCondition',  label: 'Pracovné vybavenie v dobrom stave'},
] %}
{% set hwZone = [
    {key: 'dustEquipmentShutDown',         label: 'Zariadenia produkujúce horľavý prach / vlákna vypnuté'},
    {key: 'conveyorsIsolated',             label: 'Dopravníky / vzduchotechnika / dúchadlá izolované alebo vypnuté'},
    {key: 'combustibleMaterialsRemoved',   label: 'Horľavé materiály odstránené (inak prikryté nehorľavými plachtami)'},
    {key: 'explosiveAtmosphereEliminated', label: 'Výbušná atmosféra eliminovaná'},
    {key: 'floorSweptClean',               label: 'Podlaha riadne pozametaná'},
    {key: 'combustibleFloorWetDown',       label: 'Horľavá podlaha navlhčená / prikrytá'},
    {key: 'openingsCovered',               label: 'Otvory v stenách a podlahe prekryté'},
    {key: 'tarpaulinsSuspended',           label: 'Nehorľavé plachty zavesené pod miestom práce'},
] %}
{% set hwWalls = [
    {key: 'constructionNonCombustible',    label: 'Konštrukcia nehorľavá, bez horľavého obkladu / izolácie'},
    {key: 'combustiblesOnOtherSideMoved',  label: 'Horľavé materiály na druhej strane stien odstránené'},
    {key: 'enclosedEquipmentCleaned',      label: 'Uzavreté zariadenie vyčistené od horľavín'},
    {key: 'containersPurged',              label: 'Nádoby zbavené horľavých kvapalín a výparov'},
] %}
{% set hwPatrol = [
    {key: 'bucketOfWater',                 label: 'Vedro vody'},
    {key: 'fireBrigadeHasExtinguishers',   label: 'Požiarna hliadka má vhodné hasiace prístroje / vodu'},
    {key: 'firePatrolTrained',             label: 'Požiarna hliadka vyškolená a oboznámená s požiarnym poriadkom'},
    {key: 'additionalSupervisionIncluded', label: 'Dodatočný dozor nad priľahlými priestormi (nad / pod)'},
] %}
{% set hwOther = [
    {key: 'confinedSpacePermitsOrLoto',      label: 'Povolenia pre uzavreté priestory (CSE) alebo LOTO vydané'},
    {key: 'smokeOrHeatDetectionDeactivated', label: 'Detekcia dymu / tepla deaktivovaná (ak prítomná)'},
] %}

<div class="section">
    <h2>{{ "Horúce práce — Hlavička"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Povolenie vydal"|t('bozp') }}</td>
                <td class="value">{{ values.permitIssuedByName ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Vykonáva"|t('bozp') }}</td>
                <td class="value">{{ hwPerformerLabels[values.hwPerformerType] ?? '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Číslo pracovného príkazu / zmeny"|t('bozp') }}</td>
                <td class="value">{{ values.jobOrderNumber ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Časové údaje"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Čas začiatku prác"|t('bozp') }}</td>
                <td class="value">{{ values.workStartTime ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Čas ukončenia prác"|t('bozp') }}</td>
                <td class="value">{{ values.workCompletionTime ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

{% macro tristateMatrix(rows, values, hwTristateLabels) %}
    <table class="hazard-table">
        <thead>
            <tr>
                <th>{{ "Požiadavka"|t('bozp') }}</th>
                <th style="width:18%">{{ "Stav"|t('bozp') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in rows %}
                {% set v = attribute(values, item.key) ?? '' %}
                <tr>
                    <td>{{ item.label|t('bozp') }}</td>
                    <td>{{ hwTristateLabels[v] ?? '—' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

<div class="section">
    <h2>{{ "Kontrolný zoznam preventívnych opatrení"|t('bozp') }}</h2>
    {{ _self.tristateMatrix(hwBase, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>{{ "Požiadavky v 11-metrovej pracovnej zóne"|t('bozp') }}</h2>
    {{ _self.tristateMatrix(hwZone, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>{{ "Práce na stenách, stropoch alebo uzavretých zariadeniach"|t('bozp') }}</h2>
    {{ _self.tristateMatrix(hwWalls, values, hwTristateLabels) }}
</div>

<div class="section">
    <h2>{{ "Požiadavky na požiarnu hliadku / monitoring"|t('bozp') }}</h2>
    {{ _self.tristateMatrix(hwPatrol, values, hwTristateLabels) }}
    <br>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Počet a typ hasiacich prístrojov"|t('bozp') }}</td>
                <td class="value">{{ values.extinguisherCountAndType ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Hodín monitorovania po prácach (min. 2 h)"|t('bozp') }}</td>
                <td class="value">{{ values.monitoringHoursAfter ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Ďalšie bezpečnostné a protipožiarne opatrenia"|t('bozp') }}</h2>
    {{ _self.tristateMatrix(hwOther, values, hwTristateLabels) }}
    {% if values.otherPrecautions %}
        <br>
        <table class="data-table">
            <tr>
                <td class="label tall">{{ "Iné opatrenia"|t('bozp') }}</td>
                <td class="value tall">{{ values.otherPrecautions|nl2br }}</td>
            </tr>
        </table>
    {% endif %}
    <p style="margin-top:4pt;font-size:8pt;color:#4F2170;">
        {{ "Požiarna hliadka a požiarny technik vykonávajú kontrolu na papieri. Pred uzavretím subpermitu je vyžadovaná naskenovaná príloha ako dôkaz."|t('bozp') }}
    </p>
</div>

{# ============================================================
   CONFINED SPACE
   ============================================================ #}
{% elseif subpermitType.value == 'confined_space' %}
<div class="section">
    <h2>{{ "Vstup do uzavretého priestoru — Hlavička"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Oprávnená osoba"|t('bozp') }}</td>
                <td class="value">{{ values.authorizedPersonName ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Oddelenie"|t('bozp') }}</td>
                <td class="value">{{ values.department ?: '—' }}</td>
            </tr></table></td>
        </tr>
        {% if values.emergencyRescuePlan %}
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Havarijný / záchranný plán"|t('bozp') }}</td>
                <td class="value tall">{{ values.emergencyRescuePlan|nl2br }}</td>
            </tr></table></td>
        </tr>
        {% endif %}
    </table>
</div>

<div class="section">
    <h2>{{ "Izolácia zdroja energie (LOTO)"|t('bozp') }}</h2>
    <table class="data-table">
        <tr>
            <td class="label">{{ "Čerpadlá / potrubia zaslepené, odpojené, zablokované"|t('bozp') }}</td>
            <td class="value">{{ _self.yn(values.pumpsLinesBlinded) }}</td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Ventilácia"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Úprava ventilácie potrebná"|t('bozp') }}</td>
                <td class="value">{{ _self.yn(values.ventilationModificationRequired) }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Dôvod (ak nie)"|t('bozp') }}</td>
                <td class="value">{{ values.ventilationNotRequiredReason ?: '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Nútené vetranie — začiatok"|t('bozp') }}</td>
                <td class="value">{{ values.forcedVentilationStart ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Nútené vetranie — koniec"|t('bozp') }}</td>
                <td class="value">{{ values.forcedVentilationStop ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Iniciálne meranie atmosféry"|t('bozp') }}</h2>
