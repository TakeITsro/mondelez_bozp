<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: DejaVu Sans, Arial, sans-serif;
    font-size: 9pt;
    color: #000000;
    line-height: 1.4;
}
h1 {
    font-size: 13pt;
    color: #4F2170;
    margin-bottom: 4pt;
}
h2 {
    width: 100%;
    font-size: 10pt;
    color: #F8EFFF;
    background-color: #4F2170;
    padding: 8pt 4pt;
    border: 1pt solid #4F2170;
}
h3 { font-size: 9pt; color: #4F2170; margin: 5pt 0 3pt; }

.doc-header {
    border: 2pt solid #4F2170;
    padding: 8pt;
    margin-bottom: 10pt;
}
.doc-header table { width: 100%; border-collapse: collapse; }
.permit-number { font-size: 13pt; font-weight: bold; color: #4F2170; }
.status-badge {
    display: inline-block;
    background: #4F2170;
    color: #FEFFFD;
    padding: 2pt 6pt;
    font-size: 8pt;
    font-weight: bold;
}

.section { margin-bottom: 8pt; }

.shorts-table {
    width: 100%;
    margin: 4pt 0 8pt 0;
}
.shorts-table td {
    font-size: 7.5pt;
    color: #000000;
    margin-top: 3pt;
}

.general-table {
    width: 100%;
    border-spacing: 0;
    margin: 0 0 8pt 0;
}
.general-table td {
    height: 100%;
}
.general-table td .cell-box {
    min-height: 47pt;
    display: flex;
    align-items: stretch;
}
.general-table td .cell-box .label {
    width: 50%;
    background-color: rgba(79, 33, 112, 0.5);
    border: 1px solid #000000;
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.general-table td .cell-box .value {
    width: 50%;
    border: 1px solid #000000;
    font-size: 10pt;
    color: #000000;
    padding: 8pt 4pt;
}
.general-table td .cell-box .value.column {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.general-table td .cell-box.wide .label {
    width: 30%;
}
.general-table td .cell-box.wide .value {
    width: 70%;
}

.heights-table {
    width: 100%;
    border-spacing: 0;
    margin: 0 0 8pt 0;
}
.heights-table td {
    height: 100%;
}
.heights-table td .cell-box {
    min-height: 47pt;
    display: flex;
    align-items: stretch;
}
.heights-table td .cell-box .label {
    width: 50%;
    background-color: rgba(79, 33, 112, 0.5);
    border: 1px solid #000000;
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.heights-table td .cell-box .value {
    width: 50%;
    border: 1px solid #000000;
    font-size: 10pt;
    color: #000000;
    padding: 8pt 4pt;
}
.heights-table td .cell-box .value.column {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.heights-table td .cell-box.wide .label {
    width: 30%;
}
.heights-table td .cell-box.wide .value {
    width: 70%;
}

.signature-table {
    width: 100%;
}
.signature-table td .signature-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.signature-table td .signature-box .label {
    font-size: 10pt;
    font-weight: bold;
    color: #000000;
    padding: 8pt 4pt;
}
.signature-table td .signature-box .image {
    width: 100%;
}
.signature-table td .signature-box .meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.doc-footer {
    margin-top: 10pt;
    padding-top: 4pt;
    border-top: 0.5pt solid #000000;
    font-size: 7pt;
    color: #000000;
}

.checklist-item { display: block; }
</style>
</head>
<body>

{% macro yn(val) -%}
    {%- if val is null or val == '' -%}<span class="yn-null">—</span>
    {%- elseif val == 'yes' or val == true -%}<span class="yn-yes">Áno</span>
    {%- elseif val == 'no' or val == false -%}<span class="yn-no">Nie</span>
    {%- else -%}<span class="yn-null">—</span>
    {%- endif -%}
{%- endmacro %}

{# ── Status map ──────────────────────────────────────────────────────────── #}
{% set statusLabels = {
    'pending':           'Čaká na schválenie',
    'pending_signatures':'Čaká na podpisy',
    'approved':          'Schválené',
    'rejected':          'Zamietnuté',
    'cancelled':         'Zrušené',
} %}

{# ── Header ──────────────────────────────────────────────────────────────── #}
<div class="doc-header">
    <table>
        <tr>
            <td style="width:30%;vertical-align:middle;">
                <strong style="font-size:11pt;color:#4F2170;">MONDELĒZ</strong><br>
                <span style="font-size:8pt;">Bezpečnosť a ochrana zdravia pri práci</span>
            </td>
            <td style="vertical-align:middle;text-align:center;">
                <div style="font-size:9pt;font-weight:bold;color:#000000;margin-bottom:3pt;">
                    {{ subpermitType ? subpermitType.label() : subpermit.type|upper }}
                    {% if subpermitType %}
                        — Príloha č. {{ subpermitType.appendixNumber() }}
                    {% endif %}
                </div>
                <div class="permit-number">Permit: {{ permit.permitNumber }}</div>
            </td>
            <td style="width:30%;vertical-align:middle;text-align:right;font-size:8pt;">
                <div class="status-badge">{{ statusLabels[subpermit.status] ?? subpermit.status }}</div><br><br>
                <div>Vygenerované: {{ generatedAt }}</div>
                <div>Vydané: {{ subpermit.dateCreated|date('d.m.Y') }}</div>
                {% if subpermit.approvedAt %}
                    <div>Schválené: {{ subpermit.approvedAt|date('d.m.Y H:i') }}</div>
                {% endif %}
                {% if subpermit.expiresAt and subpermit.status == 'approved' %}
                    <div>Platné do: {{ subpermit.expiresAt|date('d.m.Y H:i') }}</div>
                {% endif %}
                {% if contractorQrDataUri %}
                    <div style="margin-top:6pt;">
                        <img src="{{ contractorQrDataUri }}" alt="QR" style="width:80pt;height:80pt;">
                    </div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Common fields ───────────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Pojmy a skratky"|t }}</h2>
    <table class="shorts-table">
        <tr>
            <td>{{ "GPTW – Všeobecné povolenie na prácu"|t }}</td>
        </tr>
        <tr>
            <td>{{ "HRA – Vysokorizikové práce"|t }}</td>
        </tr>
        <tr>
            <td>{{ "HSE – Health, Safety & Environment"|t }}</td>
        </tr>
        <tr>
            <td>{{ "OOPP – Osobné ochranné pracovné prostriedky"|t }}</td>
        </tr>
        <tr>
            <td>{{ "WAH – Práce vo výškach"|t }}</td>
        </tr>

    </table>

    <h2>{{ "Základné informácie"|t }}</h2>
    <table class="general-table">
        <tr>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Dátum"|t }}</strong></span>
                    <span class="value">{{ values.date ? values.date|date('d.m.Y') : '—' }}</span>
                </div>
            </td>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Miesto výkonu práce<br>(budova, oblasť):"|t|raw }}</strong></span>
                    <span class="value">{{ values.placeOfWork ?: '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Zodpovedná osoba MDLZ"|t }}</strong></span>
                    <span class="value">{{ values.responsiblePerson ?: '—' }}</span>
                </div>
            </td>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Zúčastnení<br>dodávatelia/osoby"|t|raw }}</strong></span>
                    <span class="value">{{ values.participants ?: '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            {% if permit.contractorCompany %}
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Dodávateľ"|t }}</strong></span>
                    <span class="value">{{ permit.contractorCompany }}</span>
                </div>
            </td>
            {% endif %}

            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Práca, ktorá sa bude vykonávať"|t }}</strong></span>
                    <span class="value">{{ values.workDescription ? values.workDescription|nl2br : '—' }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell" colspan="2">
                <div class="cell-box wide">
                    <span class="label"><strong>{{ "Kroky práce"|t }}</strong><br>{{ "Pridajte popis a dostatok podrobností – najlepšie detaily krok za krokom"|t|raw }}</span>
                    <span class="value column">
                        {% set hasSteps = false %}
                        {% for i in 1..5 %}{% if attribute(values, 'workStep' ~ i) ?? '' %}{% set hasSteps = true %}{% endif %}{% endfor %}
                        {% if hasSteps %}
                            {% for i in 1..5 %}
                                {% set step = attribute(values, 'workStep' ~ i) ?? '' %}
                                {% if step %}<span>{{ step }}</span>{% endif %}
                            {% endfor %}
                        {% endif %}
                    </span>
                </div>
            </td>
        </tr>
    </table>
</div>

{# ── Type-specific fields ────────────────────────────────────────────────── #}
{% if subpermitType %}

{# --- Hot Work --- #}
{% if subpermitType.value == 'hot_work' %}
<div class="section">
    <h2>Horúce práce — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Číslo pracovného príkazu</td><td class="value">{{ values.jobOrderNumber ?: '—' }}</td></tr>
        <tr><td class="label">Čas začiatku</td><td class="value">{{ values.workStartTime ?: '—' }}</td></tr>
        <tr><td class="label">Čas ukončenia</td><td class="value">{{ values.workExpiryTime ?: '—' }}</td></tr>
        <tr><td class="label">Požiarna hliadka</td><td class="value">{{ values.firePatrolName ?: '—' }}</td></tr>
        <tr><td class="label">Monitorovanie (hod. po práci)</td><td class="value">{{ values.monitoringHours ?: '—' }}</td></tr>
        {% if values.additionalMeasures %}<tr><td class="label">Dodatočné opatrenia</td><td class="value">{{ values.additionalMeasures|nl2br }}</td></tr>{% endif %}
        {% if values.checklist is defined and values.checklist|length > 0 %}
        <tr>
            <td class="label">Kontrolný zoznam</td>
            <td class="value">{% for item in values.checklist %}<span class="checklist-item">✓ {{ item }}</span>{% endfor %}</td>
        </tr>
        {% endif %}
    </table>
</div>

{# --- Confined Space --- #}
{% elseif subpermitType.value == 'confined_space' %}
<div class="section">
    <h2>Vstup do uzatvorených priestorov — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Platnosť do (dátum)</td><td class="value">{{ values.expiryDate ?: '—' }}</td></tr>
        <tr><td class="label">Platnosť do (čas)</td><td class="value">{{ values.expiryTime ?: '—' }}</td></tr>
        <tr><td class="label">Školenie absolvované</td><td class="value">{{ _self.yn(values.trainingComplete) }}</td></tr>
        <tr><td class="label">LOTO aplikované</td><td class="value">{{ _self.yn(values.lotoApplied) }}</td></tr>
        <tr><td class="label">Čerpadlá zaslepené</td><td class="value">{{ _self.yn(values.pumpsBlinded) }}</td></tr>
        <tr><td class="label">Ventilácia potrebná</td><td class="value">{{ _self.yn(values.ventilationRequired) }}</td></tr>
        {% if values.ventilationRequired == 'yes' %}
        <tr><td class="label">Ventilácia od</td><td class="value">{{ values.ventilationStartTime ?: '—' }}</td></tr>
        <tr><td class="label">Ventilácia do</td><td class="value">{{ values.ventilationStopTime ?: '—' }}</td></tr>
        {% endif %}
        <tr><td class="label">O₂ (%)</td><td class="value">{{ values.o2Percent ?: '—' }}</td></tr>
        <tr><td class="label">LEL (%)</td><td class="value">{{ values.lelPercent ?: '—' }}</td></tr>
        <tr><td class="label">CO (ppm)</td><td class="value">{{ values.coPpm ?: '—' }}</td></tr>
        <tr><td class="label">H₂S (ppm)</td><td class="value">{{ values.h2sPpm ?: '—' }}</td></tr>
        <tr><td class="label">Komunikácia potvrdená</td><td class="value">{{ _self.yn(values.communicationConfirmed) }}</td></tr>
        {% if values.emergencyPlan %}<tr><td class="label">Havarijný plán</td><td class="value">{{ values.emergencyPlan|nl2br }}</td></tr>{% endif %}
    </table>
</div>

{# --- Heights --- #}
{% elseif subpermitType.value == 'heights' %}
<div class="section">
    <h2>{{ "Práce vo výškach — špecifické informácie"|t }}</h2>

    {# Fall-risk identification table #}
    {% set fallRiskLabels = {
        'elevated_walkways':  'Vyvýšené prechodové/pracovné plochy 1,2 m alebo viac nad úrovňou podlahy.',
        'roof_work':          'Práca na strechách, na ktoré pracovníci vstupujú, kde môžu spadnúť cez strešné okno, otvor, práca na okraji hrany pádu.',
        'wall_openings':      'Stenové otvory (napríklad: okná alebo dvere, cez ktoré by pracovníci mohli spadnúť).',
        'pits_excavations':   'Výkopy a jamy, ktoré nie sú ľahko viditeľné a pracovníci by mohli do nich spadnúť.',
        'mobile_platforms':   'Mobilné pracovné plošiny.',
        'removed_handrails':  'Vyvýšené priestory, kde boli odstránené zábradlia.',
        'unprotected_edges':  'Strany/okraje prechodových/pracovných plôch (podlahy, medziposchodia, balkóny, chodníky) 1,2 m alebo viac nad úrovňou podlahy bez zábradlia.',
        'unprotected_ramps':  'Rampy, prechody a cesty, ktoré nie sú chránené zábradlím.',
        'floor_openings':     'Studne, podlahové otvory, jamy alebo šachty bez zábradlia/plotov/bariér/krytov.',
    } %}
    <table class="fall-risks-pdf" style="width:100%;border-collapse:collapse;margin:0 0 8pt 0;">
        <thead>
            <tr>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:left;">{{ "Nebezpečenstvo pádu"|t }}</th>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:center;width:18%;">{{ "Aplikované"|t }}</th>
                <th style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;padding:4pt;text-align:center;width:22%;">{{ "Kontrola na pracovisku"|t }}</th>
            </tr>
        </thead>
        <tbody>
            {% for key, label in fallRiskLabels %}
                {% set r = (values.fallRisks ?? {})[key] ?? {} %}
                <tr>
                    <td style="border:1pt solid #000;font-size:8.5pt;padding:4pt;">{{ label|t }}</td>
                    <td style="border:1pt solid #000;font-size:8.5pt;padding:4pt;text-align:center;">{{ _self.yn(r.applied ?? '') }}</td>
                    <td style="border:1pt solid #000;font-size:8.5pt;padding:4pt;text-align:center;">{{ _self.yn(r.controlled ?? '') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="heights-table">
        <tr>
            <td class="table-cell" {% if values.fallProtection is not defined and values.fallProtection|length == 0 %}colspan="2"{% endif %}>
                <div class="cell-box">
                    <span class="label"><strong>{{ "Je možné zabrániť vystaveniu sa riziku pádu"|t }}</strong></span>
                    <span class="value">{{ _self.yn(values.avoidFallPossible) }}</span>
                </div>
            </td>
            {% if values.fallProtection is defined and values.fallProtection|length > 0 %}
                <td class="table-cell">
                    <div class="cell-box">
                        <span class="label"><strong>{{ "Použitý systém ochrany proti pádu"|t }}</strong><br>{{ "(použitie predĺžených nástrojov, vykonávanie práce na úrovni podlahy)"|t }}</span>
                        <span class="value">{% for item in values.fallProtection %}<span class="checklist-item">{{ item|t }}</span>{% endfor %}</span>
                    </div>
                </td>
            {% endif %}
        </tr>
        <tr>
            <td class="table-cell" colspan="2">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Vykonávateľ práce je školený – autorizovaný – spôsobilý na prácu vo výškach"|t }}</strong></span>
                    <span class="value">{{ _self.yn(values.workerTrained) }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell" colspan="2">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Stavebné/procesné podmienky sú vhodné pre prácu"|t }}</strong>{{ "(primeraná nosnosť)"|t }}</span>
                    <span class="value">{{ _self.yn(values.constructionSuitable) }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell" {% if values.anchorPointDescription is empty %}colspan="2"{% endif %}>
                <div class="cell-box">
                    <span class="label"><strong>{{ "Použitý kotviaci bod:"|t }}</strong></span>
                    <span class="value">{{ _self.yn(values.anchorPointUsed) }}</span>
                </div>
            </td>

            {% if values.anchorPointDescription %}
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Ak áno, uveďte o aký konštrukčný kotviaci bod ide:"|t }}</strong></span>
                    <span class="value">{{ values.anchorPointDescription }}</span>
                </div>
            </td>
            {% endif %}
        </tr>
        <tr>
            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Je potrebné ohradiť priestor vzhľadom na intenzitu pohybu osôb a techniky v priestore výkonu práce?"|t }}</strong></span>
                    <span class="value">{{ _self.yn(values.fenceRequired) }}</span>
                </div>
            </td>

            <td class="table-cell">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Použité vybavenie"|t }}</strong></span>
                    <span class="value column">
                        {% if values.equipmentUsed is defined and values.equipmentUsed|length > 0 %}
                            {% for item in values.equipmentUsed %}<span>{{ item|t }}</span>{% endfor %}
                        {% endif %}
                    </span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="table-cell" colspan="2">
                <div class="cell-box">
                    <span class="label"><strong>{{ "Použité ochranné prostriedky proti pádu majú platnú kontrolu?"|t }}</strong></span>
                    <span class="value">{{ _self.yn(values.fallProtectionValidInspection) }}</span>
                </div>
            </td>
        </tr>
    </table>
</div>

{# --- Electrical --- #}
{% elseif subpermitType.value == 'electrical' %}
<div class="section">
    <h2>Elektrické práce zvýšeného rizika — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Napätie (V)</td><td class="value">{{ values.voltageLevel ?: '—' }}</td></tr>
        <tr><td class="label">Označenie obvodu / rozvádzača</td><td class="value">{{ values.circuitId ?: '—' }}</td></tr>
        <tr><td class="label">Typ práce</td><td class="value">
            {% if values.liveWork == 'live' %}Práca pod napätím{% elseif values.liveWork == 'dead' %}Práca bez napätia{% else %}—{% endif %}
        </td></tr>
        <tr><td class="label">Obvod odistený a uzamknutý (LOTO)</td><td class="value">{{ _self.yn(values.circuitDeEnergized) }}</td></tr>
        <tr><td class="label">Absencia napätia overená voltmetrom</td><td class="value">{{ _self.yn(values.voltageVerified) }}</td></tr>
        <tr><td class="label">Uzemnenie aplikované</td><td class="value">{{ _self.yn(values.earthingApplied) }}</td></tr>
        <tr><td class="label">Meno elektrikára</td><td class="value">{{ values.electricianName ?: '—' }}</td></tr>
        <tr><td class="label">Číslo osvedčenia (vyhl. 508/2009)</td><td class="value">{{ values.electricianCertificate ?: '—' }}</td></tr>
        <tr><td class="label">Bezpečnostný dozor prítomný</td><td class="value">{{ _self.yn(values.safetyObserverPresent) }}</td></tr>
        {% if values.electricalAdditionalMeasures %}<tr><td class="label">Ďalšie bezpečnostné opatrenia</td><td class="value">{{ values.electricalAdditionalMeasures|nl2br }}</td></tr>{% endif %}
        {% if values.electricalPpe is defined and values.electricalPpe|length > 0 %}
        {% set ppeLabels = {
            'insulated_gloves': 'Izolačné rukavice',
            'insulated_tools':  'Izolačné náradie',
            'face_shield':      'Ochranný štít tváre',
            'arc_flash_suit':   'Oblek na ochranu pred oblúkom',
            'safety_boots':     'Antistatická obuv',
            'voltage_detector': 'Detektor napätia',
        } %}
        <tr><td class="label">Použité OOPP</td><td class="value">{% for key in values.electricalPpe %}<span class="checklist-item">✓ {{ ppeLabels[key] ?? key }}</span>{% endfor %}</td></tr>
        {% endif %}
    </table>
</div>

{# --- Excavation --- #}
{% elseif subpermitType.value == 'excavation' %}
<div class="section">
    <h2>Výkopové práce — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Pracovník vyškolený</td><td class="value">{{ _self.yn(values.workerTrained) }}</td></tr>
        <tr><td class="label">Meno na stretnutí</td><td class="value">{{ values.meetingName ?: '—' }}</td></tr>
        <tr><td class="label">Pozícia na stretnutí</td><td class="value">{{ values.meetingPosition ?: '—' }}</td></tr>
        <tr><td class="label">Dátum stretnutia</td><td class="value">{{ values.meetingDateTime ?: '—' }}</td></tr>
        {% if values.checklist is defined and values.checklist|length > 0 %}
        <tr><td class="label">Kontrolný zoznam</td><td class="value">{% for item in values.checklist %}<span class="checklist-item">✓ {{ item }}</span>{% endfor %}</td></tr>
        {% endif %}
    </table>
</div>

{# --- Lifting --- #}
{% elseif subpermitType.value == 'lifting' %}
<div class="section">
    <h2>Zdvíhacie práce — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Pracovisko uzavierateľné</td><td class="value">{{ _self.yn(values.workplaceEnclosable) }}</td></tr>
        <tr><td class="label">Pracovník vyškolený</td><td class="value">{{ _self.yn(values.workerTrained) }}</td></tr>
        <tr><td class="label">Špeciálne náradie</td><td class="value">{{ _self.yn(values.specialTools) }}</td></tr>
        <tr><td class="label">Zdvíhací plán vypracovaný</td><td class="value">{{ _self.yn(values.liftingPlanEstablished) }}</td></tr>
        <tr><td class="label">Ochrana pred pádom potrebná</td><td class="value">{{ _self.yn(values.fallProtectionRequired) }}</td></tr>
        {% if values.checklist is defined and values.checklist|length > 0 %}
        <tr><td class="label">Kontrolný zoznam</td><td class="value">{% for item in values.checklist %}<span class="checklist-item">✓ {{ item }}</span>{% endfor %}</td></tr>
        {% endif %}
    </table>
</div>

{# --- ATEX --- #}
{% elseif subpermitType.value == 'atex' %}
<div class="section">
    <h2>Práce v priestoroch s nebezpečenstvom výbuchu (ATEX) — špecifické informácie</h2>
    <table class="dl-table">
        <tr><td class="label">Pracovisko zabezpečené</td><td class="value">{{ _self.yn(values.workplaceSecured) }}</td></tr>
        <tr><td class="label">Neiskrecie náradie</td><td class="value">{{ _self.yn(values.nonSparkingTools) }}</td></tr>
        <tr><td class="label">ATEX elektrické náradie</td><td class="value">{{ _self.yn(values.atexPowerTools) }}</td></tr>
        <tr><td class="label">Antistatický odev</td><td class="value">{{ _self.yn(values.antistaticClothing) }}</td></tr>
        <tr><td class="label">Čas začiatku</td><td class="value">{{ values.workStartTime ?: '—' }}</td></tr>
        <tr><td class="label">Čas ukončenia</td><td class="value">{{ values.workFinishTime ?: '—' }}</td></tr>
        {% if values.additionalMeasures %}<tr><td class="label">Dodatočné opatrenia</td><td class="value">{{ values.additionalMeasures|nl2br }}</td></tr>{% endif %}
    </table>
</div>

{# --- Command B --- #}
{% elseif subpermitType.value == 'command_b' %}
{% set locationLabels   = {'on': 'na elektrickom zariadení', 'near': 'v blízkosti elektrického zariadenia'} %}
{% set voltageLabels    = {'with': 's elektrickým napätím', 'without': 'bez elektrického napätia'} %}
{% set deliveryLabels   = {'in_person': 'osobne', 'other': 'iná osoba', 'email': 'e-mailom'} %}
{% set commandBGroups = {
    'turn_off':              'Vypnúť',
    'disconnected':          'Odpojené',
    'further_measures':      'Ďalšie opatrenia',
    'check_de_energized':    'Ako overiť, že inštalácia je bez napätia',
    'grounding_shorting':    'Uzemnenie a skratovanie',
    'workplace_marking':     'Spôsob označenia pracoviska',
    'workplace_definition':  'Vymedzenie pracoviska',
    'additional_safety':     'Doplnkové bezpečnostné opatrenia',
} %}

<div class="section">
    <h2>Príkaz „B" — identifikácia</h2>
    <table class="dl-table">
        <tr><td class="label">Príkaz „B" (číslo)</td><td class="value">{{ values.orderNumber ?: '—' }}</td></tr>
        <tr><td class="label">Pre vedúceho prác</td><td class="value">{{ values.supervisorName ?: '—' }}{% if values.supervisorGroupSize %} — skupina {{ values.supervisorGroupSize }} pracovníkov{% endif %}</td></tr>
        <tr><td class="label">Pre dozor</td><td class="value">{{ values.supervisionName ?: '—' }}{% if values.supervisionGroupSize %} — skupina {{ values.supervisionGroupSize }} pracovníkov{% endif %}</td></tr>
        <tr><td class="label">Dňa</td><td class="value">{{ values.day ? values.day|date('d.m.Y') : '—' }}{% if values.fromTime %} od {{ values.fromTime }}{% endif %}{% if values.untilTime %} do {{ values.untilTime }}{% endif %}</td></tr>
        <tr><td class="label">Práca sa vykonáva</td><td class="value">{{ locationLabels[values.locationType] ?? '—' }}, {{ voltageLabels[values.voltageMode] ?? '—' }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Zabezpečenie pracoviska</h2>
    <table class="dl-table">
        <tr><td class="label">Vypnuté a zabezpečené</td><td class="value">{{ values.workplaceTurnOff ? values.workplaceTurnOff|nl2br : '—' }}</td></tr>
        <tr><td class="label">Pracovisko bude zabezpečené</td><td class="value">{{ values.workplaceSecure ? values.workplaceSecure|nl2br : '—' }}</td></tr>
        <tr><td class="label">Pod napätím zostáva</td><td class="value">{{ values.remainUnderVoltage ? values.remainUnderVoltage|nl2br : '—' }}</td></tr>
    </table>
</div>

<div class="section">
    <h2>Doručenie Príkazu „B"</h2>
    <table class="dl-table">
        <tr><td class="label">Spôsob doručenia</td><td class="value">{{ deliveryLabels[values.deliveryMethod] ?? '—' }}</td></tr>
        <tr><td class="label">Vydal / nahlásil</td><td class="value">{{ values.issuedByName ?: '—' }}{% if values.issuedByDate %} — {{ values.issuedByDate|date('d.m.Y') }}{% endif %}{% if values.issuedByTime %} {{ values.issuedByTime }}{% endif %}</td></tr>
        <tr><td class="label">Prijal</td><td class="value">{{ values.receivedByName ?: '—' }}{% if values.receivedByDate %} — {{ values.receivedByDate|date('d.m.Y') }}{% endif %}{% if values.receivedByTime %} {{ values.receivedByTime }}{% endif %}</td></tr>
        <tr><td class="label">Kniha príkazov „B" č.</td><td class="value">{{ values.orderBookNumber ?: '—' }}</td></tr>
        <tr><td class="label">Číslo príkazu</td><td class="value">{{ values.commandNumber ?: '—' }}</td></tr>
    </table>
</div>

{% set commandBActions = values.actions ?? {} %}
{% if commandBActions|length > 0 %}
<div class="section">
    <h2>Opatrenia na zabezpečenie pracoviska</h2>
    {% for groupKey, groupLabel in commandBGroups %}
        {% set rows = commandBActions[groupKey] ?? [] %}
        {% if rows|length > 0 %}
            <h3 style="margin:6pt 0 3pt;">{{ groupLabel }}</h3>
            <table class="hazard-table">
                <thead>
                    <tr>
                        <th style="width:12%">Miesto</th>
                        <th>Úkon</th>
                        <th style="width:8%">Por. č.</th>
                        <th style="width:18%">Zodpovedný</th>
                        <th style="width:14%">Dátum / čas</th>
                        <th style="width:16%">Podpis</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.place ?: '—' }}</td>
                            <td>{{ row.description ?: '—' }}</td>
                            <td>{{ row.serialNumber ?: '—' }}</td>
                            <td>{{ row.responsible ?: '—' }}</td>
                            <td>{{ row.performedAt ? row.performedAt|replace({'T': ' '}) : '—' }}</td>
                            <td>{{ row.signatureName ?: '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endfor %}
</div>
{% endif %}

<div class="section">
    <h2>Okolie pracoviska</h2>
    <table class="dl-table">
        <tr><td class="label">Najbližšie časti pod napätím</td><td class="value">{{ values.nearestVoltageParts ? values.nearestVoltageParts|nl2br : '—' }}</td></tr>
        <tr><td class="label">Atmosférické podmienky</td><td class="value">{{ values.atmosphericConditions ?: '—' }}</td></tr>
    </table>
</div>
{% endif %}

{% endif %}{# end subpermitType #}

{# ── Multi-signer requests (Electrical) ─────────────────────────────────── #}
{% if signingRequests|length > 0 %}
<div class="section">
    <h2>Signatári subpermitu</h2>
    {% set roleLabels = {
        'mdlz_qualified_emergency': 'Kvalifikovaná osoba MDLZ — havarijný plán',
        'area_supervisor':          'Vedúci pracoviska',
        'mdlz_qualified_approval':  'Kvalifikovaná osoba MDLZ — schválenie SSoW',
        'third_party':              'Dodávateľ (tretia strana)',
        'second_technician':        'Druhý technik (>750 VAC)',
        'safety_rep':               'Zástupca pre bezpečnosť (>750 VAC)',
        'maintenance_manager':      'Vedúci údržby (>750 VAC)',
    } %}
    <table class="signer-table">
        <thead>
            <tr>
                <th style="width:35%">Rola</th>
                <th style="width:25%">Meno</th>
                <th style="width:20%">Dátum podpisu</th>
                <th style="width:20%">Podpis</th>
            </tr>
        </thead>
        <tbody>
            {% for roleValue, req in signingRequests %}
            <tr>
                <td>{{ roleLabels[roleValue] ?? roleValue }}</td>
                <td>{{ req.signerName ?: '—' }}</td>
                <td>{{ req.signedAt ? req.signedAt|date('d.m.Y H:i') : '—' }}</td>
                <td>
                    {% if signingImages[roleValue] is defined and signingImages[roleValue] %}
                        <img src="{{ signingImages[roleValue] }}" style="max-width:80pt;max-height:30pt;">
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{# ── Rejection note ──────────────────────────────────────────────────────── #}
{% if subpermit.rejectionNote %}
<div class="section">
    <h2>Dôvod zamietnutia</h2>
    <p>{{ subpermit.rejectionNote|nl2br }}</p>
</div>
{% endif %}

{# ── Pre-work signatures (signed AFTER approval, BEFORE work starts) ───── #}
<div class="section">
    <h2>{{ "Pred začatím prác"|t }}</h2>
    <table class="signature-table">
        <tr>
            <td>
                <div class="signature-box">
                    <div class="label"><strong>{{ "Pred prácou"|t }}</strong> ({{ "vydavateľ povolenia"|t }})</div>
                    {% set issuerPreSig = signatures['issuer_prework'] ?? null %}
                    {% if issuerPreSig %}
                        <div class="meta">
                            <strong>{{ "Meno a priezvisko"|t }}: {{ issuerPreSig.signerName }}</strong>
                            {% if issuerPreSig.signatureDate %}<span>{{ "Dátum"|t }}: {{ issuerPreSig.signatureDate|date('d.m.Y') }}</span>{% endif %}
                        </div>
                        {% if sigImages['issuer_prework'] is defined and sigImages['issuer_prework'] %}
                            <img src="{{ sigImages['issuer_prework'] }}" class="image">
                        {% else %}
                            <div class="line"></div>
                        {% endif %}
                    {% else %}
                        <div class="line"></div>
                        <div class="meta">{{ "Nepodpísané"|t }}</div>
                    {% endif %}
                </div>
            </td>

            <td>
                <div class="signature-box">
                    <div class="label"><strong>{{ "Pred prácou"|t }}</strong> ({{ "prijímateľ povolenia"|t }})</div>
                    {% set contractorPreSig = signatures['contractor_prework'] ?? null %}
                    {% if contractorPreSig %}
                        <div class="meta">
                            <strong>{{ "Meno a priezvisko"|t }}: {{ contractorPreSig.signerName }}</strong>
                            {% if contractorPreSig.signerEmployer %}<span>{{ "Firma"|t }}: {{ contractorPreSig.signerEmployer }}</span>{% endif %}
                            {% if contractorPreSig.signatureDate %}<span>{{ "Dátum"|t }}: {{ contractorPreSig.signatureDate|date('d.m.Y') }}</span>{% endif %}
                        </div>
                        {% if sigImages['contractor_prework'] is defined and sigImages['contractor_prework'] %}
                            <img src="{{ sigImages['contractor_prework'] }}" class="image">
                        {% else %}
                            <div class="line"></div>
                        {% endif %}
                    {% else %}
                        <div class="line"></div>
                        <div class="meta">{{ "Nepodpísané"|t }}</div>
                    {% endif %}
                </div>
            </td>
        </tr>
    </table>
</div>

{# ── Issuer signature ────────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Ukončenie plánovania prác a povolení"|t }}</h2>

    {# Closure status + trial-operation, captured at contractor completion sign #}
    {% if (values.closureStatus is defined and values.closureStatus|length > 0) or values.requiresTestRun is defined %}
        {% set closureLabels = {
            'work_completed':                  'Práce boli dokončené'|t,
            'equipment_operational':           'Zariadenie je prevádzkyschopné'|t,
            'equipment_not_operational':       'Zariadenie nie je prevádzkyschopné'|t,
            'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené'|t,
            'work_suspended':                  'Práce boli pozastavené'|t,
        } %}
        <table style="width:100%;border-collapse:collapse;margin:0 0 8pt 0;">
            {% if values.closureStatus is defined and values.closureStatus|length > 0 %}
                <tr>
                    <td style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;font-weight:bold;padding:4pt;width:35%;vertical-align:top;">{{ "Stav po dokončení"|t }}</td>
                    <td style="border:1pt solid #000;font-size:9pt;padding:4pt;">
                        {% for k in values.closureStatus %}
                            <span class="checklist-item">✓ {{ closureLabels[k] ?? k }}</span>
                        {% endfor %}
                    </td>
                </tr>
            {% endif %}
            {% if values.requiresTestRun is defined and values.requiresTestRun in ['yes','no'] %}
                <tr>
                    <td style="border:1pt solid #000;background:rgba(79,33,112,0.5);font-size:9pt;font-weight:bold;padding:4pt;vertical-align:top;">{{ "Vyžaduje sa skúšobná prevádzka"|t }}</td>
                    <td style="border:1pt solid #000;font-size:9pt;padding:4pt;">{{ values.requiresTestRun == 'yes' ? 'Áno'|t : 'Nie'|t }}</td>
                </tr>
            {% endif %}
        </table>
    {% endif %}

    <table class="signature-table">
        <tr>
            <td>
                <div class="signature-box">
                    <div class="label"><strong>{{ "Zrušenie/dokončenie"|t }}</strong>({{ "vydavateľ povolenia)"|t }})</div>
                    {% set issuerSig = signatures['issuer'] ?? null %}
                    {% if issuerSig %}
                        <div class="meta">
                            <strong>{{ "Meno a priezvisko"|t }}: {{ issuerSig.signerName }}</strong>
                            {% if issuerSig.signatureDate %}<span>{{ "Dátum"|t }}: {{ issuerSig.signatureDate|date('d.m.Y') }}</span>{% endif %}
                        </div>
                        {% if sigImages['issuer'] is defined and sigImages['issuer'] %}
                            <img src="{{ sigImages['issuer'] }}" class="image">
                        {% else %}
                            <div class="line"></div>
                        {% endif %}
                    {% else %}
                        <div class="line"></div>
                        <div class="meta">{{ issuer ? (issuer.fullName ?: issuer.username) : '—' }}</div>
                    {% endif %}
                </div>
            </td>

            {# Contractor signature if present #}
            <td>
                <div class="signature-box">
                    <div class="label"><strong>{{ "Zrušenie/dokončenie"|t }}</strong>({{ "prijímateľ povolenia)"|t }})</div>
                    {% set contractorSig = signatures['contractor'] ?? null %}
                    {% if contractorSig %}
                        <div class="meta">
                            <strong>{{ "Meno a priezvisko"|t }}: {{ contractorSig.signerName }}</strong>
                            {% if contractorSig.signerEmployer %}<span>{{ "Firma"|t }}: {{ contractorSig.signerEmployer }}</span>{% endif %}
                            {% if contractorSig.signatureDate %}<span>{{ "Dátum"|t }}: {{ contractorSig.signatureDate|date('d.m.Y') }}</span>{% endif %}
                        </div>
                        {% if sigImages['contractor'] is defined and sigImages['contractor'] %}
                            <img src="{{ sigImages['contractor'] }}" class="image">
                        {% else %}
                            <div class="line"></div>
                        {% endif %}
                    {% else %}
                        <div class="line"></div>
                        <div class="meta">Dodávateľ</div>
                    {% endif %}
                </div>
            </td>
        </tr>
    </table>
</div>

{# ── Footer ──────────────────────────────────────────────────────────────── #}
<div class="doc-footer">
    <table style="width:100%;border-collapse:collapse;">
        <tr>
            <td>Mondelēz Slovensko — {{ subpermitType ? subpermitType.label() : subpermit.type }}</td>
            <td style="text-align:right;">Permit: {{ permit.permitNumber }} | Vygenerované: {{ generatedAt }}</td>
        </tr>
    </table>
</div>

</body>
</html>
