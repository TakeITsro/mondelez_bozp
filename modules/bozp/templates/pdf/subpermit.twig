    {key: 'safeAccessEnsured',               label: 'Bezpečný prístup na pracovisko zabezpečený'},
    {key: 'craneDangerZoneFenced',           label: 'Nebezpečná zóna žeriava ohradená'},
    {key: 'employeesAwareOfFencingAndBan',   label: 'Zamestnanci oboznámení s ohradením a zákazom vstupu'},
    {key: 'craneControlsHaveLoadBinderView', label: 'Ovládače žeriava s výhľadom na viazača bremena'},
    {key: 'craneInGoodCondition',            label: 'Žeriav v dobrom technickom stave'},
    {key: 'otherCollisionRisks',             label: 'V oblasti iné žeriavy, vozidlá, siete, osoby alebo kolízne riziká'},
    {key: 'noOtherWorkNearby',               label: 'Skontrolované, že sa v blízkosti nevykonáva iná práca'},
    {key: 'bindingEquipmentInspected',       label: 'Viazacie prostriedky v dobrom stave s platnou revíziou'},
    {key: 'communicationAgreed',             label: 'Dohodnutá komunikácia medzi viazačom a obsluhou'},
    {key: 'fallProtectionRequired',          label: 'Vyžadujú sa prostriedky ochrany pred pádom'},
] %}
{% set liftingFinal = [
    {key: 'liftingPlanEstablished',     label: 'Plán pre zdvíhacie a žeriavové práce vypracovaný a overený'},
    {key: 'workChecksDiscussedOnSite',  label: 'Práca / činnosť skontrolovaná a prediskutovaná na mieste'},
] %}

{% macro liftingMatrix(rows, values) %}
    <table class="hazard-table">
        <thead>
            <tr>
                <th>{{ "Požiadavka"|t('bozp') }}</th>
                <th style="width:12%">{{ "Áno / Nie"|t('bozp') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in rows %}
                <tr>
                    <td>{{ item.label|t('bozp') }}</td>
                    <td>{{ _self.yn(attribute(values, item.key) ?? '') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

<div class="section">
    <h2>{{ "Zdvíhacie práce — Príprava na činnosť"|t('bozp') }}</h2>
    {{ _self.liftingMatrix(liftingPreparation, values) }}
    {% if values.specialToolsUsed %}
        <br>
        <table class="data-table">
            <tr>
                <td class="label tall">{{ "Špeciálne náradie / vybavenie"|t('bozp') }}</td>
                <td class="value tall">{{ values.specialToolsUsed|nl2br }}</td>
            </tr>
        </table>
    {% endif %}
</div>

<div class="section">
    <h2>{{ "Bezpečnostné požiadavky"|t('bozp') }}</h2>
    {{ _self.liftingMatrix(liftingSafety, values) }}
</div>

<div class="section">
    <h2>{{ "Záverečné potvrdenia"|t('bozp') }}</h2>
    {{ _self.liftingMatrix(liftingFinal, values) }}
</div>

{# ============================================================
   ATEX
   ============================================================ #}
{% elseif subpermitType.value == 'atex' %}
{% set atexZoneLabels = {
    'zone_22': 'Zóna 22', 'zone_21': 'Zóna 21',
    'zone_2':  'Zóna 2',  'zone_1':  'Zóna 1', 'zone_0': 'Zóna 0',
} %}
{% set atexSecuringStatusLabels = {
    'secured':       'Pracovisko bolo zabezpečené',
    'not_possible':  'Pracovisko nie je možné zabezpečiť (vyžadované dodatočné opatrenia)',
} %}
{% set atexMethodLabels = {
    'emptying':         'Vyprázdnenie zariadenia / priestoru',
    'wetting_water':    'Zvlhčenie výbušnej látky vodou',
    'inertization_gas': 'Inertizácia plynom',
    'other':            'Iné',
} %}
{% set atexPpeLabels = {
    'hard_hat': 'Prilba', 'safety_glasses': 'Ochranné okuliare',
    'safety_gloves': 'Ochranné rukavice', 'respirator': 'Respirátor',
    'hearing_protection': 'Ochrana sluchu', 'safety_shoes': 'Ochranná obuv',
    'safety_harness': 'Bezpečnostný postroj', 'antistatic_clothing': 'Antistatický odev',
    'other': 'Iné',
} %}
{% set atexToolLabels = {
    'hand_tools': 'Ručné náradie', 'non_sparking_tools': 'Neiskrivé náradie',
    'portable_power_tools': 'Prenosné elektrické náradie', 'welding_machine': 'Zvárací stroj',
} %}
{% set atexInsulationLabels = {
    'safety_net': 'Záchytná sieť', 'safety_tape': 'Výstražná páska',
    'fixed_barriers': 'Pevné zábrany', 'reinforcement': 'Vystuženie',
    'safety_markings': 'Bezpečnostné označenie', 'trench_covers': 'Kryty výkopov',
    'other': 'Iné',
} %}

<div class="section">
    <h2>{{ "ATEX — EX zóna a zabezpečenie pracoviska"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "EX zóna"|t('bozp') }}</td>
                <td class="value tall">
                    {% set zonesEx = values.exZone ?? [] %}
                    {% if zonesEx|length > 0 %}
                        {% for key in zonesEx %}<span class="checklist-item">✓ {{ atexZoneLabels[key] ?? key }}</span>{% endfor %}
                    {% else %}—{% endif %}
                </td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Stav zabezpečenia"|t('bozp') }}</td>
                <td class="value">{{ atexSecuringStatusLabels[values.securingStatus] ?? '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Spôsob zabezpečenia"|t('bozp') }}</td>
                <td class="value tall">
                    {% set sm = values.securingMethods ?? [] %}
                    {% if sm|length > 0 %}
                        {% for key in sm %}<span class="checklist-item">✓ {{ atexMethodLabels[key] ?? key }}</span>{% endfor %}
                    {% else %}—{% endif %}
                    {% if values.securingMethodsOther %} — {{ values.securingMethodsOther }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Dodatočné opatrenia"|t('bozp') }}</h2>
    <table class="hazard-table">
        <thead>
            <tr>
                <th>{{ "Opatrenie"|t('bozp') }}</th>
                <th style="width:12%">{{ "Áno / Nie"|t('bozp') }}</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>{{ "Neiskrivé ručné náradie schválené pre ATEX"|t('bozp') }}</td><td>{{ _self.yn(values.measureNonSparkingHandTools) }}</td></tr>
            <tr><td>{{ "Prenosné elektrické náradie s ATEX certifikáciou"|t('bozp') }}</td><td>{{ _self.yn(values.measurePortablePowerToolsAtex) }}</td></tr>
            <tr><td>{{ "Antistatický odev (čiapka, maska, odev, obuv)"|t('bozp') }}</td><td>{{ _self.yn(values.measureAntistaticClothing) }}</td></tr>
        </tbody>
    </table>
    <p style="margin-top:4pt;font-size:8pt;color:#4F2170;">
        {{ "Hodinová kontrola vykonávania opatrení je v zodpovednosti vedúceho prác. Pri uzavretí subpermitu je vyžadovaná príloha s evidenciou kontrol."|t('bozp') }}
    </p>
</div>

<div class="section">
    <h2>{{ "Plán a OOPP"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Plán na obmedzenie nebezpečnej energie"|t('bozp') }}</td>
                <td class="value">{{ _self.yn(values.hazardousEnergyPlanEstablished) }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Použité OOPP"|t('bozp') }}</td>
                <td class="value tall">
                    {% set p = values.usedPpe ?? [] %}
                    {% if p|length > 0 %}
                        {% for key in p %}<span class="checklist-item">✓ {{ atexPpeLabels[key] ?? key }}</span>{% endfor %}
                    {% else %}—{% endif %}
                    {% if values.usedPpeOther %} — {{ values.usedPpeOther }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Náradie a izolácia pracoviska"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Použité náradie"|t('bozp') }}</td>
                <td class="value tall">
                    {% set t = values.toolsUsed ?? [] %}
                    {% if t|length > 0 %}
                        {% for key in t %}<span class="checklist-item">✓ {{ atexToolLabels[key] ?? key }}</span>{% endfor %}
                    {% else %}—{% endif %}
                </td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Izolácia pracoviska"|t('bozp') }}</td>
                <td class="value tall">
                    {% set i = values.workspaceInsulation ?? [] %}
                    {% if i|length > 0 %}
                        {% for key in i %}<span class="checklist-item">✓ {{ atexInsulationLabels[key] ?? key }}</span>{% endfor %}
                    {% else %}—{% endif %}
                    {% if values.workspaceInsulationOther %} — {{ values.workspaceInsulationOther }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
    </table>
</div>

{# ============================================================
   COMMAND B
   ============================================================ #}
{% elseif subpermitType.value == 'command_b' %}
{% set locationLabels   = {'on': 'na elektrickom zariadení', 'near': 'v blízkosti elektrického zariadenia'} %}
{% set voltageLabels    = {'with': 's elektrickým napätím', 'without': 'bez elektrického napätia'} %}
{% set deliveryLabels   = {'in_person': 'osobne', 'other': 'iná osoba', 'email': 'e-mailom'} %}
{% set commandBGroups = {
    'turn_off':              'Vypnúť',
    'disconnected':          'Odpojené',
    'further_measures':      'Ďalšie opatrenia',
    'check_de_energized':    'Ako overiť, že inštalácia je bez napätia',
    'grounding_shorting':    'Uzemnenie a skratovanie',
    'workplace_marking':     'Spôsob označenia pracoviska',
    'workplace_definition':  'Vymedzenie pracoviska',
    'additional_safety':     'Doplnkové bezpečnostné opatrenia',
} %}

<div class="section">
    <h2>{{ "Príkaz „B\" — identifikácia"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Príkaz „B\" (číslo)"|t('bozp') }}</td>
                <td class="value">{{ values.orderNumber ?: '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Dňa"|t('bozp') }}</td>
                <td class="value">
                    {{ values.day ? values.day|date('d.m.Y') : '—' }}
                    {% if values.fromTime %} {{ "od"|t('bozp') }} {{ values.fromTime }}{% endif %}
                    {% if values.untilTime %} {{ "do"|t('bozp') }} {{ values.untilTime }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Pre vedúceho prác"|t('bozp') }}</td>
                <td class="value">
                    {{ values.supervisorName ?: '—' }}
                    {% if values.supervisorGroupSize %} — {{ "skupina"|t('bozp') }} {{ values.supervisorGroupSize }} {{ "pracovníkov"|t('bozp') }}{% endif %}
                </td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Pre dozor"|t('bozp') }}</td>
                <td class="value">
                    {{ values.supervisionName ?: '—' }}
                    {% if values.supervisionGroupSize %} — {{ "skupina"|t('bozp') }} {{ values.supervisionGroupSize }} {{ "pracovníkov"|t('bozp') }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Práca sa vykonáva"|t('bozp') }}</td>
                <td class="value">{{ locationLabels[values.locationType] ?? '—' }}, {{ voltageLabels[values.voltageMode] ?? '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Zabezpečenie pracoviska"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Vypnuté a zabezpečené"|t('bozp') }}</td>
                <td class="value tall">{{ values.workplaceTurnOff ? values.workplaceTurnOff|nl2br : '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Pracovisko bude zabezpečené"|t('bozp') }}</td>
                <td class="value tall">{{ values.workplaceSecure ? values.workplaceSecure|nl2br : '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Pod napätím zostáva"|t('bozp') }}</td>
                <td class="value tall">{{ values.remainUnderVoltage ? values.remainUnderVoltage|nl2br : '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>{{ "Doručenie Príkazu „B\""|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Spôsob doručenia"|t('bozp') }}</td>
                <td class="value">{{ deliveryLabels[values.deliveryMethod] ?? '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Kniha príkazov „B\" č."|t('bozp') }}</td>
                <td class="value">{{ values.orderBookNumber ?: '—' }}</td>
            </tr></table></td>
        </tr>
        <tr>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Vydal / nahlásil"|t('bozp') }}</td>
                <td class="value">
                    {{ values.issuedByName ?: '—' }}
                    {% if values.issuedByDate %} — {{ values.issuedByDate|date('d.m.Y') }}{% endif %}
                    {% if values.issuedByTime %} {{ values.issuedByTime }}{% endif %}
                </td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label">{{ "Prijal"|t('bozp') }}</td>
                <td class="value">
                    {{ values.receivedByName ?: '—' }}
                    {% if values.receivedByDate %} — {{ values.receivedByDate|date('d.m.Y') }}{% endif %}
                    {% if values.receivedByTime %} {{ values.receivedByTime }}{% endif %}
                </td>
            </tr></table></td>
        </tr>
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Číslo príkazu"|t('bozp') }}</td>
                <td class="value">{{ values.commandNumber ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>

{% set commandBActions = values.actions ?? {} %}
{% if commandBActions|length > 0 %}
<div class="section">
    <h2>{{ "Opatrenia na zabezpečenie pracoviska"|t('bozp') }}</h2>
    {% for groupKey, groupLabel in commandBGroups %}
        {% set rows = commandBActions[groupKey] ?? [] %}
        {% if rows|length > 0 %}
            <h3>{{ groupLabel|t('bozp') }}</h3>
            <table class="signer-table">
                <thead>
                    <tr>
                        <th style="width:12%">{{ "Miesto"|t('bozp') }}</th>
                        <th>{{ "Úkon"|t('bozp') }}</th>
                        <th style="width:8%">{{ "Por. č."|t('bozp') }}</th>
                        <th style="width:18%">{{ "Zodpovedný"|t('bozp') }}</th>
                        <th style="width:14%">{{ "Dátum / čas"|t('bozp') }}</th>
                        <th style="width:16%">{{ "Podpis"|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.place ?: '—' }}</td>
                            <td>{{ row.description ?: '—' }}</td>
                            <td>{{ row.serialNumber ?: '—' }}</td>
                            <td>{{ row.responsible ?: '—' }}</td>
                            <td>{{ row.performedAt ? row.performedAt|replace({'T': ' '}) : '—' }}</td>
                            <td>{{ row.signatureName ?: '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endfor %}
</div>
{% endif %}

<div class="section">
    <h2>{{ "Okolie pracoviska"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td><table class="data-table"><tr>
                <td class="label tall">{{ "Najbližšie časti pod napätím"|t('bozp') }}</td>
                <td class="value tall">{{ values.nearestVoltageParts ? values.nearestVoltageParts|nl2br : '—' }}</td>
            </tr></table></td>
            <td><table class="data-table"><tr>
                <td class="label tall">{{ "Atmosférické podmienky"|t('bozp') }}</td>
                <td class="value tall">{{ values.atmosphericConditions ?: '—' }}</td>
            </tr></table></td>
        </tr>
    </table>
</div>
{% endif %}

{% endif %}{# end subpermitType #}
<br>

{# ── Repeat header before signatures block ─────────────────────────────── #}
{{ _self.docHeader(permit, subpermit, subpermitType, generatedAt, statusLabels) }}

{# ── Multi-signer requests (Electrical / Excavation / Confined Space etc.) ─ #}
{% if signingRequests|length > 0 %}
<div class="section">
    <h2>{{ "Signatári subpermitu"|t('bozp') }}</h2>
    {% set roleLabels = {
        'mdlz_qualified_emergency':       'Kvalifikovaná osoba MDLZ — havarijný plán',
        'area_supervisor':                'Vedúci pracoviska',
        'mdlz_qualified_approval':        'Kvalifikovaná osoba MDLZ — schválenie SSoW',
        'third_party':                    'Dodávateľ (tretia strana)',
        'second_technician':              'Druhý technik (>750 VAC)',
        'safety_rep':                     'Zástupca pre bezpečnosť (>750 VAC)',
        'maintenance_manager':            'Vedúci údržby (>750 VAC)',
        'excavation_hse_approval':        'FÁZA 2 — Schválenie HSE oddelením',
        'excavation_authority_approval':  'FÁZA 3 — Schválenie oprávneným orgánom',
        'cs_entrant':                     'Vstupujúci (entrant)',
        'cs_supervisor_entrant':          'Dozorujúci pri vstupe',
        'cs_supervisor_cse':              'Vedúci vstupu (supervisor in CSE)',
        'cs_mdlz_orderant':               'Objednávateľ MDLZ',
        'cs_hse_department':              'HSE oddelenie',
    } %}
    <table class="signer-table">
        <thead>
            <tr>
                <th style="width:30%">{{ "Rola"|t('bozp') }}</th>
                <th style="width:20%">{{ "Meno"|t('bozp') }}</th>
                <th style="width:20%">{{ "Funkcia"|t('bozp') }}</th>
                <th style="width:15%">{{ "Dátum podpisu"|t('bozp') }}</th>
                <th style="width:15%">{{ "Podpis"|t('bozp') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for roleValue, req in signingRequests %}
            <tr>
                <td>{{ roleLabels[roleValue] ?? roleValue }}</td>
                <td>{{ req.signerName ?: '—' }}</td>
                <td>{{ req.jobTitle ?: '—' }}</td>
                <td>{{ req.signedAt ? req.signedAt|date('d.m.Y H:i') : '—' }}</td>
                <td>
                    {% if signingImages[roleValue] is defined and signingImages[roleValue] %}
                        <img src="{{ signingImages[roleValue] }}">
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{# ── Rejection note ──────────────────────────────────────────────────────── #}
{% if subpermit.rejectionNote %}
<div class="section">
    <h2>{{ "Dôvod zamietnutia"|t('bozp') }}</h2>
    <table class="data-table">
        <tr>
            <td class="value tall">{{ subpermit.rejectionNote|nl2br }}</td>
        </tr>
    </table>
</div>
{% endif %}

{# ── Pre-work signatures (signed BEFORE HSE approval, BEFORE work starts) ─ #}
<div class="section sig-section">
    <h2>{{ "Podpisy pred začatím prác"|t('bozp') }}</h2>
    <table class="signature-table">
        <tr>
            {# Issuer prework #}
            <td>
                <div class="sig-label">{{ "Vydavateľ — pred prácou"|t('bozp') }}</div>
                {% set issuerPreSig = signatures['issuer_prework'] ?? null %}
                {% if issuerPreSig %}
                    {% if sigImages['issuer_prework'] is defined and sigImages['issuer_prework'] %}
                        <img src="{{ sigImages['issuer_prework'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ issuerPreSig.signerName }}</strong>
                        {% if issuerPreSig.signatureDate %} · {{ issuerPreSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">{{ issuer ? (issuer.fullName ?: issuer.username) : 'Vydavateľ — pred prácou' }}</div>
                {% endif %}
            </td>

            {# Contractor prework #}
            <td>
                <div class="sig-label">{{ "Dodávateľ — pred prácou"|t('bozp') }}</div>
                {% set contractorPreSig = signatures['contractor_prework'] ?? null %}
                {% if contractorPreSig %}
                    {% if sigImages['contractor_prework'] is defined and sigImages['contractor_prework'] %}
                        <img src="{{ sigImages['contractor_prework'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ contractorPreSig.signerName }}</strong>
                        {% if contractorPreSig.signerEmployer %} / {{ contractorPreSig.signerEmployer }}{% endif %}
                        {% if contractorPreSig.signatureDate %} · {{ contractorPreSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">{{ "Dodávateľ — pred prácou"|t('bozp') }}</div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Closure status flags (captured at contractor closure) ────────────── #}
{% if (values.closureStatus is defined and values.closureStatus|length > 0) or values.requiresTestRun is defined %}
{% set closureLabels = {
    'work_completed':                  'Práce boli dokončené',
    'equipment_operational':           'Zariadenie je prevádzkyschopné',
    'equipment_not_operational':       'Zariadenie nie je prevádzkyschopné',
    'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené',
    'work_suspended':                  'Práce boli pozastavené',
} %}
<div class="section">
    <h2>{{ "Stav po dokončení"|t('bozp') }}</h2>
    <table class="dl-table">
        {% if values.closureStatus is defined and values.closureStatus|length > 0 %}
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label tall">{{ "Stav po dokončení"|t('bozp') }}</td>
                <td class="value tall">
                    {% for k in values.closureStatus %}
                        {% set kLabel = closureLabels[k] ?? k %}
                        <span class="checklist-item">✓ {{ kLabel|t('bozp') }}</span>
                    {% endfor %}
                </td>
            </tr></table></td>
        </tr>
        {% endif %}
        {% if values.requiresTestRun is defined and values.requiresTestRun in ['yes','no'] %}
        <tr>
            <td colspan="2"><table class="data-table"><tr>
                <td class="label">{{ "Vyžaduje sa skúšobná prevádzka"|t('bozp') }}</td>
                <td class="value">{{ values.requiresTestRun == 'yes' ? 'Áno'|t('bozp') : 'Nie'|t('bozp') }}</td>
            </tr></table></td>
        </tr>
        {% endif %}
    </table>
</div>
{% endif %}

{# ── Closure signatures ─────────────────────────────────────────────────── #}
<div class="section sig-section">
    <h2>{{ "Podpisy pri uzavretí"|t('bozp') }}</h2>
    <table class="signature-table">
        <tr>
            {# Contractor closure #}
            <td>
                <div class="sig-label">{{ "Dodávateľ — uzavretie"|t('bozp') }}</div>
                {% set contractorSig = signatures['contractor'] ?? null %}
                {% if contractorSig %}
                    {% if sigImages['contractor'] is defined and sigImages['contractor'] %}
                        <img src="{{ sigImages['contractor'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ contractorSig.signerName }}</strong>
                        {% if contractorSig.signerEmployer %} / {{ contractorSig.signerEmployer }}{% endif %}
                        {% if contractorSig.signatureDate %} · {{ contractorSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">{{ "Dodávateľ — uzavretie"|t('bozp') }}</div>
                {% endif %}
            </td>

            {# Issuer closure (also fallback to legacy 'issuer' role) #}
            <td>
                <div class="sig-label">{{ "Vydavateľ — uzavretie"|t('bozp') }}</div>
                {% set issuerCloseSig = signatures['issuer_closure'] ?? (signatures['issuer'] ?? null) %}
                {% if issuerCloseSig %}
                    {% if sigImages['issuer_closure'] is defined and sigImages['issuer_closure'] %}
                        <img src="{{ sigImages['issuer_closure'] }}" class="sig-image">
                    {% elseif sigImages['issuer'] is defined and sigImages['issuer'] %}
                        <img src="{{ sigImages['issuer'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ issuerCloseSig.signerName }}</strong>
                        {% if issuerCloseSig.signatureDate %} · {{ issuerCloseSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">{{ issuer ? (issuer.fullName ?: issuer.username) : 'Vydavateľ — uzavretie' }}</div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Footer ──────────────────────────────────────────────────────────────── #}
<div class="doc-footer">
    <table style="width:100%;border-collapse:collapse;">
        <tr>
            <td>{{ 'Mondelēz Slovensko, s.r.o. — BOZP subpermit' }} — {{ subpermitType ? subpermitType.label() : subpermit.type }}</td>
            <td style="text-align:right;">{{ "Permit"|t('bozp') }}: {{ permit.permitNumber }} | {{ "Vygenerované"|t('bozp') }}: {{ generatedAt }}</td>
        </tr>
    </table>
</div>

</body>
</html>
