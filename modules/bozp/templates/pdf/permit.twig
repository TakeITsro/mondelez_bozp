                            <td>{{ "Platné do"|t('bozp') }}:</td>
                            <td>{{ permit.validTo|date('d.m.Y') }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td>{{ "Stav"|t('bozp') }}:</td>
