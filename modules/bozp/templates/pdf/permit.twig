{# ── Hazards matrix ──────────────────────────────────────────────────────── #}
{% if hazards|length > 0 %}
<div class="section">
    <h2>{{ "Riziká a OOPP"|t('bozp') }}</h2>
    <table class="hazard-table">
        <thead>
            <tr>
                <th>{{ "Pikto"|t('bozp') }}</th>
                <th>{{ "Riziko"|t('bozp') }}</th>
                <th>{{ "Exponovaný"|t('bozp') }}</th>
                <th>{{ "Opatrenie / OOPP"|t('bozp') }}</th>
                <th>{{ "Kontrola počas činnosti"|t('bozp') }}</th>
            </tr>
        </thead>
        <tbody>
            {% set controlLabels = {
                'used':     'Použité',
                'not_used': 'Nepoužité',
                'other':    'Iné',
            } %}
            {% for cat in hazardCategories %}
                {% set row = hazards[cat.value] ?? null %}
                {% if row %}
                <tr>
                    <td><img src="https://testing.takeitsro.sk/assets/icons/PPE{{ loop.index }}.png" alt="Icon" width="40"></td>
                    <td><strong>{{ cat.label() }}</strong></td>
                    <td>{{ _self.yn(row.exposed) }}</td>
                    <td>{{ row.measure ? row.measure|nl2br : '—' }}</td>
                    <td>
                        {{- controlLabels[row.controlDuringActivity] ?? (row.controlDuringActivity ?: '—') -}}
                        {%- if row.controlDuringActivityOther %} — {{ row.controlDuringActivityOther }}{% endif %}
                    </td>
                </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<br>
