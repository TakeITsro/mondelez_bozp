{# ── Preparation checks ──────────────────────────────────────────────────── #}
<div class="section">
    <h2>{{ "Príprava pracoviska"|t('bozp') }}</h2>
    <table class="dl-table">
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Konštrukčné/procesné podmienky vhodné pre prácu:"|t('bozp') }}</td>
                        <td class="value tall">{{ _self.yn(permit.conditionsSuitable) }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Použité náradie/pracovné prostriedky sú v dobrom technickom stave:"|t('bozp') }}</td>
                        <td class="value tall">{{ _self.yn(permit.toolsInGoodCondition) }}</td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Sú obmedzenia/situácie, kedy musí byť práca zastavená:"|t('bozp') }}</td>
                        <td class="value tall">{{ _self.yn(permit.hasStopConditions) }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Popis podmienok zastavenia:"|t('bozp') }}</td>
                        <td class="value tall">{{ permit.stopConditionsDescription|nl2br ?: "-" }}</td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Zavedený plán izolácie, LOTO prediskutovaný, implementovaný a overený (vyskúšaný):"|t('bozp') }}</td>
                        <td class="value tall">{{ _self.yn(permit.conditionsSuitable) }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Vyžadujú sa dodatočné vysokorizikové povolenie.:"|t('bozp') }}</td>
                        <td class="value tall">
                            {# Decode requiresHighRisk JSON into a list of subpermit-type values
                               and render their human labels via the SubpermitType enum.
                               Twig restricts `is X` tests on attribute accessors in some
                               setups — copy into a local simple var first. #}
                            {% set rawReq = permit.requiresHighRisk %}
                            {% set reqList = [] %}
                            {% if rawReq is iterable %}
                                {% set reqList = rawReq %}
                            {% elseif rawReq %}
                                {% set decoded = rawReq|json_decode %}
                                {% if decoded is iterable %}
                                    {% set reqList = decoded %}
                                {% endif %}
                            {% endif %}

                            {% if reqList|length > 0 %}
                                {% set reqLabels = [] %}
                                {% for t in subpermitTypes %}
                                    {% if t.value in reqList %}
                                        {% set reqLabels = reqLabels|merge([t.label()]) %}
                                    {% endif %}
                                {% endfor %}
                                {{ reqLabels|join(', ') }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="label tall">{{ "Plán riadenia núdzových situácií pre každý pracovný krok/činnosť:"|t('bozp') }}</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="data-table">
                    <tr>
                        <td class="value tall">{{ permit.emergencyPlan|nl2br ?: "-" }}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<br>

{# ── Document header ────────────────────────────────────────────────────── #}
