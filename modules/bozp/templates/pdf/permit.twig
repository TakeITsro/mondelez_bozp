{# ── Subpermits ──────────────────────────────────────────────────────────── #}
{% if subpermits|length > 0 %}
<div class="section">
    <h2>Subpermity zvýšeného rizika</h2>
    {% set spLabelMap = {} %}
    {% set spAppendixMap = {} %}
    {% for t in subpermitTypes %}
        {% set spLabelMap = spLabelMap|merge({(t.value): t.label()}) %}
        {% set spAppendixMap = spAppendixMap|merge({(t.value): t.appendixNumber()}) %}
    {% endfor %}
    {% set spStatusLabels = {
        'pending':           'Čaká na schválenie',
        'pending_signatures':'Čaká na podpisy',
        'approved':          'Schválené',
        'rejected':          'Zamietnuté',
        'cancelled':         'Zrušené',
    } %}
    <table class="subpermit-table">
        <thead>
            <tr>
                <th style="width:12%">Príloha</th>
                <th style="width:30%">Typ</th>
                <th style="width:18%">Dátum</th>
                <th style="width:20%">Stav</th>
                <th style="width:20%">Platnosť do</th>
            </tr>
        </thead>
        <tbody>
            {% for sp in subpermits %}
            {% set spData = sp.data is string ? sp.data|json_decode : (sp.data ?? {}) %}
            <tr>
                <td>Príloha č. {{ spAppendixMap[sp.type] ?? sp.type }}</td>
                <td>{{ spLabelMap[sp.type] ?? sp.type }}</td>
                <td>{{ spData.date ? spData.date|date('d.m.Y') : sp.dateCreated|date('d.m.Y') }}</td>
                <td>{{ spStatusLabels[sp.status] ?? sp.status }}</td>
                <td>{{ (sp.status == 'approved' and sp.expiresAt) ? sp.expiresAt|date('d.m.Y H:i') : '—' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{# ── Control visits ──────────────────────────────────────────────────────── #}
{% if controls|length > 0 %}
<div class="section">
    <h2>Kontroly prevádzky</h2>
    {% set resultLabels = {
        'ok':      'V poriadku',
        'issues':  'Zistené nedostatky',
        'stopped': 'Práce zastavené',
    } %}
    <table class="control-table">
        <thead>
            <tr>
                <th style="width:20%">Dátum a čas</th>
                <th style="width:25%">Kontrolór</th>
                <th style="width:18%">Výsledok</th>
                <th style="width:22%">Poznámky</th>
                <th style="width:15%">Podpis</th>
            </tr>
        </thead>
        <tbody>
            {% for c in controls %}
            <tr>
                <td>{{ c.controlledAt|date('d.m.Y H:i') }}</td>
                <td>{{ c.controllerName }}</td>
                <td>{{ resultLabels[c.result] ?? c.result }}</td>
                <td>{{ c.notes ?: '—' }}</td>
                <td>
                    {% if controlSigImages[c.id] is defined and controlSigImages[c.id] %}
                        <img src="{{ controlSigImages[c.id] }}" style="max-width:80pt;max-height:30pt;">
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{# ── Signatures ──────────────────────────────────────────────────────────── #}
{# General permit closure flow has exactly three signatures, captured in
   strict order: contractor closure → issuer closure → HSE final close.
   No issuance-time signatures appear on the printed permit. #}
<div class="section sig-section">
    <h2>{{ "Podpisy pri uzavretí"|t('bozp') }}</h2>
    <table class="signature-table">
        <tr>
            {# 1. Contractor (recipient) closure #}
            <td>
                <div class="sig-label">1. Dodávateľ — dokončenie prác (Recipient Closure)</div>
                {% set rcSig = signatures['recipient_closure'] ?? null %}
                {% if rcSig %}
                    {% if sigImages['recipient_closure'] is defined and sigImages['recipient_closure'] %}
                        <img src="{{ sigImages['recipient_closure'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ rcSig.signerName }}</strong>
                        {% if rcSig.signerEmployer %} / {{ rcSig.signerEmployer }}{% endif %}
                        {% if rcSig.signatureDate %} · {{ rcSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">Dodávateľ — dokončenie</div>
                {% endif %}
            </td>

            {# 2. Issuer closure #}
            <td>
                <div class="sig-label">2. Vydavateľ — uzavretie (Issuer Closure)</div>
                {% set icSig = signatures['issuer_closure'] ?? null %}
                {% if icSig %}
                    {% if sigImages['issuer_closure'] is defined and sigImages['issuer_closure'] %}
                        <img src="{{ sigImages['issuer_closure'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ icSig.signerName }}</strong>
                        {% if icSig.signatureDate %} · {{ icSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">{{ issuer ? (issuer.fullName ?: issuer.username) : 'Vydavateľ — uzavretie' }}</div>
                {% endif %}
            </td>

            {# 3. HSE final close #}
            <td>
                <div class="sig-label">3. HSE officer — záverečné uzavretie (HSE Closure)</div>
                {% set hseSig = signatures['hse_closure'] ?? null %}
                {% if hseSig %}
                    {% if sigImages['hse_closure'] is defined and sigImages['hse_closure'] %}
                        <img src="{{ sigImages['hse_closure'] }}" class="sig-image">
                    {% else %}
                        <div class="sig-line"></div>
                    {% endif %}
                    <div class="sig-meta">
                        <strong>{{ hseSig.signerName }}</strong>
                        {% if hseSig.signatureDate %} · {{ hseSig.signatureDate|date('d.m.Y') }}{% endif %}
                    </div>
                {% else %}
                    <div class="sig-line"></div>
                    <div class="sig-meta">HSE officer — záverečné uzavretie</div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

{# ── Closure status flags ────────────────────────────────────────────────── #}
{% set rcStatus = permit.recipientClosureStatus %}
{% if rcStatus is iterable and rcStatus|length > 0 %}
<div class="section">
    <h3>Stav pri uzavretí dodávateľom</h3>
    {% set rcLabels = {
        'work_completed':                   'Práce boli dokončené',
        'equipment_operational':            'Zariadenie je prevádzkyschopné',
        'equipment_not_operational':        'Zariadenie nie je prevádzkyschopné',
        'personnel_and_materials_removed':  'Všetky osoby a materiály opustili oblasť',
        'work_suspended':                   'Práce boli pozastavené',
    } %}
    {% for f in rcStatus %}
        <div>✓ {{ rcLabels[f] ?? f }}</div>
    {% endfor %}
</div>
{% endif %}

{# ── Footer ──────────────────────────────────────────────────────────────── #}
<div class="doc-footer">
    <table style="width:100%;border-collapse:collapse;">
        <tr>
            <td>{{ 'Mondelēz Slovensko, s.r.o. — BOZP povolenie na prácu' }}</td>
            <td style="text-align:right;">Číslo: {{ permit.permitNumber }} | Vygenerované: {{ generatedAt }}</td>
        </tr>
    </table>
</div>

</body>
</html>
