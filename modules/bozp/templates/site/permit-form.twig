{% extends 'bozp/site/_layout.twig' %}

{# ---------------------------------------------------------------------------
   Phase 2C.2 permit form — core fields + hazard matrix + preparation checks.

   Posted to: POST /bozp/permits/save
   Two submit intents:
     - intent=save    → stays as draft (relaxed validation)
     - intent=submit  → validates fully, then transitions to `submitted`
                        so it lands in the HSE approval queue.

   Hazard matrix naming:
     hazards[<key>][exposed]      "yes" | "no" | ""
     hazards[<key>][measure]      free text (prefilled with default measure)
     hazards[<key>][control]      "used" | "not_used" | "other" | ""
     hazards[<key>][controlOther] free text

   Preparation naming:
     preparation[conditionsSuitable]        "yes" | "no" | ""
     preparation[toolsInGoodCondition]      "yes" | "no" | ""
     preparation[hasStopConditions]         "yes" | "no" | ""
     preparation[stopConditionsDescription] free text
     preparation[lotoImplemented]           "yes" | "no" | ""
     preparation[emergencyPlan]             free text

   High-risk subpermits:
     requiresHighRisk[]                     SubpermitType values (multi-checkbox)
--------------------------------------------------------------------------- #}

{% set values = values ?? {} %}
{% set errors = errors ?? {} %}
{% set hazardCategories = hazardCategories ?? [] %}
{% set preparation = values.preparation ?? {} %}
{% set hazards = values.hazards ?? {} %}

{% macro field_error(errors, key) %}
    {% if errors[key] is defined %}
        <p class="bozp-form-row__error" id="err-{{ key }}">{{ errors[key] }}</p>
    {% endif %}
{% endmacro %}

{% macro yes_no(name, value) %}
    <div class="bozp-form__yesno">
        <label class="bozp-form__yesno-opt">
            <input type="radio" name="{{ name }}" value="yes" required {% if value == 'yes' %}checked{% endif %}>
            <div class="custom_radio"></div>
            <span>{{ 'Áno'|t('bozp') }}</span>
        </label>
        <label class="bozp-form__yesno-opt">
            <input type="radio" name="{{ name }}" value="no" required {% if value == 'no' %}checked{% endif %}>
            <div class="custom_radio"></div>
            <span>{{ 'Nie'|t('bozp') }}</span>
        </label>
    </div>
{% endmacro %}

{# Styled file picker — paperclip trigger + hidden input. No CTA button.
   Variables:
     name        input name (e.g. 'riskAssessment')
     id          input id   (same as name unless conflict)
     label       row label  (left side)
     required    bool       (renders the * marker + HTML required attr)
     hint        helper text (right side, above the trigger)
     accept      file types (passed straight to the input)
     errorMsg    null|string — pre-resolved error to show inline #}
{% macro file_picker(name, id, label, required, hint, accept, errorMsg) %}
    <div class="bozp-form-row bozp-form-row--file{% if errorMsg %} bozp-form-row--error{% endif %}">
{#        <span class="bozp-form-row__label">#}
{#            {{ label }}#}
{#            {% if required %}<span class="bozp-form-row__req">*</span>{% endif %}#}
{#        </span>#}
        <span class="bozp-form__file-selected" data-file-empty-label="{{ 'Žiadne prílohy.'|t('bozp') }}">{{ 'Žiadne prílohy.'|t('bozp') }}</span>

        <div class="bozp-form__file">
            <span class="bozp-form__file-hint">{{ hint }}</span>
            <label class="bozp-form__file-trigger" for="{{ id }}">
                <svg class="bozp-form__file-icon" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 26">
                    <path fill="#4F2170" transform="translate(0.535156 0.760986)" d="M18.249035 8.4962654C19.109362 7.6256075 19.779554 6.800283 20.131506 5.6922946C20.612911 4.1749768 19.861811 2.258997 18.204536 1.8790008C17.039454 1.612337 15.754358 2.2523303 14.814472 2.8909903C13.053366 4.0896444 11.385303 5.2882986 9.8723154 6.7856164L2.6256166 13.950875C1.255567 16.10952 1.4982923 19.02549 3.2553539 20.838804C4.5310102 22.290789 6.2678447 22.466787 7.9439979 21.632128C9.9356937 20.640139 11.760179 19.453484 13.432286 17.9415L19.860462 12.130894C20.228596 11.796231 20.941938 11.688232 21.248041 11.90423C22.475153 12.773554 20.41873 14.412204 19.02306 15.672191L15.661314 18.706825C12.972457 21.136133 7.9332099 24.966761 4.6092215 23.776106C1.1746585 22.546785 -0.53520638 19.030823 0.14846988 15.537525C0.33321083 14.601535 0.5395273 13.597546 1.2636578 12.881553L9.6282415 4.6123056C10.814898 3.4403179 12.163373 2.546994 13.511847 1.604337C15.595239 0.14835219 18.220718 -0.76097167 20.212414 0.86301142C21.977566 2.3029964 22.448183 4.7043047 21.567631 6.8136163C21.095663 7.9469376 20.313549 8.8589277 19.442434 9.7482519L13.774799 15.528192C11.787148 17.556171 8.4092216 20.869471 6.0332103 19.565483C4.6307974 18.796158 4.0698323 16.872177 4.8222804 15.420193C5.5410171 14.032207 6.6993561 13.006885 7.8037562 11.886897C10.624763 9.0242596 13.46465 6.3642874 16.603897 3.8443136C16.852016 3.6443157 17.392756 3.6816487 17.541086 3.89498C17.684025 4.1003108 17.613905 4.5616398 17.417027 4.7736373C16.972031 5.2522988 16.617382 5.777627 16.173735 6.1736226L10.635551 11.122905C9.5554237 12.088228 8.5885687 13.070885 7.5718188 14.114874C7.0728836 14.628201 6.6481142 15.278861 6.2476177 15.898855C5.7958789 16.598848 5.9091506 17.688169 6.7087955 18.141499C7.8361197 18.780159 10.383387 16.417517 11.703543 15.104197L12.60702 14.205539L18.249035 8.4962654Z" fill-rule="evenodd"/>
                </svg>
                <span class="bozp-form__file-trigger-label">{{ 'Vybrať prílohu'|t('bozp') }}</span>
            </label>
            <input type="file"
                   id="{{ id }}"
                   name="{{ name }}"
                   class="bozp-form__file-input"
                   accept="{{ accept }}"
                   {% if required %}required{% endif %}
                   {% if errorMsg %}aria-invalid="true" aria-describedby="err-{{ id }}"{% endif %}>
        </div>
        {% if errorMsg %}
            <p class="bozp-form-row__error" id="err-{{ id }}">{{ errorMsg }}</p>
        {% endif %}
    </div>
{% endmacro %}

{% block title %}{{ 'Nový permit'|t('bozp') }}{% endblock %}

{% block content %}
    <section class="bozp-page bozp-page--permit-form">
        <header class="bozp-page__header">
            <h1>{{ 'Nový permit'|t('bozp') }}</h1>
            <p class="bozp-page__lede">
                {{ 'Vyplňte údaje a odošlite na schválenie HSE, alebo uložte ako koncept a pokračujte neskôr.'|t('bozp') }}
            </p>
        </header>

        <form method="post" action="" class="bozp-form" enctype="multipart/form-data" novalidate>
            {{ csrfInput() }}
            <input type="hidden" name="action" value="bozp/permits/save">

            <fieldset class="bozp-form-section">
                <legend class="bozp-form-section__title">{{ 'Dodávateľ'|t('bozp') }}</legend>

                <div class="bozp-form-row{% if errors.contractorCompany is defined %} bozp-form-row--error{% endif %}">
                    <label for="contractorCompany">{{ 'Názov dodávateľskej firmy'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <input type="text"
                           id="contractorCompany"
                           name="contractorCompany"
                           value="{{ values.contractorCompany ?? '' }}"
                           maxlength="255"
                           required
                           {% if errors.contractorCompany is defined %}aria-invalid="true" aria-describedby="err-contractorCompany"{% endif %}>
                    {{ _self.field_error(errors, 'contractorCompany') }}
                </div>

                <div class="bozp-form-row{% if errors.contractorPersonName is defined %} bozp-form-row--error{% endif %}">
                    <label for="contractorPersonName">{{ 'Kontaktná osoba'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <input type="text"
                           id="contractorPersonName"
                           name="contractorPersonName"
                           value="{{ values.contractorPersonName ?? '' }}"
                           maxlength="255"
                           required
                           {% if errors.contractorPersonName is defined %}aria-invalid="true" aria-describedby="err-contractorPersonName"{% endif %}>
                    {{ _self.field_error(errors, 'contractorPersonName') }}
                </div>

                <div class="bozp-form-row{% if errors.contractorEmail is defined %} bozp-form-row--error{% endif %}">
                    <label for="contractorEmail">{{ 'E-mail'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <input type="email"
                           id="contractorEmail"
                           name="contractorEmail"
                           value="{{ values.contractorEmail ?? '' }}"
                           maxlength="255"
                           required
                           {% if errors.contractorEmail is defined %}aria-invalid="true" aria-describedby="err-contractorEmail"{% endif %}>
                    {{ _self.field_error(errors, 'contractorEmail') }}
                </div>
            </fieldset>

            {% if (zones ?? [])|length > 0 %}
                <fieldset class="bozp-form-section">
                    <legend class="bozp-form-section__title">{{ 'Zóna'|t('bozp') }}</legend>
                    <p class="bozp-form-section__hint">{{ 'Vyberte zónu, v ktorej sa práca vykonáva.'|t('bozp') }}</p>

                    <div class="bozp-form-row{% if errors.zoneId is defined %} bozp-form-row--error{% endif %}">
                        <label for="zoneId">{{ 'Zóna'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <select name="zoneId" id="zoneId" required
                                {% if errors.zoneId is defined %}aria-invalid="true" aria-describedby="err-zoneId"{% endif %}>
                            <option value="">{{ '— Vyberte zónu —'|t('bozp') }}</option>
                            {% for zone in (zones ?? []) %}
                                <option value="{{ zone.id }}"
                                        {% if (values.zoneId ?? null) == zone.id %}selected{% endif %}>
                                    {{ zone.name }}{% if zone.code %} ({{ zone.code }}){% endif %}
                                </option>
                            {% endfor %}
                        </select>
                        {{ _self.field_error(errors, 'zoneId') }}
                    </div>
                </fieldset>
            {% endif %}

            <fieldset class="bozp-form-section">
                <legend class="bozp-form-section__title">{{ 'Práca'|t('bozp') }}</legend>

                <div class="bozp-form-row{% if errors.workLocation is defined %} bozp-form-row--error{% endif %}">
                    <label for="workLocation">{{ 'Miesto výkonu'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <input type="text"
                           id="workLocation"
                           name="workLocation"
                           value="{{ values.workLocation ?? '' }}"
                           maxlength="500"
                           required
                           {% if errors.workLocation is defined %}aria-invalid="true" aria-describedby="err-workLocation"{% endif %}>
                    {{ _self.field_error(errors, 'workLocation') }}
                </div>

                <div class="bozp-form-row{% if errors.workOverview is defined %} bozp-form-row--error{% endif %}">
                    <label for="workOverview">{{ 'Popis prác'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <textarea id="workOverview"
                              name="workOverview"
                              rows="5"
                              required
                              {% if errors.workOverview is defined %}aria-invalid="true" aria-describedby="err-workOverview"{% endif %}>{{ values.workOverview ?? '' }}</textarea>
                    {{ _self.field_error(errors, 'workOverview') }}
                </div>

                <div class="bozp-form-row{% if errors.validFrom is defined %} bozp-form-row--error{% endif %}">
                    <label for="validFrom">{{ 'Platnosť od'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                    <input type="date"
                           id="validFrom"
                           name="validFrom"
                           value="{{ values.validFrom ?? '' }}"
                           required
                           {% if errors.validFrom is defined %}aria-invalid="true" aria-describedby="err-validFrom"{% endif %}>
                    <p class="bozp-form-section__hint">
                        {{ 'Platnosť permitu je 7 dní od dátumu schválenia HSE.'|t('bozp') }}
                    </p>
                    {{ _self.field_error(errors, 'validFrom') }}
                </div>
            </fieldset>

            {# ----- Risk assessment attachment ----- #}
            <fieldset class="bozp-form-section">
                <legend class="bozp-form-section__title">{{ 'Hodnotenie rizík'|t('bozp') }}</legend>
                <p class="bozp-form-section__hint">
                    {{ 'Pripojte dokument s hodnotením rizík. Pri odoslaní na schválenie je príloha povinná.'|t('bozp') }}
                </p>
                {{ _self.file_picker(
                    'riskAssessment',
                    'riskAssessment',
                    'Súbor hodnotenia rizík'|t('bozp'),
                    true,
                    'Nahrať prílohu (PDF, DOCX, XLSX, max 10 MB)'|t('bozp'),
                    '.pdf,.docx,.xlsx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                    errors.riskAssessment ?? null
                ) }}
            </fieldset>

            {# ----- Hazard matrix ----- #}
            {% if hazardCategories|length > 0 %}
                <fieldset class="bozp-form-section bozp-form-section--hazards">
                    <legend class="bozp-form-section__title">{{ 'Riziká a OOPP'|t('bozp') }}</legend>
                    <p class="bozp-form-section__hint">
                        {{ 'Pri každom riziku vyznačte, či je pracovník exponovaný, uveďte ochranné opatrenie a spôsob kontroly počas činnosti.'|t('bozp') }}
                    </p>

                    <div class="bozp-form__hazards">
                        <table class="bozp-hazards">
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'Riziko'|t('bozp') }}</th>
                                    <th scope="col">{{ 'Exponovaný?'|t('bozp') }}</th>
                                    <th scope="col">{{ 'Opatrenie / OOPP'|t('bozp') }}</th>
                                    <th scope="col">{{ 'Kontrola počas činnosti'|t('bozp') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cat in hazardCategories %}
                                    {% set key = cat.value %}
                                    {% set row = hazards[key] ?? {} %}
                                    {% set exposed = row.exposed ?? '' %}
                                    {% set measure = row.measure ?? cat.defaultMeasure() %}
                                    {% set control = row.control ?? '' %}
                                    {% set controlOther = row.controlOther ?? '' %}
                                    <tr class="bozp-hazards__row">
                                        <th scope="row" class="bozp-hazards__label">
                                            <div class="label_wrapper">
                                                <img src="/assets/icons/PPE{{ loop.index }}.png" alt="Icon">
                                                {{ cat.label()|t('bozp') }}
                                            </div>
                                        </th>
                                        <td class="bozp-hazards__exposed">
                                            {{ _self.yes_no('hazards[' ~ key ~ '][exposed]', exposed) }}
                                        </td>
                                        <td class="bozp-hazards__measure">
                                            <textarea name="hazards[{{ key }}][measure]"
                                                      aria-label="{{ cat.label()|t('bozp') }} — {{ 'Opatrenie / OOPP'|t('bozp') }}">{{ measure }}</textarea>
                                        </td>
                                        <td class="bozp-hazards__control">
                                            <select name="hazards[{{ key }}][control]"
                                                    aria-label="{{ cat.label()|t('bozp') }} — {{ 'Kontrola počas činnosti'|t('bozp') }}">
                                                <option value="" {% if control == '' %}selected{% endif %}>—</option>
                                                <option value="used" {% if control == 'used' %}selected{% endif %}>
                                                    {{ 'Použité'|t('bozp') }}
                                                </option>
                                                <option value="not_used" {% if control == 'not_used' %}selected{% endif %}>
                                                    {{ 'Nepoužité'|t('bozp') }}
                                                </option>
                                                <option value="other" {% if control == 'other' %}selected{% endif %}>
                                                    {{ 'Iné'|t('bozp') }}
                                                </option>
                                            </select>
                                            <input type="text"
                                                   name="hazards[{{ key }}][controlOther]"
                                                   value="{{ controlOther }}"
                                                   maxlength="255"
                                                   class="bozp-hazards__control-other"
                                                   placeholder="{{ 'Iné — upresnite'|t('bozp') }}"
                                                   aria-label="{{ cat.label()|t('bozp') }} — {{ 'Iné — upresnite'|t('bozp') }}">
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            {% endif %}

            {# ----- Preparation checks ----- #}
            <fieldset class="bozp-form-section bozp-form-section--prep">
                <legend class="bozp-form-section__title">{{ 'Príprava pracoviska'|t('bozp') }}</legend>
                <p class="bozp-form-section__hint">
                    {{ 'Potvrďte stav pracoviska a vybavenia pred začiatkom prác.'|t('bozp') }}
                </p>

                <div class="bozp-form-row">
                    <span class="bozp-form-row__label">{{ 'Sú pracovné podmienky vhodné na vykonávanie prác?'|t('bozp') }}</span>
                    {{ _self.yes_no('preparation[conditionsSuitable]', preparation.conditionsSuitable ?? '') }}
                </div>

                <div class="bozp-form-row">
                    <span class="bozp-form-row__label">{{ 'Je náradie a vybavenie v dobrom technickom stave?'|t('bozp') }}</span>
                    {{ _self.yes_no('preparation[toolsInGoodCondition]', preparation.toolsInGoodCondition ?? '') }}
                </div>

                <div class="bozp-form-row">
                    <span class="bozp-form-row__label">{{ 'Existujú podmienky, pri ktorých je nutné práce zastaviť?'|t('bozp') }}</span>
                    {{ _self.yes_no('preparation[hasStopConditions]', preparation.hasStopConditions ?? '') }}
                </div>

                <div class="bozp-form-row">
                    <label for="stopConditionsDescription">
                        {{ 'Popis podmienok pre zastavenie prác'|t('bozp') }}
                    </label>
                    <textarea id="stopConditionsDescription"
                              name="preparation[stopConditionsDescription]"
                              rows="3">{{ preparation.stopConditionsDescription ?? '' }}</textarea>
                </div>

                <div class="bozp-form-row">
                    <span class="bozp-form-row__label">{{ 'Je zavedený LOTO (uzamknutie / označenie)?'|t('bozp') }}</span>
                    {{ _self.yes_no('preparation[lotoImplemented]', preparation.lotoImplemented ?? '') }}
                </div>

                <div class="bozp-form-row">
                    <label for="emergencyPlan">
                        {{ 'Núdzový plán / postup v prípade mimoriadnej udalosti'|t('bozp') }}
                    </label>
                    <textarea id="emergencyPlan"
                              name="preparation[emergencyPlan]"
                              rows="3">{{ preparation.emergencyPlan ?? '' }}</textarea>
                </div>
            </fieldset>

            {# ----- High-risk subpermits ----- #}
            <fieldset class="bozp-form-section bozp-form-section--highrisk">
                <legend class="bozp-form-section__title">{{ 'Subpermity zvýšeného rizika'|t('bozp') }}</legend>
                <p class="bozp-form-section__hint">
                    {{ 'Označte typy subpermitov, ktoré budú potrebné pre tento permit. Subpermity sa vytvárajú a schvaľujú samostatne po vytvorení permitu.'|t('bozp') }}
                </p>

                <div class="bozp-form__highrisk-types">
                    {% for type in (subpermitTypes ?? []) %}
                        <label class="bozp-form__highrisk-opt">
                            <input type="checkbox"
                                   name="requiresHighRisk[]"
                                   value="{{ type.value }}"
                                   {% if type.value in (values.requiresHighRisk ?? []) %}checked{% endif %}>
                            <div class="custom_checkbox"></div>
                            <span>
                                {{ type.label() }}
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            {# ----- Additional optional attachment ----- #}
            <fieldset class="bozp-form-section">
                <legend class="bozp-form-section__title">{{ 'Príloha'|t('bozp') }}</legend>
                <p class="bozp-form-section__hint">
                    {{ 'Voliteľná dodatočná príloha k permitu (napr. plán pracoviska, certifikáty, fotografie).'|t('bozp') }}
                </p>
                {{ _self.file_picker(
                    'additionalAttachment',
                    'additionalAttachment',
                    'Dodatočná príloha'|t('bozp'),
                    false,
                    'Nahrať prílohu (PDF, DOCX, JPG, PNG, max 10 MB)'|t('bozp'),
                    '.pdf,.docx,.jpg,.jpeg,.png,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png',
                    errors.additionalAttachment ?? null
                ) }}
            </fieldset>

            <div class="bozp-form__actions">
                <a href="{{ url('dashboard') }}" class="bozp-btn bozp-btn--cancel">{{ 'Zrušiť'|t('bozp') }}</a>
                <button type="submit" name="intent" value="save" class="bozp-btn bozp-btn--primary">
                    {{ 'Uložiť ako koncept'|t('bozp') }}
                </button>
                <button type="submit" name="intent" value="submit" class="bozp-btn bozp-btn--approve">
                    {{ 'Odoslať na schválenie'|t('bozp') }}
                </button>
            </div>
        </form>

        <script>
        // Display selected filename next to the .bozp-form__file-trigger.
        document.querySelectorAll('.bozp-form__file-input').forEach(function (input) {
            input.addEventListener('change', function () {
                var label = input.parentNode.parentNode.querySelector('.bozp-form__file-selected');
                if (!label) return;
                if (input.files && input.files.length > 0) {
                    label.textContent = input.files[0].name;
                } else {
                    label.textContent = label.getAttribute('data-file-empty-label') || '';
                }
            });
        });
        </script>
    </section>
{% endblock %}
