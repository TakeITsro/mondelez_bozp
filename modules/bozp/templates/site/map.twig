    <style>
        .bozp-page--map { gap: 2.5em; padding: 5em; }
        .bozp-page--map .bozp-page__header { width: 100%; max-width: 1100px; }
        .bozp-page--map .bozp-page__subtitle { color: var(--main-color); font-size: 1.1em; margin-top: .5em; }

        .bozp-map {
            position: relative;
            width: 100%;
            max-width: 1100px;
            aspect-ratio: 1000 / 600;
            background: #FEFFFD;
            border: 2px solid var(--main-color);
            border-radius: 8px;
            overflow: hidden;
        }
        .bozp-map__svg { display: block; width: 100%; height: 100%; }

        /* ── Default layout: zones are auto-arranged in a grid over the map.
           To pin a zone over a specific spot of the SVG, override its
           individual .bozp-map__zone--<slug> rule in the per-zone block at
           the bottom (set position: absolute + top/left/width/height). */
        .bozp-map__zones {
            position: absolute;
            inset: 1%;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-auto-rows: 1fr;
            gap: 1%;
            pointer-events: none; /* container is transparent; zones re-enable */
        }

        .bozp-map__zone {
            position: relative;
            pointer-events: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: .35em;
            padding: .5em;
            background: rgba(79, 33, 112, 0.12);
            border: 2px solid var(--main-color);
            border-radius: 6px;
            color: var(--main-color);
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: background-color .15s ease, transform .15s ease;
            overflow: hidden;
        }
        .bozp-map__zone:hover {
            background: rgba(79, 33, 112, 0.22);
            transform: scale(1.02);
            z-index: 2;
        }
        .bozp-map__zone--has-active {
            background: rgba(79, 33, 112, 0.28);
            border-color: var(--main-color-dark);
        }
        .bozp-map__zone--has-active:hover {
            background: rgba(79, 33, 112, 0.42);
        }
        .bozp-map__zone-name {
            font-size: .9em;
            font-weight: 600;
            text-transform: uppercase;
            line-height: 1.1;
        }
        .bozp-map__zone-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.8em;
            height: 1.8em;
            padding: 0 .4em;
            background: var(--main-color);
            color: var(--main-color-light);
            border-radius: 999px;
            font-size: 1.1em;
            font-weight: 700;
            line-height: 1;
        }

        .bozp-map__legend {
            display: flex;
            gap: 2em;
            list-style: none;
            padding: 0;
            margin: 0;
            color: var(--main-color);
            font-size: .95em;
        }
        .bozp-map__legend li { display: flex; align-items: center; gap: .5em; }
        .bozp-map__legend-dot {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid var(--main-color);
            background: rgba(79, 33, 112, 0.12);
            border-radius: 3px;
        }
        .bozp-map__legend-dot--active {
            background: rgba(79, 33, 112, 0.42);
            border-color: var(--main-color-dark);
        }

        /* ──────────────────────────────────────────────────────────────────
           PER-ZONE POSITIONING

           When you're ready to pin a zone over a specific area of the SVG,
           set position: absolute on it (which removes it from the grid) and
           give it explicit top/left/width/height in percentages of .bozp-map.
           Example:

               .bozp-map__zone--courtyard {
                   position: absolute;
                   top: 4%; left: 4%; width: 18%; height: 22%;
               }

           All 19 zones below start commented out — uncomment and tweak each. */

