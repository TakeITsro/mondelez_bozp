            {# ── Zone overlays. Each zone has its own slug-based class
               (e.g. .bozp-map__zone--courtyard) so you can pin it to the
               correct spot over the SVG via the CSS block at the bottom. #}
{#            <div class="bozp-map__zones">#}
{#                {% for zone in zones %}#}
{#                    {% set count = counts[zone.id] ?? 0 %}#}
{#                    {% set slug = zone.code ?: ('zone-' ~ zone.id) %}#}
{#                    <a class="bozp-map__zone bozp-map__zone--{{ slug }} {% if count > 0 %}bozp-map__zone--has-active{% endif %}"#}
{#                       href="{{ url('bozp/map/zone/' ~ zone.id) }}"#}
{#                       data-zone-id="{{ zone.id }}"#}
{#                       data-zone-slug="{{ slug }}">#}
{#                        <span class="bozp-map__zone-name">{{ zone.name }}</span>#}
{#                        <span class="bozp-map__zone-count" aria-label="{{ 'Aktívne permity'|t('bozp') }}">#}
{#                            {{ count }}#}
{#                        </span>#}
{#                    </a>#}
{#                {% endfor %}#}
{#            </div>#}
