{# Styled file picker — paperclip trigger + hidden input + selected-file label.
   Standalone include (does not touch permit-detail.twig, which keeps its own
   local macro). Reproduces the same markup + classes so shared CSS applies.

   Include with only {…}:
     name        input name attribute
     id          input id (must be unique on the page)
     required    bool
     hint        hint text shown above the trigger
     accept      accept attribute string
     errorMsg    error message (null when no error)
     emptyLabel  text shown before a file is chosen (default 'Žiadne prílohy.')

   Filename-swap JS lives in _file-picker-js.twig — include it ONCE per page.
#}
{% set emptyLabel = emptyLabel ?? ('Žiadne prílohy.'|t('bozp')) %}

<div class="bozp-form-row bozp-form-row--file{% if errorMsg %} bozp-form-row--error{% endif %}">
    <span class="bozp-form__file-selected" data-file-empty-label="{{ emptyLabel }}">{{ emptyLabel }}</span>

    <div class="bozp-form__file">
        <span class="bozp-form__file-hint">{{ hint }}</span>
        <label class="bozp-form__file-trigger" for="{{ id }}">
            <svg class="bozp-form__file-icon" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 26">
                <path fill="#4F2170" transform="translate(0.535156 0.760986)" d="M18.249035 8.4962654C19.109362 7.6256075 19.779554 6.800283 20.131506 5.6922946C20.612911 4.1749768 19.861811 2.258997 18.204536 1.8790008C17.039454 1.612337 15.754358 2.2523303 14.814472 2.8909903C13.053366 4.0896444 11.385303 5.2882986 9.8723154 6.7856164L2.6256166 13.950875C1.255567 16.10952 1.4982923 19.02549 3.2553539 20.838804C4.5310102 22.290789 6.2678447 22.466787 7.9439979 21.632128C9.9356937 20.640139 11.760179 19.453484 13.432286 17.9415L19.860462 12.130894C20.228596 11.796231 20.941938 11.688232 21.248041 11.90423C22.475153 12.773554 20.41873 14.412204 19.02306 15.672191L15.661314 18.706825C12.972457 21.136133 7.9332099 24.966761 4.6092215 23.776106C1.1746585 22.546785 -0.53520638 19.030823 0.14846988 15.537525C0.33321083 14.601535 0.5395273 13.597546 1.2636578 12.881553L9.6282415 4.6123056C10.814898 3.4403179 12.163373 2.546994 13.511847 1.604337C15.595239 0.14835219 18.220718 -0.76097167 20.212414 0.86301142C21.977566 2.3029964 22.448183 4.7043047 21.567631 6.8136163C21.095663 7.9469376 20.313549 8.8589277 19.442434 9.7482519L13.774799 15.528192C11.787148 17.556171 8.4092216 20.869471 6.0332103 19.565483C4.6307974 18.796158 4.0698323 16.872177 4.8222804 15.420193C5.5410171 14.032207 6.6993561 13.006885 7.8037562 11.886897C10.624763 9.0242596 13.46465 6.3642874 16.603897 3.8443136C16.852016 3.6443157 17.392756 3.6816487 17.541086 3.89498C17.684025 4.1003108 17.613905 4.5616398 17.417027 4.7736373C16.972031 5.2522988 16.617382 5.777627 16.173735 6.1736226L10.635551 11.122905C9.5554237 12.088228 8.5885687 13.070885 7.5718188 14.114874C7.0728836 14.628201 6.6481142 15.278861 6.2476177 15.898855C5.7958789 16.598848 5.9091506 17.688169 6.7087955 18.141499C7.8361197 18.780159 10.383387 16.417517 11.703543 15.104197L12.60702 14.205539L18.249035 8.4962654Z" fill-rule="evenodd"/>
            </svg>
            <span class="bozp-form__file-trigger-label">{{ 'Vybrať prílohu'|t('bozp') }}</span>
        </label>
        <input type="file"
               id="{{ id }}"
               name="{{ name }}"
               class="bozp-form__file-input"
               accept="{{ accept }}"
               {% if required %}required{% endif %}
               {% if errorMsg %}aria-invalid="true" aria-describedby="err-{{ id }}"{% endif %}>
    </div>
    {% if errorMsg %}
        <p class="bozp-form-row__error" id="err-{{ id }}">{{ errorMsg }}</p>
    {% endif %}
</div>
