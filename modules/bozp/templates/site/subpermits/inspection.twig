{% extends 'bozp/site/_layout.twig' %}

{# Daily equipment safety condition inspection (Príloha č. 10, page 2).
   Variables: permit, subpermit, inspections, next, checklist, groupLabels, errors

   Markup mirrors contractor/control.twig. The signature dialog deliberately
   reuses the id #bozp-ctrl-sign-dialog: _modal.scss styles its dialogs through
   an id allow-list, so a new id would render unstyled. #}

{% block title %}{{ 'Kontrola bezpečnostného stavu zariadení'|t('bozp') }} — {{ permit.permitNumber }}{% endblock %}

{% block content %}
<section class="bozp-page bozp-page--control">

    <header class="bozp-page__header">
        <p class="bozp-page__back">
            <a href="{{ url('permits/' ~ permit.id ~ '/subpermits/' ~ subpermit.id) }}">
                ← {{ 'Späť na subpermit'|t('bozp') }}
            </a>
        </p>
        <h1>{{ 'Kontrola bezpečnostného stavu zariadení'|t('bozp') }}</h1>
        <p class="bozp-page__lede">
            {{ 'Permit'|t('bozp') }}: <strong>{{ permit.permitNumber }}</strong>
            · {{ permit.workLocation ?: '—' }}
        </p>
    </header>

    {# ---- Form for the next outstanding inspection ---- #}
    {% if next %}
        <form method="post" action="" id="bozp-insp-form" class="bozp-form" novalidate>
            {{ csrfInput() }}
            <input type="hidden" name="action" value="bozp/subpermits/save-inspection">
            <input type="hidden" name="permitId" value="{{ permit.id }}">
            <input type="hidden" name="id" value="{{ subpermit.id }}">
            <input type="hidden" name="inspectionId" value="{{ next.id }}">

            {# Hidden signature fields — populated by dialog JS before submit #}
            <input type="hidden" name="performerName" id="bozp-insp-sig-name">
            <input type="hidden" name="signatureData" id="bozp-insp-sig-data">

            <fieldset class="bozp-form-section">
                <legend>{{ 'Kontrola za deň {d}'|t('bozp', {d: next.dueDate|date('d.m.Y')}) }}</legend>
                <p class="bozp-form-section__hint">
                    {{ 'Štandard PS4 MG a LOTO · Zákon č. 124/2006 Zb. · Frekvencia: každý deň po dokončení práce'|t('bozp') }}
                </p>
            </fieldset>

            {% for groupKey, items in checklist %}
                <fieldset class="bozp-form-section">
                    <legend>{{ (groupLabels[groupKey] ?? groupKey)|t('bozp') }}</legend>

                    {% for key, label in items %}
                        <div class="bozp-form-row">
                            <span class="bozp-form-row__label">{{ label|t('bozp') }}</span>
                            <div class="bozp-form__yesno">
                                <label class="bozp-form__yesno-opt">
                                    <input type="radio" name="items[{{ key }}]" value="ok" required>
                                    <div class="custom_radio"></div>
                                    <span>{{ 'Áno'|t('bozp') }}</span>
                                </label>
                                <label class="bozp-form__yesno-opt">
                                    <input type="radio" name="items[{{ key }}]" value="nok">
                                    <div class="custom_radio"></div>
                                    <span>{{ 'Nie'|t('bozp') }}</span>
                                </label>
                                <label class="bozp-form__yesno-opt">
                                    <input type="radio" name="items[{{ key }}]" value="na">
                                    <div class="custom_radio"></div>
                                    <span>{{ 'Neaplikovateľné'|t('bozp') }}</span>
                                </label>
                            </div>
                        </div>
                    {% endfor %}
                </fieldset>
            {% endfor %}

            <fieldset class="bozp-form-section">
                <legend>{{ 'Výsledok kontroly'|t('bozp') }}</legend>

                <div class="bozp-form-row">
                    <span class="bozp-form-row__label">
                        {{ 'Stav'|t('bozp') }} <span class="bozp-form__req">*</span>
                    </span>
                    <div class="bozp-form__yesno">
                        <label class="bozp-form__yesno-opt">
                            <input type="radio" name="status" value="ok" required>
                            <div class="custom_radio"></div>
                            <span>{{ 'Bez závad'|t('bozp') }}</span>
                        </label>
                        <label class="bozp-form__yesno-opt">
                            <input type="radio" name="status" value="issue">
                            <div class="custom_radio"></div>
                            <span>{{ 'Zistená závada'|t('bozp') }}</span>
                        </label>
                    </div>
                </div>

                <div class="bozp-form-row">
                    <label for="notes">
                        {{ 'Pred odchodom z pracoviska nahláste akékoľvek nedostatky'|t('bozp') }}
                    </label>
                    <textarea id="notes" name="notes" rows="4" maxlength="2000"></textarea>
                </div>
            </fieldset>

            <div class="bozp-form__actions">
                <a href="{{ url('permits/' ~ permit.id ~ '/subpermits/' ~ subpermit.id) }}"
                   class="bozp-btn bozp-btn--cancel">
                    {{ 'Zrušiť'|t('bozp') }}
                </a>
                <button type="button" class="bozp-btn bozp-btn--primary" id="bozp-insp-open-sign">
                    {{ 'Podpísať a uložiť kontrolu'|t('bozp') }}
                </button>
            </div>
        </form>
    {% else %}
        <p class="bozp-empty">{{ 'Momentálne nie je potrebná žiadna kontrola.'|t('bozp') }}</p>
    {% endif %}

    {# ---- Record of previous inspections ---- #}
    {% if inspections|length > 0 %}
        <section class="bozp-detail-section" style="margin-top:40px;">
            <h2>{{ 'Vykonané kontroly'|t('bozp') }}</h2>
            <table class="bozp-table" style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr>
                        <th style="text-align:left;padding:8px 10px;border-bottom:2px solid #e3e5e8;">{{ 'Dátum'|t('bozp') }}</th>
                        <th style="text-align:left;padding:8px 10px;border-bottom:2px solid #e3e5e8;">{{ 'Výsledok'|t('bozp') }}</th>
                        <th style="text-align:left;padding:8px 10px;border-bottom:2px solid #e3e5e8;">{{ 'Vykonal'|t('bozp') }}</th>
                        <th style="text-align:left;padding:8px 10px;border-bottom:2px solid #e3e5e8;">{{ 'Poznámka'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for i in inspections %}
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:8px 10px;vertical-align:top;">{{ i.dueDate|date('d.m.Y') }}</td>
                            <td style="padding:8px 10px;vertical-align:top;">
                                {% if i.performedAt %}
                                    {% set resultCss = {'ok': '#16a34a', 'issue': '#dc2626'} %}
                                    <span style="display:inline-block;padding:2px 8px;border-radius:10px;background:{{ resultCss[i.status] ?? '#6b7280' }};color:#fff;font-size:.8em;font-weight:600;">
                                        {{ i.status == 'issue' ? 'Zistená závada'|t('bozp') : 'Bez závad'|t('bozp') }}
                                    </span>
                                {% else %}
                                    <span style="display:inline-block;padding:2px 8px;border-radius:10px;background:#6b7280;color:#fff;font-size:.8em;font-weight:600;">
                                        {{ 'Čaká'|t('bozp') }}
                                    </span>
                                {% endif %}
                            </td>
                            <td style="padding:8px 10px;vertical-align:top;">
                                {% if i.performedAt %}
                                    {{ i.performerName }}<br>
                                    <span style="font-size:.85em;color:#555;">{{ i.performedAt|date('d.m.Y H:i') }}</span>
                                {% else %}
                                    <span style="color:#999;font-size:.85em;">—</span>
                                {% endif %}
                            </td>
                            <td style="padding:8px 10px;vertical-align:top;">
                                {% if i.notes %}
                                    <p style="margin:4px 0 0;font-size:.85em;color:#555;">{{ i.notes }}</p>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endif %}

    {# ---- Signature dialog ---- #}
    {% if next %}
        <dialog id="bozp-ctrl-sign-dialog"
                style="border:none;padding:0;border-radius:8px;max-width:560px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,.25);">
            <div class="bozp-form bozp-form--sign" style="margin:0;padding:24px;">
                <h3 style="margin-top:0;">{{ 'Podpis technika'|t('bozp') }}</h3>
                <p>{{ 'Podpisom potvrdzujete, že ste kontrolu zariadení vykonali osobne.'|t('bozp') }}</p>

                <div class="bozp-form__field">
                    <label>{{ 'Meno technika'|t('bozp') }} <span class="bozp-form__req">*</span></label>
                    <input type="text" id="bozp-insp-dlg-name" maxlength="255" required
                           value="{{ currentUser ? (currentUser.fullName ?: currentUser.friendlyName ?: currentUser.username) : '' }}">
                </div>

                <div class="bozp-form__field">
                    <label>{{ 'Podpis'|t('bozp') }} <span class="bozp-form__req">*</span></label>
                    <div class="bozp-sigpad" style="border:1px solid #ccc;background:#fff;width:100%;">
                        <canvas id="bozp-insp-canvas" data-bozp-sigpad
                                width="520" height="180"
                                style="display:block;width:100%;height:180px;touch-action:none;"></canvas>
                    </div>
                    <div class="bozp-sigpad__actions" style="margin-top:8px;">
                        <button type="button" class="bozp-btn bozp-btn--primary" id="bozp-insp-clear">
                            {{ 'Vyčistiť'|t('bozp') }}
                        </button>
                    </div>
                </div>

                <div class="bozp-dialog__actions" style="display:flex;gap:8px;justify-content:space-between;margin-top:20px;">
                    <button type="button" class="bozp-btn bozp-btn--cancel" id="bozp-insp-cancel">
                        {{ 'Zrušiť'|t('bozp') }}
                    </button>
                    <button type="button" class="bozp-btn bozp-btn--approve" id="bozp-insp-submit">
                        {{ 'Podpísať a uložiť'|t('bozp') }}
                    </button>
                </div>
            </div>
        </dialog>

        <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
        <script>
        (function () {
            var dialog    = document.getElementById('bozp-ctrl-sign-dialog');
            var openBtn   = document.getElementById('bozp-insp-open-sign');
            var mainForm  = document.getElementById('bozp-insp-form');
            var canvas    = document.getElementById('bozp-insp-canvas');
            var clearBtn  = document.getElementById('bozp-insp-clear');
            var cancelBtn = document.getElementById('bozp-insp-cancel');
            var submitBtn = document.getElementById('bozp-insp-submit');
            var pad       = null;

            function initPad() {
                if (!window.SignaturePad || !canvas || pad) return;
                var ratio = Math.max(window.devicePixelRatio || 1, 1);
                canvas.width  = canvas.offsetWidth  * ratio;
                canvas.height = canvas.offsetHeight * ratio;
                canvas.getContext('2d').scale(ratio, ratio);
                pad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)', penColor: '#000' });
            }

            if (openBtn) {
                openBtn.addEventListener('click', function () {
                    // The form carries novalidate, so check the checklist explicitly.
                    if (!mainForm.reportValidity()) return;
                    dialog.showModal ? dialog.showModal() : dialog.setAttribute('open', '');
                    window.requestAnimationFrame(initPad);
                });
            }

            if (cancelBtn) cancelBtn.addEventListener('click', function () { dialog.close(); });
            if (clearBtn)  clearBtn.addEventListener('click',  function () { if (pad) pad.clear(); });

            if (submitBtn) {
                submitBtn.addEventListener('click', function () {
                    var name = document.getElementById('bozp-insp-dlg-name').value.trim();
                    if (!name) { alert('{{ 'Zadajte meno podpisujúceho.'|t('bozp') }}'); return; }
                    if (!pad || pad.isEmpty()) { alert('{{ 'Podpis je povinný.'|t('bozp') }}'); return; }
                    document.getElementById('bozp-insp-sig-name').value = name;
                    document.getElementById('bozp-insp-sig-data').value = pad.toDataURL('image/png');
                    dialog.close();
                    mainForm.submit();
                });
            }
        })();
        </script>
    {% endif %}

</section>
{% endblock %}
