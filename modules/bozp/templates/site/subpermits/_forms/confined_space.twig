{# Appendix 3 — Permission to enter a confined space #}

<fieldset class="bozp-form__section">
    <legend>{{ 'Platnosť a havarijný plán'|t('bozp') }}</legend>

    <div class="bozp-form__row bozp-form__row--2col">
        <div class="bozp-form__field">
            <label for="expiryDate">{{ 'Dátum expirácie'|t('bozp') }}</label>
            <input type="date" id="expiryDate" name="expiryDate"
                   value="{{ values.expiryDate ?? '' }}">
        </div>
        <div class="bozp-form__field">
            <label for="expiryTime">{{ 'Čas expirácie'|t('bozp') }}</label>
            <input type="time" id="expiryTime" name="expiryTime"
                   value="{{ values.expiryTime ?? '' }}">
        </div>
    </div>

    <div class="bozp-form__field">
        <label for="emergencyPlan">{{ 'Opis havarijného / záchranného plánu'|t('bozp') }}</label>
        <textarea id="emergencyPlan" name="emergencyPlan" rows="4">{{ values.emergencyPlan ?? '' }}</textarea>
    </div>

    <div class="bozp-form__field">
        <span class="bozp-form__label">{{ 'Účastníci absolvovali školenie?'|t('bozp') }}</span>
        <div class="bozp-form__yesno">
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="trainingComplete" value="yes" {% if (values.trainingComplete ?? '') == 'yes' %}checked{% endif %}>
                <span>{{ 'Áno'|t('bozp') }}</span>
            </label>
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="trainingComplete" value="no" {% if (values.trainingComplete ?? '') == 'no' %}checked{% endif %}>
                <span>{{ 'Nie'|t('bozp') }}</span>
            </label>
        </div>
    </div>
</fieldset>

<fieldset class="bozp-form__section">
    <legend>{{ 'Izolácia a ventilácia'|t('bozp') }}</legend>

    {% macro yn_row(name, value, label) %}
        <div class="bozp-form__field">
            <span class="bozp-form__label">{{ label }}</span>
            <div class="bozp-form__yesno">
                <label class="bozp-form__yesno-opt">
                    <input type="radio" name="{{ name }}" value="yes" {% if value == 'yes' %}checked{% endif %}>
                    <span>{{ 'Áno'|t('bozp') }}</span>
                </label>
                <label class="bozp-form__yesno-opt">
                    <input type="radio" name="{{ name }}" value="no" {% if value == 'no' %}checked{% endif %}>
                    <span>{{ 'Nie'|t('bozp') }}</span>
                </label>
            </div>
        </div>
    {% endmacro %}

    {{ _self.yn_row('lotoApplied', values.lotoApplied ?? '', 'LOTO bol aplikovaný na zdroj energie?'|t('bozp')) }}
    {{ _self.yn_row('pumpsBlinded', values.pumpsBlinded ?? '', 'Čerpadlá / potrubia sú zaslepené, odpojené alebo zablokované?'|t('bozp')) }}
    {{ _self.yn_row('ventilationRequired', values.ventilationRequired ?? '', 'Je potrebná úprava ventilácie?'|t('bozp')) }}

    <div class="bozp-form__row bozp-form__row--2col">
        <div class="bozp-form__field">
            <label for="ventilationStartTime">{{ 'Nútené vetranie — začiatok'|t('bozp') }}</label>
            <input type="time" id="ventilationStartTime" name="ventilationStartTime"
                   value="{{ values.ventilationStartTime ?? '' }}">
        </div>
        <div class="bozp-form__field">
            <label for="ventilationStopTime">{{ 'Nútené vetranie — koniec'|t('bozp') }}</label>
            <input type="time" id="ventilationStopTime" name="ventilationStopTime"
                   value="{{ values.ventilationStopTime ?? '' }}">
        </div>
    </div>
</fieldset>

<fieldset class="bozp-form__section">
    <legend>{{ 'Kontrola atmosféry'|t('bozp') }}</legend>
    <p class="bozp-form__hint">{{ 'Vstup povolený: O₂ 19,5 – 23,5 %, LEL < 10 %, CO a H₂S = 0 PPM.'|t('bozp') }}</p>

    <div class="bozp-form__row bozp-form__row--4col">
        <div class="bozp-form__field">
            <label for="o2Percent">{{ 'O₂ (%)'|t('bozp') }}</label>
            <input type="text" id="o2Percent" name="o2Percent"
                   value="{{ values.o2Percent ?? '' }}" maxlength="10" style="width:100px">
        </div>
        <div class="bozp-form__field">
            <label for="lelPercent">{{ '%LEL'|t('bozp') }}</label>
            <input type="text" id="lelPercent" name="lelPercent"
                   value="{{ values.lelPercent ?? '' }}" maxlength="10" style="width:100px">
        </div>
        <div class="bozp-form__field">
            <label for="coPpm">{{ 'CO (PPM)'|t('bozp') }}</label>
            <input type="text" id="coPpm" name="coPpm"
                   value="{{ values.coPpm ?? '' }}" maxlength="10" style="width:100px">
        </div>
        <div class="bozp-form__field">
            <label for="h2sPpm">{{ 'H₂S (PPM)'|t('bozp') }}</label>
            <input type="text" id="h2sPpm" name="h2sPpm"
                   value="{{ values.h2sPpm ?? '' }}" maxlength="10" style="width:100px">
        </div>
    </div>

    <div class="bozp-form__field">
        <span class="bozp-form__label">{{ 'Komunikácia vstupujúceho s dozorom je potvrdená?'|t('bozp') }}</span>
        <div class="bozp-form__yesno">
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="communicationConfirmed" value="yes"
                       {% if (values.communicationConfirmed ?? '') == 'yes' %}checked{% endif %}>
                <span>{{ 'Áno'|t('bozp') }}</span>
            </label>
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="communicationConfirmed" value="no"
                       {% if (values.communicationConfirmed ?? '') == 'no' %}checked{% endif %}>
                <span>{{ 'Nie'|t('bozp') }}</span>
            </label>
        </div>
    </div>
</fieldset>
