{# Príloha č. 8 — Povolenie na zdvíhacie a žeriavové práce.
   Layout mirrors the printed two-page form. FÁZA-2 contractor sign-off /
   audit pages map to the digital workflow (preworks + contractor closure +
   issuer closure), so no extra signer rows live in this form. #}

{% macro yn_row(name, value, label) %}
    <div class="bozp-form-row">
        <span class="bozp-form-row__label">{{ label }}</span>
        <div class="bozp-form__yesno">
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="{{ name }}" value="yes" required {% if value == 'yes' %}checked{% endif %}>
                <div class="custom_radio"></div>
                <span>{{ 'Áno'|t('bozp') }}</span>
            </label>
            <label class="bozp-form__yesno-opt">
                <input type="radio" name="{{ name }}" value="no" required {% if value == 'no' %}checked{% endif %}>
                <div class="custom_radio"></div>
                <span>{{ 'Nie'|t('bozp') }}</span>
            </label>
        </div>
    </div>
{% endmacro %}

{# ─── Príprava na činnosť — všetky pracovné činnosti ─────────────────── #}
<fieldset class="bozp-form-section">
    <legend class="bozp-form-section__title">{{ 'Príprava na činnosť — všetky pracovné činnosti'|t('bozp') }}</legend>
    <p class="bozp-form-section__hint">{{ '(*vyhovujúce zaškrknite)'|t('bozp') }}</p>

    <div class="bozp-form-grid bozp-form-grid--2col">
        {{ _self.yn_row(
            'canFenceOffWorkplace',
            values.canFenceOffWorkplace ?? '',
            'Je možné ohradiť pracovisko a zabrániť tak vstupu nepovolaných osôb (bariéry, výstražná páska, bezpečnostné piktogramy)'|t('bozp')
        ) }}
        {{ _self.yn_row(
            'workerTrained',
            values.workerTrained ?? '',
            'Vykonávateľ práce je školený — autorizovaný — spôsobilý na prácu'|t('bozp')
        ) }}
    </div>

    <div class="bozp-form-row">
        <label for="specialToolsUsed">{{ 'Špeciálne náradie, pracovné vybavenie, ktoré bude použité'|t('bozp') }}</label>
        <textarea id="specialToolsUsed" name="specialToolsUsed" rows="3">{{ values.specialToolsUsed ?? '' }}</textarea>
    </div>

    <div class="bozp-form-grid bozp-form-grid--2col">
        {{ _self.yn_row(
            'processConditionsSuitable',
            values.processConditionsSuitable ?? '',
            'Procesné podmienky sú vhodné pre prácu (dostatočná nosnosť)'|t('bozp')
        ) }}
        {{ _self.yn_row(
            'otherWorkAffectingPermit',
            values.otherWorkAffectingPermit ?? '',
            'Vykonáva sa v súčasnosti iná práca, ktorá by mohla ovplyvniť toto povolenie?'|t('bozp')
        ) }}
    </div>
</fieldset>

{# ─── Bezpečnostné požiadavky ─────────────────────────────────────────── #}
<fieldset class="bozp-form-section">
    <legend class="bozp-form-section__title">{{ 'Bezpečnostné požiadavky, ktoré sa majú prijať'|t('bozp') }}</legend>
    <p class="bozp-form-section__hint">{{ '(*vyhovujúce zaškrknite)'|t('bozp') }}</p>

    {% set safetyChecklist = [
        ['craneInSafestPosition',          'Je žeriav premiestnený do najbezpečnejšej možnej polohy'|t('bozp')],
        ['safeAccessEnsured',              'Bezpečný prístup na pracovisko je zabezpečený'|t('bozp')],
        ['craneDangerZoneFenced',          'Je nebezpečná zóna žeriava ohradená'|t('bozp')],
        ['employeesAwareOfFencingAndBan',  'Sú zamestnanci oboznámení s ohradením pracoviska a zákazom vstupu'|t('bozp')],
        ['craneControlsHaveLoadBinderView','Ovládače žeriava sú umiestnené s dobrým výhľadom na viazača bremena'|t('bozp')],
        ['craneInGoodCondition',           'Je žeriav v dobrom technickom stave'|t('bozp')],
        ['otherCollisionRisks',            'Sú v oblasti iné žeriavy, vozidlá, inžinierske siete, osoby alebo iné kolízne riziká'|t('bozp')],
        ['noOtherWorkNearby',              'Je skontrolované, či sa v blízkosti pracoviska / pracovnej oblasti nevykonáva iná práca'|t('bozp')],
        ['bindingEquipmentInspected',      'Sú viazacie prostriedky v dobrom stave a majú platnú revíziu'|t('bozp')],
        ['communicationAgreed',            'Je dohodnutá komunikácia medzi viazačom bremena a obsluhou žeriava'|t('bozp')],
        ['fallProtectionRequired',         'Vyžadujú sa počas práce prostriedky ochrany pred pádom'|t('bozp')],
    ] %}

    {% for item in safetyChecklist %}
        {{ _self.yn_row(item[0], attribute(values, item[0]) ?? '', item[1]) }}
    {% endfor %}
</fieldset>

{# ─── Záverečné potvrdenia ────────────────────────────────────────────── #}
<fieldset class="bozp-form-section">
    <legend class="bozp-form-section__title">{{ 'Záverečné potvrdenia'|t('bozp') }}</legend>

    <div class="bozp-form-grid bozp-form-grid--2col">
        {{ _self.yn_row(
            'liftingPlanEstablished',
            values.liftingPlanEstablished ?? '',
            'Vypracovaný, prediskutovaný, zavedený a overený plán na vykonávanie zdvíhacích a žeriavových prác'|t('bozp')
        ) }}
        {{ _self.yn_row(
            'workChecksDiscussedOnSite',
            values.workChecksDiscussedOnSite ?? '',
            'Práca / činnosť skontrolovaná a prediskutovaná na mieste'|t('bozp')
        ) }}
    </div>
</fieldset>
