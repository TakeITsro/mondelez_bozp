{% extends 'bozp/site/_layout.twig' %}

{# ---------------------------------------------------------------------------
   Subpermit detail — read-only view for the issuer.
   Variables from SubpermitsController::actionView():
     permit, subpermit (SubpermitRecord), subpermitType (SubpermitType|null),
     values (decoded data array), isIssuer, canCancel, signatures
--------------------------------------------------------------------------- #}

{% set appendixN = subpermitType ? subpermitType.appendixNumber() : '?' %}
{% set typeLabel = subpermitType ? subpermitType.label() : subpermit.type %}

{% block title %}{{ 'Príloha č. {n}'|t('bozp', {n: appendixN}) }} — {{ typeLabel }}{% endblock %}

{% block content %}
    <section class="bozp-page bozp-page--subpermit-view">
        <header class="bozp-page__header">
            <p class="bozp-page__back">
                <a href="{{ url('bozp/permits/' ~ permit.id) }}">← {{ permit.permitNumber }}</a>
            </p>
            <h1>{{ 'Príloha č. {n}'|t('bozp', {n: appendixN}) }} — {{ typeLabel }}</h1>
            <div class="bozp-page__meta" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span class="bozp-status bozp-status--{{ subpermit.status }}">
                    {{ subpermit.status|t('bozp') }}
                </span>
                {% if subpermit.status == 'approved' and subpermit.expiresAt %}
                    <span class="bozp-page__expires">
                        {{ 'Platný do'|t('bozp') }}:
                        <strong>{{ subpermit.expiresAt|date('d.m.Y H:i') }}</strong>
                    </span>
                {% endif %}
                <span class="bozp-page__created">
                    {{ 'Vytvorené'|t('bozp') }}: {{ subpermit.dateCreated|date('d.m.Y H:i') }}
                </span>
                <a href="{{ url('bozp/permits/' ~ permit.id ~ '/subpermits/' ~ subpermit.id ~ '/pdf') }}"
                   target="_blank" rel="noopener"
                   class="bozp-btn bozp-btn--secondary bozp-btn--sm"
                   style="font-size:12px;padding:4px 12px;">
                    ⬇ {{ 'Zobraziť PDF'|t('bozp') }}
                </a>
            </div>
        </header>

        {# Rejection note #}
        {% if subpermit.status == 'rejected' and subpermit.rejectionNote %}
            <div class="bozp-alert bozp-alert--danger">
                <strong>{{ 'Dôvod zamietnutia'|t('bozp') }}:</strong>
                {{ subpermit.rejectionNote }}
            </div>
        {% endif %}

        {# --- Common fields --- #}
        <div class="bozp-detail-section">
            <h2>{{ 'Základné informácie'|t('bozp') }}</h2>
            <div class="bozp-detail-list">
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Dátum'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ values.date ? values.date|date('d.m.Y') : '—' }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Miesto výkonu'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ values.placeOfWork ?: '—' }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Zodpovedná osoba MDLZ'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ values.responsiblePerson ?: '—' }}</div>
                </div>

                {% if values.participants ?? '' %}
                    <div class="bozp-detail-row">
                        <div class="bozp-detail-row__label">{{ 'Zúčastnení dodávatelia / osoby'|t('bozp') }}</div>
                        <div class="bozp-detail-row__value">{{ values.participants }}</div>
                    </div>
                {% endif %}

                {% if values.workDescription ?? '' %}
                    <div class="bozp-detail-row">
                        <div class="bozp-detail-row__label">{{ 'Popis vykonávanej práce'|t('bozp') }}</div>
                        <div class="bozp-detail-row__value">{{ values.workDescription }}</div>
                    </div>
                {% endif %}
            </div>

            {% set hasSteps = false %}
            {% for i in 1..5 %}{% if attribute(values, 'workStep' ~ i) ?? '' %}{% set hasSteps = true %}{% endif %}{% endfor %}
            {% if hasSteps %}
                <ol class="bozp-view__steps">
                    {% for i in 1..5 %}
                        {% set step = attribute(values, 'workStep' ~ i) ?? '' %}
                        {% if step %}<li>{{ step }}</li>{% endif %}
                    {% endfor %}
                </ol>
            {% endif %}
        </div>

        {# --- Heights fall-risk table --- #}
        {% if subpermitType and subpermitType.value == 'heights' and values.fallRisks is defined and values.fallRisks|length > 0 %}
            {% set fallRiskLabels = {
                'elevated_walkways':  'Vyvýšené prechodové/pracovné plochy 1,2 m alebo viac nad úrovňou podlahy.'|t('bozp'),
                'roof_work':          'Práca na strechách, na ktoré pracovníci vstupujú, kde môžu spadnúť cez strešné okno, otvor, práca na okraji hrany pádu.'|t('bozp'),
                'wall_openings':      'Stenové otvory (napríklad: okná alebo dvere, cez ktoré by pracovníci mohli spadnúť).'|t('bozp'),
                'pits_excavations':   'Výkopy a jamy, ktoré nie sú ľahko viditeľné a pracovníci by mohli do nich spadnúť.'|t('bozp'),
                'mobile_platforms':   'Mobilné pracovné plošiny.'|t('bozp'),
                'removed_handrails':  'Vyvýšené priestory, kde boli odstránené zábradlia.'|t('bozp'),
                'unprotected_edges':  'Strany/okraje prechodových/pracovných plôch (podlahy, medziposchodia, balkóny, chodníky) 1,2 m alebo viac bez zábradlia.'|t('bozp'),
                'unprotected_ramps':  'Rampy, prechody a cesty, ktoré nie sú chránené zábradlím.'|t('bozp'),
                'floor_openings':     'Studne, podlahové otvory, jamy alebo šachty bez zábradlia/plotov/bariér/krytov.'|t('bozp'),
            } %}
            <div class="bozp-detail-section">
                <h2 class="bozp-detail-section__title">{{ 'Nebezpečenstvo pádu'|t('bozp') }}</h2>
                <table class="bozp-fall-risks">
                    <thead>
                        <tr>
                            <th>{{ 'Nebezpečenstvo pádu'|t('bozp') }}</th>
                            <th>{{ 'Aplikované'|t('bozp') }}</th>
                            <th>{{ 'Kontrola na pracovisku'|t('bozp') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for key, label in fallRiskLabels %}
                            {% set r = values.fallRisks[key] ?? {} %}
                            <tr>
                                <th scope="row">{{ label }}</th>
                                <td>
                                    {%- if (r.applied ?? '') == 'yes' -%}{{ 'Áno'|t('bozp') }}
                                    {%- elseif (r.applied ?? '') == 'no' -%}{{ 'Nie'|t('bozp') }}
                                    {%- else -%}—{%- endif -%}
                                </td>
                                <td>
                                    {%- if (r.controlled ?? '') == 'yes' -%}{{ 'Áno'|t('bozp') }}
                                    {%- elseif (r.controlled ?? '') == 'no' -%}{{ 'Nie'|t('bozp') }}
                                    {%- else -%}—{%- endif -%}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# --- Closure status + trial-operation (captured at contractor completion sign) --- #}
        {% if (values.closureStatus is defined and values.closureStatus|length > 0) or values.requiresTestRun is defined %}
            {% set closureLabels = {
                'work_completed':                  'Práce boli dokončené'|t('bozp'),
                'equipment_operational':           'Zariadenie je prevádzkyschopné'|t('bozp'),
                'equipment_not_operational':       'Zariadenie nie je prevádzkyschopné'|t('bozp'),
                'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené'|t('bozp'),
                'work_suspended':                  'Práce boli pozastavené'|t('bozp'),
            } %}
            <div class="bozp-detail-section">
                <h2 class="bozp-detail-section__title">{{ 'Dokončenie / zrušenie'|t('bozp') }}</h2>
                <div class="bozp-detail-list">
                    {% if values.closureStatus is defined and values.closureStatus|length > 0 %}
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Stav po dokončení'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">
                                <ul style="margin:0;padding-left:18px;">
                                    {% for k in values.closureStatus %}
                                        <li>✓ {{ closureLabels[k] ?? k }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% endif %}
                    {% if values.requiresTestRun is defined and values.requiresTestRun in ['yes','no'] %}
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Vyžaduje sa skúšobná prevádzka'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ values.requiresTestRun == 'yes' ? 'Áno'|t('bozp') : 'Nie'|t('bozp') }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# --- Command B — action grid rendered separately (nested array) --- #}
        {% set commandBActions = (subpermitType and subpermitType.value == 'command_b')
            ? (values.actions ?? {})
            : {} %}
        {% if commandBActions|length > 0 %}
            {% set commandBGroups = {
                'turn_off':              'Vypnúť'|t('bozp'),
                'disconnected':          'Odpojené'|t('bozp'),
                'further_measures':      'Ďalšie opatrenia'|t('bozp'),
                'check_de_energized':    'Ako overiť, že inštalácia je bez napätia'|t('bozp'),
                'grounding_shorting':    'Uzemnenie a skratovanie'|t('bozp'),
                'workplace_marking':     'Spôsob označenia pracoviska'|t('bozp'),
                'workplace_definition':  'Vymedzenie pracoviska'|t('bozp'),
                'additional_safety':     'Doplnkové bezpečnostné opatrenia'|t('bozp'),
            } %}
            <div class="bozp-detail-section">
                <h2>{{ 'Opatrenia na zabezpečenie pracoviska'|t('bozp') }}</h2>
                {% for groupKey, groupLabel in commandBGroups %}
                    {% set rows = commandBActions[groupKey] ?? [] %}
                    {% if rows|length > 0 %}
                        <h3>{{ groupLabel }}</h3>
                        <table class="bozp-detail-table">
                            <thead>
                                <tr>
                                    <th>{{ 'Miesto'|t('bozp') }}</th>
                                    <th>{{ 'Úkon'|t('bozp') }}</th>
                                    <th>{{ 'Por. č.'|t('bozp') }}</th>
                                    <th>{{ 'Zodpovedný'|t('bozp') }}</th>
                                    <th>{{ 'Dátum / čas'|t('bozp') }}</th>
                                    <th>{{ 'Podpis'|t('bozp') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                    <tr>
                                        <td>{{ row.place ?: '—' }}</td>
                                        <td>{{ row.description ?: '—' }}</td>
                                        <td>{{ row.serialNumber ?: '—' }}</td>
                                        <td>{{ row.responsible ?: '—' }}</td>
                                        <td>{{ row.performedAt ? row.performedAt|replace({'T': ' '}) : '—' }}</td>
                                        <td>{{ row.signatureName ?: '—' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {# --- Type-specific fields (generic key-value display) --- #}
        {# 'actions' excluded — rendered above for command_b; flat |join would
           PHP-throw "Array to string conversion" on its nested rows. #}
        {% set commonKeys = ['date','placeOfWork','responsiblePerson','participants','workDescription',
            'workStep1','workStep2','workStep3','workStep4','workStep5','fallRisks','closureStatus','requiresTestRun','actions'] %}
        {% set typeValues = {} %}
        {% for k, v in values %}
            {% if k not in commonKeys and v is not empty %}
                {% set typeValues = typeValues|merge({(k): v}) %}
            {% endif %}
        {% endfor %}

        {% if typeValues|length > 0 %}
            <div class="bozp-detail-section">
                <h2>{{ 'Špecifické podmienky'|t('bozp') }}</h2>
                <div class="bozp-detail-list">
                    {% for k, v in typeValues %}
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ k }}</div>
                            <div class="bozp-detail-row__value">
                                {% if v is iterable %}
                                    {# Guard against nested arrays. #}
                                    {% set hasNested = false %}
                                    {% for el in v %}{% if el is iterable %}{% set hasNested = true %}{% endif %}{% endfor %}
                                    {% if hasNested %}
                                        <em class="bozp-empty">{{ '(zložené dáta)'|t('bozp') }}</em>
                                    {% else %}
                                        {{ v|join(', ') }}
                                    {% endif %}
                                {% elseif v == 'yes' %}
                                    {{ 'Áno'|t('bozp') }}
                                {% elseif v == 'no' %}
                                    {{ 'Nie'|t('bozp') }}
                                {% else %}
                                    {{ v }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# --- Pre-work signing (issuer side) --- #}
        {% set issuerPrework     = signatures['issuer_prework'] ?? null %}
        {% set contractorPrework = signatures['contractor_prework'] ?? null %}
        {% set contractorClosure = signatures['contractor'] ?? null %}
        {% set issuerClosure     = signatures['issuer_closure'] ?? null %}
        {% set canIssuerSignClosure = isIssuer and contractorClosure and not issuerClosure %}
        {# Pre-work signature is captured by the issuer on form submission; never via this page. #}
        {% set canIssuerSignPrework = false %}

        {% if subpermit.status == 'pending' and not contractorPrework %}
            <div class="bozp-alert bozp-alert--warning" style="background:#fff4e0;border-left:4px solid #d97706;padding:10px 14px;color:#7a3e00;margin-bottom:16px;">
                <strong>{{ 'Pred schválením HSE'|t('bozp') }}:</strong>
                {{ 'Čaká sa na predpracovný podpis dodávateľa. HSE bude môcť schváliť subpermit až po jeho podpise.'|t('bozp') }}
            </div>
        {% endif %}

        {% if contractorClosure and not issuerClosure %}
            <div class="bozp-alert bozp-alert--warning" style="background:#fff4e0;border-left:4px solid #d97706;padding:10px 14px;color:#7a3e00;margin-bottom:16px;">
                <strong>{{ 'Čaká na uzavretie vydavateľom'|t('bozp') }}:</strong>
                {{ 'Dodávateľ podpísal uzavretie. Subpermit bude úplne uzavretý po Vašom podpise.'|t('bozp') }}
            </div>
        {% endif %}

        {# --- Signatures --- #}
        <div class="bozp-detail-section bozp-detail-section--signatures">
            <h2 class="bozp-detail-section__title">{{ 'Podpisy'|t('bozp') }}</h2>

            <h3 style="margin:12px 0 8px;">{{ 'Pred začatím prác'|t('bozp') }}</h3>
            <div class="bozp-signatures-grid" style="display:flex;gap:24px;flex-wrap:wrap;margin-bottom:16px;">
                {% for role, label in {'issuer_prework': 'Vydavateľ — pred prácou'|t('bozp'), 'contractor_prework': 'Dodávateľ — pred prácou'|t('bozp')} %}
                    {% set sig = signatures[role] ?? null %}
                    <div class="bozp-signature-slot" style="flex:1;min-width:220px;border:1px solid #ddd;border-radius:4px;padding:12px;">
                        <h4 style="margin-top:0;font-size:14px;">{{ label }}</h4>
                        {% if sig %}
                            {% set sigAsset = craft.assets().id(sig.signatureAssetId).one() %}
                            {% if sigAsset %}
                                <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                     style="max-width:280px;max-height:110px;border:1px solid #eee;background:#fff;display:block;margin-bottom:8px;">
                            {% endif %}
                            <div class="bozp-detail-list" style="font-size:13px;">
                                <div class="bozp-detail-row">
                                    <div class="bozp-detail-row__label">{{ 'Podpísal'|t('bozp') }}</div>
                                    <div class="bozp-detail-row__value">{{ sig.signerName }}</div>
                                </div>
                                {% if sig.signerEmployer %}
                                    <div class="bozp-detail-row">
                                        <div class="bozp-detail-row__label">{{ 'Firma'|t('bozp') }}</div>
                                        <div class="bozp-detail-row__value">{{ sig.signerEmployer }}</div>
                                    </div>
                                {% endif %}
                                <div class="bozp-detail-row">
                                    <div class="bozp-detail-row__label">{{ 'Dátum'|t('bozp') }}</div>
                                    <div class="bozp-detail-row__value">{{ sig.signatureDate ? sig.signatureDate|date('d.m.Y') : '—' }}</div>
                                </div>
                            </div>
                        {% elseif role == 'issuer_prework' and canIssuerSignPrework %}
                            <p style="font-size:13px;color:#666;margin:0 0 8px;">{{ 'Nepodpísané'|t('bozp') }}</p>
                            <button type="button" class="bozp-btn bozp-btn--primary bozp-btn--sm"
                                    id="bozp-open-prework-dialog">
                                {{ 'Podpísať pred prácou'|t('bozp') }}
                            </button>
                        {% else %}
                            <p class="bozp-empty" style="font-size:13px;">{{ 'Nepodpísané'|t('bozp') }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            <h3 style="margin:12px 0 8px;">{{ 'Pri uzavretí'|t('bozp') }}</h3>
            <div class="bozp-signatures-grid" style="display:flex;gap:24px;flex-wrap:wrap;">
                {% for role, label in {'contractor': 'Dodávateľ — uzavretie'|t('bozp'), 'issuer_closure': 'Vydavateľ — uzavretie'|t('bozp')} %}
                    {% set sig = signatures[role] ?? null %}
                    <div class="bozp-signature-slot" style="flex:1;min-width:220px;border:1px solid #ddd;border-radius:4px;padding:12px;">
                        <h4 style="margin-top:0;font-size:14px;">{{ label }}</h4>
                        {% if sig %}
                            {% set sigAsset = craft.assets().id(sig.signatureAssetId).one() %}
                            {% if sigAsset %}
                                <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                     style="max-width:280px;max-height:110px;border:1px solid #eee;background:#fff;display:block;margin-bottom:8px;">
                            {% endif %}
                            <div class="bozp-detail-list" style="font-size:13px;">
                                <div class="bozp-detail-row">
                                    <div class="bozp-detail-row__label">{{ 'Podpísal'|t('bozp') }}</div>
                                    <div class="bozp-detail-row__value">{{ sig.signerName }}</div>
                                </div>
                                {% if sig.signerEmployer %}
                                    <div class="bozp-detail-row">
                                        <div class="bozp-detail-row__label">{{ 'Firma'|t('bozp') }}</div>
                                        <div class="bozp-detail-row__value">{{ sig.signerEmployer }}</div>
                                    </div>
                                {% endif %}
                                <div class="bozp-detail-row">
                                    <div class="bozp-detail-row__label">{{ 'Dátum'|t('bozp') }}</div>
                                    <div class="bozp-detail-row__value">{{ sig.signatureDate ? sig.signatureDate|date('d.m.Y') : '—' }}</div>
                                </div>
                            </div>
                        {% elseif role == 'issuer_closure' and canIssuerSignClosure %}
                            <p style="font-size:13px;color:#666;margin:0 0 8px;">{{ 'Nepodpísané'|t('bozp') }}</p>
                            <button type="button" class="bozp-btn bozp-btn--primary bozp-btn--sm"
                                    id="bozp-open-closure-dialog">
                                {{ 'Podpísať uzavretie'|t('bozp') }}
                            </button>
                        {% else %}
                            <p class="bozp-empty" style="font-size:13px;">{{ 'Nepodpísané'|t('bozp') }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {# --- Issuer pre-work signing dialog --- #}
        {% if canIssuerSignPrework %}
            <form method="post" action="" id="bozp-prework-form" style="display:none;">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/subpermits/sign-prework">
                <input type="hidden" name="permitId" value="{{ permit.id }}">
                <input type="hidden" name="id" value="{{ subpermit.id }}">
                <input type="hidden" name="signerName"    id="bozp-pw-name">
                <input type="hidden" name="signatureDate" id="bozp-pw-date">
                <input type="hidden" name="signatureData" id="bozp-pw-data">
            </form>

            <dialog id="bozp-prework-dialog"
                    style="border:none;padding:0;border-radius:8px;max-width:560px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,.25);">
                <div class="bozp-form bozp-form--sign" style="margin:0;padding:24px;">
                    <h3 style="margin-top:0;">{{ 'Podpis vydavateľa — pred prácou'|t('bozp') }}</h3>
                    <p>{{ 'Podpisom potvrdzujete, že subpermit je pripravený a práca môže byť zahájená.'|t('bozp') }}</p>

                    <div class="bozp-form-row">
                        <label>{{ 'Meno podpisujúceho'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <input type="text" id="bozp-pw-dlg-name"
                               value="{{ currentUser.fullName ?: currentUser.friendlyName ?: currentUser.username }}" required>
                    </div>

                    <div class="bozp-form-row">
                        <label>{{ 'Dátum'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <input type="date" id="bozp-pw-dlg-date"
                               value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>

                    <div class="bozp-form-row">
                        <label>{{ 'Podpis'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <div style="border:1px solid #ccc;background:#fff;width:100%;">
                            <canvas id="bozp-pw-canvas" width="520" height="180"
                                    style="display:block;width:100%;height:180px;touch-action:none;"></canvas>
                        </div>
                        <div style="margin-top:8px;">
                            <button type="button" class="bozp-btn bozp-btn--secondary" id="bozp-pw-clear">
                                {{ 'Vyčistiť'|t('bozp') }}
                            </button>
                        </div>
                    </div>

                    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">
                        <button type="button" class="bozp-btn bozp-btn--secondary" id="bozp-pw-cancel">
                            {{ 'Zrušiť'|t('bozp') }}
                        </button>
                        <button type="button" class="bozp-btn bozp-btn--primary" id="bozp-pw-submit">
                            {{ 'Podpísať'|t('bozp') }}
                        </button>
                    </div>
                </div>
            </dialog>

            <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
            <script>
                (function () {
                    var openBtn  = document.getElementById('bozp-open-prework-dialog');
                    var dialog   = document.getElementById('bozp-prework-dialog');
                    var canvas   = document.getElementById('bozp-pw-canvas');
                    var clearBtn = document.getElementById('bozp-pw-clear');
                    var submitBtn= document.getElementById('bozp-pw-submit');
                    var cancelBtn= document.getElementById('bozp-pw-cancel');
                    var form     = document.getElementById('bozp-prework-form');
                    var pad      = null;

                    function initPad() {
                        if (!window.SignaturePad || !canvas || pad) return;
                        var ratio = Math.max(window.devicePixelRatio || 1, 1);
                        canvas.width  = canvas.offsetWidth  * ratio;
                        canvas.height = canvas.offsetHeight * ratio;
                        canvas.getContext('2d').scale(ratio, ratio);
                        pad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)', penColor: '#000' });
                    }

                    if (openBtn) {
                        openBtn.addEventListener('click', function () {
                            dialog.showModal ? dialog.showModal() : dialog.setAttribute('open', '');
                            window.requestAnimationFrame(initPad);
                        });
                    }
                    if (cancelBtn) cancelBtn.addEventListener('click', function () { dialog.close(); });
                    if (clearBtn)  clearBtn.addEventListener('click',  function () { if (pad) pad.clear(); });

                    if (submitBtn) {
                        submitBtn.addEventListener('click', function () {
                            var name = document.getElementById('bozp-pw-dlg-name').value.trim();
                            var date = document.getElementById('bozp-pw-dlg-date').value.trim();
                            if (!name) { alert('{{ 'Zadajte meno podpisujúceho.'|t('bozp') }}'); return; }
                            if (!pad || pad.isEmpty()) { alert('{{ 'Podpis je povinný.'|t('bozp') }}'); return; }
                            document.getElementById('bozp-pw-name').value = name;
                            document.getElementById('bozp-pw-date').value = date;
                            document.getElementById('bozp-pw-data').value = pad.toDataURL('image/png');
                            dialog.close();
                            form.submit();
                        });
                    }
                })();
            </script>
        {% endif %}

        {# --- Issuer closure signing dialog --- #}
        {% if canIssuerSignClosure %}
            <form method="post" action="" id="bozp-closure-form" style="display:none;">
                {{ csrfInput() }}
                <input type="hidden" name="action" value="bozp/subpermits/sign-closure">
                <input type="hidden" name="permitId" value="{{ permit.id }}">
                <input type="hidden" name="id" value="{{ subpermit.id }}">
                <input type="hidden" name="signerName"    id="bozp-cl-name">
                <input type="hidden" name="signatureDate" id="bozp-cl-date">
                <input type="hidden" name="signatureData" id="bozp-cl-data">
            </form>

            <dialog id="bozp-closure-dialog"
                    style="border:none;padding:0;border-radius:8px;max-width:560px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,.25);">
                <div class="bozp-form bozp-form--sign" style="margin:0;padding:24px;">
                    <h3 style="margin-top:0;">{{ 'Podpis vydavateľa — uzavretie'|t('bozp') }}</h3>
                    <p>{{ 'Podpisom potvrdzujete úplné uzavretie subpermitu po podpise dodávateľa.'|t('bozp') }}</p>

                    <div class="bozp-form-row">
                        <label>{{ 'Meno podpisujúceho'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <input type="text" id="bozp-cl-dlg-name"
                               value="{{ currentUser.fullName ?: currentUser.friendlyName ?: currentUser.username }}" required>
                    </div>

                    <div class="bozp-form-row">
                        <label>{{ 'Dátum'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <input type="date" id="bozp-cl-dlg-date"
                               value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>

                    <div class="bozp-form-row">
                        <label>{{ 'Podpis'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                        <div style="border:1px solid #ccc;background:#fff;width:100%;">
                            <canvas id="bozp-cl-canvas" width="520" height="180"
                                    style="display:block;width:100%;height:180px;touch-action:none;"></canvas>
                        </div>
                        <div style="margin-top:8px;">
                            <button type="button" class="bozp-btn bozp-btn--secondary" id="bozp-cl-clear">
                                {{ 'Vyčistiť'|t('bozp') }}
                            </button>
                        </div>
                    </div>

                    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">
                        <button type="button" class="bozp-btn bozp-btn--secondary" id="bozp-cl-cancel">
                            {{ 'Zrušiť'|t('bozp') }}
                        </button>
                        <button type="button" class="bozp-btn bozp-btn--primary" id="bozp-cl-submit">
                            {{ 'Podpísať'|t('bozp') }}
                        </button>
                    </div>
                </div>
            </dialog>

            <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
            <script>
                (function () {
                    var openBtn  = document.getElementById('bozp-open-closure-dialog');
                    var dialog   = document.getElementById('bozp-closure-dialog');
                    var canvas   = document.getElementById('bozp-cl-canvas');
                    var clearBtn = document.getElementById('bozp-cl-clear');
                    var submitBtn= document.getElementById('bozp-cl-submit');
                    var cancelBtn= document.getElementById('bozp-cl-cancel');
                    var form     = document.getElementById('bozp-closure-form');
                    var pad      = null;

                    function initPad() {
                        if (!window.SignaturePad || !canvas || pad) return;
                        var ratio = Math.max(window.devicePixelRatio || 1, 1);
                        canvas.width  = canvas.offsetWidth  * ratio;
                        canvas.height = canvas.offsetHeight * ratio;
                        canvas.getContext('2d').scale(ratio, ratio);
                        pad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)', penColor: '#000' });
                    }

                    if (openBtn) {
                        openBtn.addEventListener('click', function () {
                            dialog.showModal ? dialog.showModal() : dialog.setAttribute('open', '');
                            window.requestAnimationFrame(initPad);
                        });
                    }
                    if (cancelBtn) cancelBtn.addEventListener('click', function () { dialog.close(); });
                    if (clearBtn)  clearBtn.addEventListener('click',  function () { if (pad) pad.clear(); });

                    if (submitBtn) {
                        submitBtn.addEventListener('click', function () {
                            var name = document.getElementById('bozp-cl-dlg-name').value.trim();
                            var date = document.getElementById('bozp-cl-dlg-date').value.trim();
                            if (!name) { alert('{{ 'Zadajte meno podpisujúceho.'|t('bozp') }}'); return; }
                            if (!pad || pad.isEmpty()) { alert('{{ 'Podpis je povinný.'|t('bozp') }}'); return; }
                            document.getElementById('bozp-cl-name').value = name;
                            document.getElementById('bozp-cl-date').value = date;
                            document.getElementById('bozp-cl-data').value = pad.toDataURL('image/png');
                            dialog.close();
                            form.submit();
                        });
                    }
                })();
            </script>
        {% endif %}

        {# --- Actions --- #}
        <div class="bozp-form__actions">
            <a href="{{ url('bozp/permits/' ~ permit.id) }}" class="bozp-btn bozp-btn--cancel">
                {{ 'Späť'|t('bozp') }}
            </a>
            {% if canCancel %}
                <form method="post" style="display:inline;"
                      onsubmit="return confirm('{{ 'Naozaj chcete zrušiť tento subpermit?'|t('bozp') }}')">
                    {{ csrfInput() }}
                    <input type="hidden" name="action" value="bozp/subpermits/cancel">
                    <input type="hidden" name="permitId" value="{{ permit.id }}">
                    <input type="hidden" name="id" value="{{ subpermit.id }}">
                    <button type="submit" class="bozp-btn bozp-btn--danger">
                        {{ 'Zrušiť subpermit'|t('bozp') }}
                    </button>
                </form>
            {% endif %}
        </div>
    </section>
{% endblock %}
