{% extends 'bozp/site/_layout.twig' %}

{# ---------------------------------------------------------------------------
   Front-end read-only permit detail. Visible to:
     - the issuer of this permit (always)
     - anyone with bozp:viewAll
   HSE approval actions live in the CP — this view is informational only.
--------------------------------------------------------------------------- #}

{% set statusLabels = {
    'draft':           'Koncept'|t('bozp'),
    'submitted':       'Odoslané'|t('bozp'),
    'approved':        'Schválené'|t('bozp'),
    'rejected':        'Zamietnuté'|t('bozp'),
    'signed':          'Podpísané'|t('bozp'),
    'active':          'Aktívne'|t('bozp'),
    'pending_closure': 'Čaká na uzavretie'|t('bozp'),
    'closed':          'Uzavreté'|t('bozp'),
    'cancelled':       'Zrušené'|t('bozp'),
    'expired':         'Vypršané'|t('bozp'),
} %}

{% set controlLabels = {
    'used':     'Použité'|t('bozp'),
    'not_used': 'Nepoužité'|t('bozp'),
    'other':    'Iné'|t('bozp'),
} %}

{% macro yn(val) %}
    {%- if val is null -%}
        <span class="bozp-yn bozp-yn--unset">—</span>
    {%- elseif val -%}
        <span class="bozp-yn bozp-yn--yes">{{ 'Áno'|t('bozp') }}</span>
    {%- else -%}
        <span class="bozp-yn bozp-yn--no">{{ 'Nie'|t('bozp') }}</span>
    {%- endif -%}
{% endmacro %}

{% macro file_picker(name, id, label, required, hint, accept, errorMsg) %}
    <div class="bozp-form-row bozp-form-row--file{% if errorMsg %} bozp-form-row--error{% endif %}">
        {#        <span class="bozp-form-row__label">#}
        {#            {{ label }}#}
        {#            {% if required %}<span class="bozp-form-row__req">*</span>{% endif %}#}
        {#        </span>#}
        <span class="bozp-form__file-selected" data-file-empty-label="{{ 'Žiadne prílohy.'|t('bozp') }}">{{ 'Žiadne prílohy.'|t('bozp') }}</span>

        <div class="bozp-form__file">
            <span class="bozp-form__file-hint">{{ hint }}</span>
            <label class="bozp-form__file-trigger" for="{{ id }}">
                <svg class="bozp-form__file-icon" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 26">
                    <path fill="#4F2170" transform="translate(0.535156 0.760986)" d="M18.249035 8.4962654C19.109362 7.6256075 19.779554 6.800283 20.131506 5.6922946C20.612911 4.1749768 19.861811 2.258997 18.204536 1.8790008C17.039454 1.612337 15.754358 2.2523303 14.814472 2.8909903C13.053366 4.0896444 11.385303 5.2882986 9.8723154 6.7856164L2.6256166 13.950875C1.255567 16.10952 1.4982923 19.02549 3.2553539 20.838804C4.5310102 22.290789 6.2678447 22.466787 7.9439979 21.632128C9.9356937 20.640139 11.760179 19.453484 13.432286 17.9415L19.860462 12.130894C20.228596 11.796231 20.941938 11.688232 21.248041 11.90423C22.475153 12.773554 20.41873 14.412204 19.02306 15.672191L15.661314 18.706825C12.972457 21.136133 7.9332099 24.966761 4.6092215 23.776106C1.1746585 22.546785 -0.53520638 19.030823 0.14846988 15.537525C0.33321083 14.601535 0.5395273 13.597546 1.2636578 12.881553L9.6282415 4.6123056C10.814898 3.4403179 12.163373 2.546994 13.511847 1.604337C15.595239 0.14835219 18.220718 -0.76097167 20.212414 0.86301142C21.977566 2.3029964 22.448183 4.7043047 21.567631 6.8136163C21.095663 7.9469376 20.313549 8.8589277 19.442434 9.7482519L13.774799 15.528192C11.787148 17.556171 8.4092216 20.869471 6.0332103 19.565483C4.6307974 18.796158 4.0698323 16.872177 4.8222804 15.420193C5.5410171 14.032207 6.6993561 13.006885 7.8037562 11.886897C10.624763 9.0242596 13.46465 6.3642874 16.603897 3.8443136C16.852016 3.6443157 17.392756 3.6816487 17.541086 3.89498C17.684025 4.1003108 17.613905 4.5616398 17.417027 4.7736373C16.972031 5.2522988 16.617382 5.777627 16.173735 6.1736226L10.635551 11.122905C9.5554237 12.088228 8.5885687 13.070885 7.5718188 14.114874C7.0728836 14.628201 6.6481142 15.278861 6.2476177 15.898855C5.7958789 16.598848 5.9091506 17.688169 6.7087955 18.141499C7.8361197 18.780159 10.383387 16.417517 11.703543 15.104197L12.60702 14.205539L18.249035 8.4962654Z" fill-rule="evenodd"/>
                </svg>
                <span class="bozp-form__file-trigger-label">{{ 'Vybrať prílohu'|t('bozp') }}</span>
            </label>
            <input type="file"
                   id="{{ id }}"
                   name="{{ name }}"
                   class="bozp-form__file-input"
                   accept="{{ accept }}"
                   {% if required %}required{% endif %}
                    {% if errorMsg %}aria-invalid="true" aria-describedby="err-{{ id }}"{% endif %}>
        </div>
        {% if errorMsg %}
            <p class="bozp-form-row__error" id="err-{{ id }}">{{ errorMsg }}</p>
        {% endif %}
    </div>
{% endmacro %}

{% block title %}{{ permit.permitNumber }}{% endblock %}

{% block content %}
    <section class="bozp-page bozp-page--permit-detail">
        <header class="bozp-page__header">
            <p class="bozp-page__back ">
                <a href="{{ url('dashboard') }}">← {{ 'Moje permity'|t('bozp') }}</a>
            </p>
            <h1>{{ permit.permitNumber }}</h1>
            <div class="bozp-status__wrapper">
                <span class="bozp-status bozp-status--{{ permit.status }}">
                    {{ statusLabels[permit.status] ?? permit.status }}
                </span>
                <a href="{{ url('permits/' ~ permit.id ~ '/pdf') }}"
                   target="_blank"
                   rel="noopener"
                   class="bozp-btn bozp-btn--primary">
                    ⬇ {{ 'Zobraziť PDF'|t('bozp') }}
                </a>
            </>
        </header>

        {# ---- HSE decision banner ---- #}
        {% if permit.status == 'rejected' %}
            <div class="bozp-decision bozp-decision--rejected" role="alert">
                <h2>{{ 'Permit bol zamietnutý'|t('bozp') }}</h2>
                {% if permit.approvalComment %}
                    <p class="bozp-decision__comment">{{ permit.approvalComment|nl2br }}</p>
                {% endif %}
                <p class="bozp-decision__meta">
                    {%- if permit.rejectedAt -%}
                        {{ permit.rejectedAt|date('d.m.Y H:i') }}
                        {%- if approver %} · {{ approver.fullName ?: approver.username }}{% endif -%}
                    {%- endif -%}
                </p>
            </div>
        {% elseif permit.status == 'approved' %}
            <div class="bozp-decision bozp-decision--approved" role="status">
                <h2>{{ 'Permit bol schválený'|t('bozp') }}</h2>
                {% if permit.approvalComment %}
                    <p class="bozp-decision__comment">{{ permit.approvalComment|nl2br }}</p>
                {% endif %}
                <p class="bozp-decision__meta">
                    {%- if permit.approvedAt -%}
                        {{ permit.approvedAt|date('d.m.Y H:i') }}
                        {%- if approver %} · {{ approver.fullName ?: approver.username }}{% endif -%}
                    {%- endif -%}
                </p>
            </div>
        {% endif %}

        {# ---- Core details ---- #}
        <section class="bozp-detail-section bozp-detail-section--core">
            <div class="bozp-detail-list">
            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Dodávateľ'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.contractorCompany ?: '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Kontaktná osoba'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.contractorPersonName ?: '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'E-mail'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">
                    {%- if permit.contractorEmail -%}
                        <a href="mailto:{{ permit.contractorEmail }}">{{ permit.contractorEmail }}</a>
                    {%- else -%}—{%- endif -%}
                </div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Miesto výkonu'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.workLocation ?: '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Popis prác'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.workOverview|nl2br ?: '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Platnosť od'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.validFrom ? permit.validFrom|date('d.m.Y') : '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Platnosť do'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.validTo ? permit.validTo|date('d.m.Y H:i') : '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Zóny'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">
                    {%- if (zones ?? [])|length > 0 -%}
                        {% for zone in (zones ?? []) %}
                            <span class="bozp-tag">{{ zone.name }}{% if zone.code %} ({{ zone.code }}){% endif %}</span>
                        {% endfor %}
                    {%- else -%}—{%- endif -%}
                </div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Vytvorené'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.dateCreated|date('d.m.Y H:i') }}</div>
            </div>

            {% if permit.submittedAt %}
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Odoslané'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ permit.submittedAt|date('d.m.Y H:i') }}</div>
                </div>
            {% endif %}
        </div>
        </section>

        {# ---- Preparation checks ---- #}
        <section class="bozp-detail-section bozp-detail-section--prep">
            <h2>{{ 'Príprava pracoviska'|t('bozp') }}</h2>
            <div class="bozp-detail-list">
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Sú pracovné podmienky vhodné na vykonávanie prác?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.conditionsSuitable) }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Je náradie a vybavenie v dobrom technickom stave?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.toolsInGoodCondition) }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Existujú podmienky, pri ktorých je nutné práce zastaviť?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.hasStopConditions) }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Popis podmienok pre zastavenie prác'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ permit.stopConditionsDescription ? permit.stopConditionsDescription|nl2br : '—' }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Je zavedený LOTO (uzamknutie / označenie)?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.lotoImplemented) }}</div>
                </div>

                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Núdzový plán / postup v prípade mimoriadnej udalosti'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ permit.emergencyPlan ? permit.emergencyPlan|nl2br : '—' }}</div>
                </div>
            </div>
        </section>

        {# ---- Hazards matrix ---- #}
        <section class="bozp-detail-section bozp-detail-section--hazards">
            <h2>{{ 'Riziká a OOPP'|t('bozp') }}</h2>
            {% set hasHazards = hazards is defined and (hazards ?? [])|length > 0 %}
            {% if not hasHazards %}
                <p class="bozp-empty">{{ 'Neboli uvedené žiadne riziká.'|t('bozp') }}</p>
            {% else %}
                <div class="bozp-hazards">
                    <table class="bozp-table">
                        <thead>
                            <tr>
                                <th>{{ 'Riziko'|t('bozp') }}</th>
                                <th>{{ 'Exponovaný?'|t('bozp') }}</th>
                                <th>{{ 'Opatrenie / OOPP'|t('bozp') }}</th>
                                <th>{{ 'Kontrola počas činnosti'|t('bozp') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for cat in (hazardCategories ?? []) %}
                                {% set row = hazards[cat.value] ?? null %}
                                {% if row %}
                                    <tr>
                                        <th scope="row">
                                            <div class="label_wrapper">
                                                <img src="/assets/icons/PPE{{ loop.index }}.png" alt="Icon">
                                                {{ cat.label()|t('bozp') }}
                                            </div>
                                        </th>
                                        <td>{{ _self.yn(row.exposed) }}</td>
                                        <td>{{ row.measure ? row.measure|nl2br : '—' }}</td>
                                        <td>
                                            {%- if row.controlDuringActivity -%}
                                                {{ controlLabels[row.controlDuringActivity] ?? row.controlDuringActivity }}
                                                {%- if row.controlDuringActivityOther -%}
                                                    <br><span class="bozp-muted">{{ row.controlDuringActivityOther }}</span>
                                                {%- endif -%}
                                            {%- else -%}—{%- endif -%}
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        {# ---- High-risk subpermits ---- #}
        {# Build lookup maps from the SubpermitType enum cases passed by the controller #}
        {% set spLabelMap = {} %}
        {% set spAppendixMap = {} %}
        {% if (subpermitTypes ?? [])|length > 0 %}
            {% for t in (subpermitTypes ?? []) %}
                {% set spLabelMap = spLabelMap|merge({(t.value): t.label()}) %}
                {% set spAppendixMap = spAppendixMap|merge({(t.value): t.appendixNumber()}) %}
            {% endfor %}
        {% endif %}

        {# Subpermits section is always rendered — subpermits can be added
           after permit creation, including for permits where no subpermits
           were initially selected. Adding is blocked once the parent permit
           reaches a terminal state (closed / cancelled / expired). #}
        {% set subpermitAddingLocked = permit.status in ['closed', 'cancelled', 'expired'] %}
        <section class="bozp-detail-section bozp-detail-section--subpermits">
                <div class="bozp-detail-section__header">
                    <h2>{{ 'Subpermity zvýšeného rizika'|t('bozp') }}</h2>
                    {% if isIssuer is defined and isIssuer %}
                        {% if subpermitAddingLocked %}
                            <button type="button"
                                    class="bozp-btn bozp-btn--primary bozp-btn--sm"
                                    disabled
                                    aria-disabled="true"
                                    title="{{ 'Permit je uzavretý — pridanie subpermitu nie je možné.'|t('bozp') }}">
                                + {{ 'Pridať subpermit'|t('bozp') }}
                            </button>
                        {% else %}
                            <a href="{{ url('permits/' ~ permit.id ~ '/subpermits/new') }}"
                               class="bozp-btn bozp-btn--primary bozp-btn--sm">
                                + {{ 'Pridať subpermit'|t('bozp') }}
                            </a>
                        {% endif %}
                    {% endif %}
                </div>

                {% if (subpermits ?? [])|length == 0 %}
                    <p class="bozp-empty">{{ 'Zatiaľ neboli pridané žiadne subpermity.'|t('bozp') }}</p>
                {% else %}
                    <table class="bozp-table bozp-subpermits-table">
                        <thead>
                            <tr>
                                <th>{{ 'Príloha'|t('bozp') }}</th>
                                <th>{{ 'Typ'|t('bozp') }}</th>
                                <th>{{ 'Miesto'|t('bozp') }}</th>
                                <th>{{ 'Dátum'|t('bozp') }}</th>
                                <th>{{ 'Stav'|t('bozp') }}</th>
                                <th>{{ 'Platnosť do'|t('bozp') }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for sp in (subpermits ?? []) %}
                                {% set spData = sp.data is string ? sp.data|json_decode : (sp.data ?? {}) %}
                                <tr>
                                    <td>
                                        {% if spAppendixMap[sp.type] is defined %}
                                            {{ 'č. {n}'|t('bozp', {n: spAppendixMap[sp.type]}) }}
                                        {% else %}
                                            {{ sp.type }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ spLabelMap[sp.type] ?? sp.type }}
                                        {% if sp.type in requiredSubpermitTypes and sp.status != 'approved' %}
                                             - <span class="bozp-badge--required" title="{{ 'Vyžadovaný'|t('bozp') }}">{{ 'Vyžadovaný'|t('bozp') }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ spData.placeOfWork ?? '—' }}</td>
                                    <td>{{ spData.date ? spData.date|date('d.m.Y') : sp.dateCreated|date('d.m.Y') }}</td>
                                    <td>
                                        <span class="bozp-status bozp-status--{{ sp.status }}">
                                            {{ sp.status|t('bozp') }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if sp.status == 'approved' and sp.expiresAt %}
                                            {{ sp.expiresAt|date('d.m.Y H:i') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ url('permits/' ~ permit.id ~ '/subpermits/' ~ sp.id) }}"
                                           class="bozp-link">{{ 'Detail'|t('bozp') }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {# Missing required subpermits warning #}
                {% set missingTypes = [] %}
                {% for typeValue in (requiredSubpermitTypes ?? []) %}
                    {% set hasApproved = false %}
                    {% for sp in (subpermits ?? []) %}
                        {% if sp.type == typeValue and sp.status == 'approved' %}
                            {% set hasApproved = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not hasApproved %}
                        {% set missingTypes = missingTypes|merge([spLabelMap[typeValue] ?? typeValue]) %}
                    {% endif %}
                {% endfor %}
                {% if missingTypes|length > 0 %}
                    <div class="bozp-alert bozp-alert--warning" style="margin-top:12px">
                        <strong>{{ 'Chýbajúce schválené subpermity'|t('bozp') }}:</strong>
                        {{ missingTypes|join(', ') }}
                    </div>
                {% endif %}
            </section>

        {# ---- Attachments (list + upload form for issuer) ---- #}
        <section class="bozp-detail-section bozp-detail-section--attachments">
            <h2>{{ 'Prílohy'|t('bozp') }}</h2>
            {% if (attachments ?? [])|length == 0 %}
                <div class="bozp-empty">
                    <img src="/assets/svg/noFile.svg" alt="No file">
                    <span>{{ 'Žiadne prílohy.'|t('bozp') }}</span>
                </div>
            {% else %}
                <ul class="bozp-attachments">
                    {% for a in (attachments ?? []) %}
                        {% set asset = craft.assets().id(a.assetId).one() %}
                        <li>
                            {% if asset %}
                                <a href="{{ asset.url }}" target="_blank" rel="noopener">{{ asset.filename }}</a>
                            {% else %}
                                <span class="bozp-attachments__missing">{{ 'Súbor nie je dostupný'|t('bozp') }}</span>
                            {% endif %}
                            <span class="bozp-attachments__meta">
                                · {{ a.uploadedByName ?: '—' }} · {{ a.dateCreated|date('d.m.Y H:i') }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if isIssuer is defined and isIssuer %}
                <form method="post"
                      action="{{ url('permits/' ~ permit.id ~ '/upload') }}"
                      enctype="multipart/form-data"
                      class="bozp-form bozp-form--upload"
                      novalidate>
                    {{ csrfInput() }}
                    <input type="hidden" name="action" value="bozp/permits/upload-attachment">

                    {{ _self.file_picker(
                        'attachment',
                        'issuer-attachment',
                        'Príloha'|t('bozp'),
                        true,
                        'Nahrať prílohu (PDF, DOCX, JPG, PNG, max 10 MB)'|t('bozp'),
                        '.pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png',
                        null
                    ) }}

                    <div class="bozp-form__actions">
                        <button type="submit" class="bozp-btn bozp-btn--primary">
                            {{ 'Nahrať'|t('bozp') }}
                        </button>
                    </div>
                </form>
            {% endif %}
        </section>

        {# ---- Issuer closure / cancel ---- #}
        {% if isIssuer is defined and isIssuer and (canCancel or canClose or issuerClosureSignature) %}
            <section class="bozp-detail-section bozp-detail-section--issuer-closure">
                <h2>{{ 'Uzavretie permitu'|t('bozp') }}</h2>

                {% if issuerClosureSignature %}
                    {% set sigAsset = craft.assets().id(issuerClosureSignature.signatureAssetId).one() %}
                    <div class="bozp-signature bozp-signature--signed">
                        <div class="bozp-detail-list bozp-signature__meta">
                            <div class="bozp-detail-row">
                                <div class="bozp-detail-row__label">{{ 'Stav'|t('bozp') }}</div>
                                <div class="bozp-detail-row__value">
                                    {% if permit.issuerClosureStatus == 'work_canceled_equipment_isolated' %}
                                        {{ 'Práca zrušená / pozastavená'|t('bozp') }}
                                    {% elseif permit.issuerClosureStatus == 'work_completed_loto_removed' %}
                                        {{ 'Práce dokončené, LOTO odstránené'|t('bozp') }}
                                    {% else %}
                                        {{ permit.issuerClosureStatus ?: '—' }}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="bozp-detail-row">
                                <div class="bozp-detail-row__label">{{ 'Podpísal'|t('bozp') }}</div>
                                <div class="bozp-detail-row__value">{{ issuerClosureSignature.signerName }}</div>
                            </div>
                            <div class="bozp-detail-row">
                                <div class="bozp-detail-row__label">{{ 'Dátum podpisu'|t('bozp') }}</div>
                                <div class="bozp-detail-row__value">{{ issuerClosureSignature.signatureDate ? issuerClosureSignature.signatureDate|date('d.m.Y') : '—' }}</div>
                            </div>
                            {% if permit.requiresTrialOperation is not null %}
                                <div class="bozp-detail-row">
                                    <div class="bozp-detail-row__label">{{ 'Vyžaduje sa skúšobná prevádzka'|t('bozp') }}</div>
                                    <div class="bozp-detail-row__value">{{ permit.requiresTrialOperation ? 'Áno'|t('bozp') : 'Nie'|t('bozp') }}</div>
                                </div>
                            {% endif %}
                        </div>
                        {% if sigAsset %}
                            <div class="bozp-detail-row">
                                <div class="bozp-detail-row__label">{{ 'Podpis'|t('bozp') }}</div>
                                <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                     class="bozp-signature__image"
                                     style="max-width:360px;max-height:140px;border:1px solid #ddd;background:#fff;">
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    {% set hasContractorClosure = recipientClosureSignature is defined and recipientClosureSignature %}

                    {% if not hasContractorClosure %}
                        <p class="bozp-empty">
                            {{ 'Dodávateľ ešte nepodpísal dokončenie. Permit bude možné uzavrieť po jeho podpise.'|t('bozp') }}
                        </p>
                    {% endif %}

                    <div class="bozp-issuer-actions" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px;">
                        {% if canCancel %}
                            <button type="button" class="bozp-btn bozp-btn--cancel"
                                    data-bozp-dialog-open="bozp-dialog-issuer-cancel"
                                    style="background:#cf2929;color:#fff;border-color:#cf2929;">
                                {{ 'Zrušiť permit'|t('bozp') }}
                            </button>
                        {% endif %}
                        {% if canClose %}
                            <button type="button" class="bozp-btn bozp-btn--approve"
                                    data-bozp-dialog-open="bozp-dialog-issuer-close">
                                {{ 'Uzavrieť permit'|t('bozp') }}
                            </button>
                        {% endif %}
                    </div>

                    {% if canCancel %}
                        {% set ce = cancelErrors ?? {} %}
                        {% set cv = cancelValues ?? {} %}
                        {% set cancelExtra %}
                            <div class="bozp-form-row{% if ce.reason is defined %} bozp-form-row--error{% endif %}">
                                <label>{{ 'Dôvod zrušenia'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                                <textarea name="reason" rows="3" required>{{ cv.reason ?? '' }}</textarea>
                                {% if ce.reason is defined %}
                                    <p class="bozp-form-row__error">{{ ce.reason }}</p>
                                {% endif %}
                            </div>
                        {% endset %}

                        {% include 'bozp/site/_sign-dialog.twig' with {
                            id: 'bozp-dialog-issuer-cancel',
                            action: url('permits/' ~ permit.id ~ '/cancel'),
                            openOnLoad: ce|length > 0,
                            title: 'Zrušenie permitu'|t('bozp'),
                            intro: 'Permit bude označený ako zrušený. Práca, na ktorú sa vzťahuje, je zrušená alebo pozastavená a zariadenie zostáva izolované.'|t('bozp'),
                            warning: 'Po podpise sa permit uzamkne ako zrušený a údaje nie je možné meniť.'|t('bozp'),
                            submitLabel: 'Zrušiť a podpísať'|t('bozp'),
                            showEmployer: false,
                            errors: ce,
                            values: cv,
                            extraFields: cancelExtra,
                        } only %}
                    {% endif %}

                    {% if canClose %}
                        {% set xe = closeErrors ?? {} %}
                        {% set xv = closeValues ?? {} %}
                        {% set closeExtra %}
                            <div class="bozp-form-row">
                                <label>{{ 'Vyžaduje sa skúšobná prevádzka?'|t('bozp') }}</label>
                                <label class="bozp-form__radio" style="display:inline-flex;gap:6px;align-items:center;margin-right:16px;">
                                    <input type="radio" name="requiresTrialOperation" value="yes"
                                           {% if (xv.requiresTrialOperation ?? 'no') == 'yes' %}checked{% endif %}>
                                    <span>{{ 'Áno'|t('bozp') }}</span>
                                </label>
                                <label class="bozp-form__radio" style="display:inline-flex;gap:6px;align-items:center;">
                                    <input type="radio" name="requiresTrialOperation" value="no"
                                           {% if (xv.requiresTrialOperation ?? 'no') == 'no' %}checked{% endif %}>
                                    <span>{{ 'Nie'|t('bozp') }}</span>
                                </label>
                            </div>
                        {% endset %}

                        {% include 'bozp/site/_sign-dialog.twig' with {
                            id: 'bozp-dialog-issuer-close',
                            action: url('permits/' ~ permit.id ~ '/close'),
                            openOnLoad: xe|length > 0,
                            title: 'Uzavretie permitu'|t('bozp'),
                            intro: 'Práce, na ktoré sa vzťahuje toto povolenie, sú dokončené. Všetky LOTO zámky a štítky, izolácie atď. boli odstránené a zariadenie je vhodné na návrat do prevádzky.'|t('bozp'),
                            warning: 'Po podpise sa permit uzamkne ako uzavretý a údaje nie je možné meniť.'|t('bozp'),
                            submitLabel: 'Uzavrieť a podpísať'|t('bozp'),
                            showEmployer: false,
                            errors: xe,
                            values: xv,
                            extraFields: closeExtra,
                        } only %}
                    {% endif %}

                    {% if canCancel or canClose %}
                        <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
                        <script>
                            (function () {
                                document.querySelectorAll('[data-bozp-dialog-open]').forEach(function (btn) {
                                    btn.addEventListener('click', function () {
                                        var d = document.getElementById(btn.getAttribute('data-bozp-dialog-open'));
                                        if (d) bozpOpenDialog(d, 'warning');
                                    });
                                });

                                document.querySelectorAll('.bozp-sign-dialog').forEach(function (dialog) {
                                    var stages = dialog.querySelectorAll('.bozp-dialog__stage');
                                    var canvas = dialog.querySelector('canvas[data-bozp-sigpad]');
                                    var hidden = dialog.querySelector('input[name="signatureData"]');
                                    var clearBtn = dialog.querySelector('[data-bozp-sigpad-clear]');
                                    var cancelBtn = dialog.querySelector('[data-bozp-action="cancel"]');
                                    var proceedBtn = dialog.querySelector('[data-bozp-action="proceed"]');
                                    var backBtn = dialog.querySelector('[data-bozp-action="back"]');
                                    var pad = null;

                                    function showStage(name) {
                                        stages.forEach(function (s) {
                                            s.hidden = (s.getAttribute('data-stage') !== name);
                                        });
                                        if (name === 'form') {
                                            window.requestAnimationFrame(initPad);
                                        }
                                    }

                                    function initPad() {
                                        if (!window.SignaturePad || !canvas) { return; }
                                        if (!pad) {
                                            pad = new SignaturePad(canvas, {
                                                backgroundColor: 'rgba(255,255,255,1)',
                                                penColor: '#000',
                                            });
                                        }
                                        var ratio = Math.max(window.devicePixelRatio || 1, 1);
                                        canvas.width = canvas.offsetWidth * ratio;
                                        canvas.height = canvas.offsetHeight * ratio;
                                        canvas.getContext('2d').scale(ratio, ratio);
                                        pad.clear();
                                    }

                                    if (cancelBtn) cancelBtn.addEventListener('click', function () { dialog.close(); });
                                    if (proceedBtn) proceedBtn.addEventListener('click', function () { showStage('form'); });
                                    if (backBtn) backBtn.addEventListener('click', function () { showStage('warning'); });
                                    if (clearBtn) clearBtn.addEventListener('click', function () { if (pad) pad.clear(); });

                                    dialog.bozpShowStage = showStage;

                                    var form = dialog.querySelector('form');
                                    if (form) {
                                        form.addEventListener('submit', function () {
                                            if (hidden) hidden.value = (pad && !pad.isEmpty()) ? pad.toDataURL('image/png') : '';
                                        });
                                    }

                                    var openOnLoad = dialog.getAttribute('data-open-on-load');
                                    if (openOnLoad) bozpOpenDialog(dialog, openOnLoad);
                                });

                                function bozpOpenDialog(dialog, initialStage) {
                                    if (dialog.bozpShowStage) dialog.bozpShowStage(initialStage || 'warning');
                                    if (typeof dialog.showModal === 'function') dialog.showModal();
                                    else dialog.setAttribute('open', '');
                                }
                                window.bozpOpenDialog = bozpOpenDialog;
                            })();
                        </script>
                    {% endif %}
                {% endif %}
            </section>
        {% endif %}

        {# ---- Recipient closure (read-only display) ---- #}
        {% if recipientClosureSignature is defined and recipientClosureSignature %}
            <section class="bozp-detail-section bozp-detail-section--recipient-closure">
                <h2>{{ 'Dokončenie dodávateľa'|t('bozp') }}</h2>
                {% set sigAsset = craft.assets().id(recipientClosureSignature.signatureAssetId).one() %}
                <div class="bozp-signature bozp-signature--signed">
                    {% set flags = permit.recipientClosureStatus ?? [] %}
                    {% if flags is iterable and flags|length > 0 %}
                        {% set rcLabels = {
                            'work_completed': 'Práce boli dokončené'|t('bozp'),
                            'equipment_operational': 'Zariadenie je prevádzkyschopné'|t('bozp'),
                            'equipment_not_operational': 'Zariadenie nie je prevádzkyschopné'|t('bozp'),
                            'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené'|t('bozp'),
                            'work_suspended': 'Práce boli pozastavené'|t('bozp'),
                        } %}
                        <ul class="bozp-closure__flags">
                            {% for f in flags %}
                                <li>✓ {{ rcLabels[f] ?? f }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    <div class="bozp-detail-list bozp-signature__meta">
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Podpísal'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ recipientClosureSignature.signerName }}</div>
                        </div>
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Dátum podpisu'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ recipientClosureSignature.signatureDate ? recipientClosureSignature.signatureDate|date('d.m.Y') : '—' }}</div>
                        </div>
                    </div>
                    {% if sigAsset %}
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Podpis'|t('bozp') }}</div>
                            <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                 class="bozp-signature__image"
                                 style="max-width:360px;max-height:140px;border:1px solid #ddd;background:#fff;">
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {# ---- Control visits ---- #}
        {% if (controls ?? [])|length > 0 %}
            {% set resultLabels = {
                'ok':      'V poriadku'|t('bozp'),
                'issues':  'Zistené nedostatky'|t('bozp'),
                'stopped': 'Práce zastavené'|t('bozp'),
            } %}
            {% set resultColors = {'ok': '#16a34a', 'issues': '#d97706', 'stopped': '#dc2626'} %}
            <section class="bozp-detail-section bozp-detail-section--controls">
                <h2>{{ 'Kontroly prevádzky'|t('bozp') }}</h2>
                <table style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:2px solid #e3e5e8;">
                            <th style="text-align:left;padding:8px 10px;">{{ 'Dátum a čas'|t('bozp') }}</th>
                            <th style="text-align:left;padding:8px 10px;">{{ 'Kontrolór'|t('bozp') }}</th>
                            <th style="text-align:left;padding:8px 10px;">{{ 'Výsledok'|t('bozp') }}</th>
                            <th style="text-align:left;padding:8px 10px;">{{ 'Poznámka'|t('bozp') }}</th>
                            <th style="text-align:left;padding:8px 10px;">{{ 'Podpis'|t('bozp') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in (controls ?? []) %}
                            <tr style="border-bottom:1px solid #f0f0f0;">
                                <td style="padding:8px 10px;vertical-align:top;">{{ c.controlledAt|date('d.m.Y H:i') }}</td>
                                <td style="padding:8px 10px;vertical-align:top;">{{ c.controllerName }}</td>
                                <td style="padding:8px 10px;vertical-align:top;">
                                    <span style="display:inline-block;padding:2px 8px;border-radius:10px;background:{{ resultColors[c.result] ?? '#6b7280' }};color:#fff;font-size:.8em;font-weight:600;">
                                        {{ resultLabels[c.result] ?? c.result }}
                                    </span>
                                </td>
                                <td style="padding:8px 10px;vertical-align:top;">
                                    {% if c.notes %}
                                        <p style="margin:4px 0 0;font-size:.85em;color:#555;">{{ c.notes }}</p>
                                    {% endif %}
                                </td>
                                <td style="padding:8px 10px;vertical-align:top;">
                                    {% if c.signatureAssetId %}
                                        {% set sigAsset = craft.assets().id(c.signatureAssetId).one() %}
                                        {% if sigAsset %}
                                            <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                                 style="max-width:160px;max-height:60px;border:1px solid #eee;background:#fff;display:block;">
                                        {% endif %}
                                    {% else %}
                                        <span style="color:#999;font-size:.85em;">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endif %}

        {# ---- Audit trail ---- #}
        {% if (auditEntries ?? [])|length > 0 %}
            <section class="bozp-audit">
                <h2>{{ 'História'|t('bozp') }}</h2>
                <ol class="bozp-audit__list">
                    {% for entry in (auditEntries ?? []) %}
                        <li class="bozp-audit__entry">
                            <time>{{ entry.dateCreated|date('d.m.Y H:i') }}</time>
                            <code>{{ entry.action }}</code>
                            {% if entry.fromStatus or entry.toStatus %}
                                <span class="bozp-audit__transition">
                                    {{ entry.fromStatus ?: '—' }} → {{ entry.toStatus ?: '—' }}
                                </span>
                            {% endif %}
                            {% set p = entry.payload %}
                            {% if p is iterable and p.note is defined %}
                                <p class="bozp-audit__note">{{ p.note }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </section>
        {% endif %}
    </section>

    <script>
    // Display selected filename next to the .bozp-form__file-trigger.
    document.querySelectorAll('.bozp-form__file-input').forEach(function (input) {
        input.addEventListener('change', function () {
            var label = input.closest('.bozp-form-row--file').querySelector('.bozp-form__file-selected');
            if (!label) return;
            if (input.files && input.files.length > 0) {
                label.textContent = input.files[0].name;
            } else {
                label.textContent = label.getAttribute('data-file-empty-label') || '';
            }
        });
    });
    </script>
{% endblock %}
