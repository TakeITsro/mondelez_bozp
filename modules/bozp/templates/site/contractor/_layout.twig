{# Stripped-down layout for the contractor-facing pages. No login link,
   no navigation — the contractor isn't a Craft user and doesn't have a
   way (or reason) to navigate around the rest of the site. #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'Permit'|t('bozp') }}{% endblock %} — Mondelez</title>
    {% block head %}{% endblock %}
</head>
<body class="bozp bozp--contractor">
    <header class="bozp-header bozp-header--contractor">
        <div class="bozp-header__inner">
            <span class="bozp-header__brand">{{ 'BOZP Permity'|t('bozp') }}</span>
        </div>
    </header>

    <main class="bozp-main">
        {% set notice = craft.app.session.getFlash('notice') %}
        {% set error = craft.app.session.getFlash('error') %}

        {% if notice %}
            <div class="bozp-flash bozp-flash--notice" role="status">{{ notice }}</div>
        {% endif %}
        {% if error %}
            <div class="bozp-flash bozp-flash--error" role="alert">{{ error }}</div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <footer class="bozp-footer">
        <small>Mondelez SR Production · BOZP Permity</small>
    </footer>

    <style>
        :root{--main-color:#4F2170;--main-color-light:#FEFFFD;--main-color-dark:#000000;--form-input-border:#200633;--form-input-bg:#653489}@font-face{font-family:"Mondelez";src:url(/assets/font/mondelez_font.TTF)format("truetype");font-weight:400;font-style:normal;font-display:swap}*{position:relative;box-sizing:border-box;font-family:"Mondelez",Arial,Helvetica,sans-serif;font-weight:400;outline:0;margin:0;padding:0;-webkit-tap-highlight-color:transparent}input,select,textarea{background-color:transparent;border-radius:0;border:0}a{color:#000;text-decoration:none}ul{list-style-type:none}button{border:0;background:0 0}.bozp-header .bozp-header__inner .bozp-header__nav a,p{color:var(--main-color-dark);font-size:1.25em;font-weight:400;line-height:1.2em;text-transform:uppercase}.bozp,.bozp .bozp-main,.bozp .bozp-main .bozp-page{display:flex;flex-direction:column;align-items:center}.bozp{font-size:16px;background-color:var(--background-color-light);overflow:hidden auto}.bozp .bozp-main,.bozp .bozp-main .bozp-page{width:100%}.bozp .bozp-main .bozp-flash{position:absolute;top:0;color:var(--main-color-light);font-size:1.75em;font-weight:400;line-height:1.2em;text-transform:uppercase;padding:1em 1.42em;z-index:100}.bozp .bozp-main .bozp-flash.bozp-flash--notice{background-color:green}.bozp .bozp-main .bozp-flash.bozp-flash--error{background-color:red}.bozp,.bozp-header{width:100%}.bozp-header .bozp-header__user{width:100%;display:flex;align-items:center;justify-content:flex-end;gap:1.25em;padding:.625em 5em}.bozp-header .bozp-header__inner{display:flex;align-items:center;gap:1.25em;background-image:url(/assets/svg/header_bg.svg);padding:2.5em 5em}.bozp-header .bozp-header__inner .bozp-header__brand svg{height:3.75em}.bozp-header .bozp-header__inner .bozp-header__brand svg path,.bozp-page--contractor-auth .bozp-login .bozp-login__logo svg path,.bozp-page--login .bozp-login .bozp-login__logo svg path{fill:var(--main-color-light)}.bozp-footer,.bozp-header .bozp-header__inner .