{% extends 'bozp/site/contractor/_layout.twig' %}

{# Read-only contractor view of the permit + an upload form for
   supplementary documents (risk assessments, photos, evidence).

   Markup uses the project conventions documented in HANDOUT.md:
     - bozp-detail-section / __title / __subtitle
     - bozp-detail-list / bozp-detail-row / __label / __value
     - bozp-form-section / __title / __hint
     - bozp-form-row / __label / __error / __req
     - bozp-form__yesno / __yesno-opt / __checklist / __check / __radio
   No inline `style=""` — all styling lives in the project CSS. #}

{% set controlLabels = {
    'used': 'V používaní'|t('bozp'),
    'not_used': 'Nepoužíva sa'|t('bozp'),
    'other': 'Iné'|t('bozp'),
} %}

{% macro yn(value) %}
    {% if value is null %}
        —
    {% elseif value %}{{ 'Áno'|t('bozp') }}{% else %}{{ 'Nie'|t('bozp') }}{% endif %}
{% endmacro %}

{% block title %}{{ 'Permit {n}'|t('bozp', {n: permit.permitNumber}) }}{% endblock %}

{% block content %}
    <section class="bozp-page bozp-page--contractor-detail">

        <header class="bozp-detail__header">
            <div class="bozp-detail__header-row">
                <div class="bozp-detail__header-title">
                    <h1>{{ 'Permit {n}'|t('bozp', {n: permit.permitNumber}) }}</h1>
                    <p class="bozp-detail__status">
                        <strong>{{ 'Stav'|t('bozp') }}:</strong> {{ permit.status }}
                    </p>
                </div>
                <a href="{{ url('bozp/c/' ~ token ~ '/pdf') }}"
                   target="_blank" rel="noopener"
                   class="bozp-btn bozp-btn--secondary bozp-btn--sm bozp-btn--pdf">
                    ⬇ {{ 'Zobraziť PDF'|t('bozp') }}
                </a>
            </div>
            {% if permit.validTo %}
                {% set isExpired = permit.validTo|date('U') < 'now'|date('U') %}
                {% if isExpired %}
                    <div class="bozp-alert bozp-alert--danger">
                        ⛔ {{ 'Platnosť tohto permitu vypršala'|t('bozp') }}
                        ({{ permit.validTo|date('d.m.Y H:i') }}).
                        {{ 'Práce nesmú pokračovať.'|t('bozp') }}
                    </div>
                {% else %}
                    <div class="bozp-alert bozp-alert--success">
                        ✓ {{ 'Permit je platný do'|t('bozp') }}
                        <strong>{{ permit.validTo|date('d.m.Y H:i') }}</strong>.
                    </div>
                {% endif %}
            {% endif %}
        </header>

        <div class="bozp-detail-list">
            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Dodávateľ'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">
                    {{ permit.contractorCompany ?: '—' }}
                    {% if permit.contractorPersonName %}({{ permit.contractorPersonName }}){% endif %}
                </div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Miesto výkonu'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.workLocation ?: '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Platnosť od'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.validFrom ? permit.validFrom|date('d.m.Y') : '—' }}</div>
            </div>

            <div class="bozp-detail-row">
                <div class="bozp-detail-row__label">{{ 'Platnosť do'|t('bozp') }}</div>
                <div class="bozp-detail-row__value">{{ permit.validTo ? permit.validTo|date('d.m.Y H:i') : '—' }}</div>
            </div>
        </div>

        {% if permit.workOverview %}
            <section class="bozp-detail-section">
                <h2 class="bozp-detail-section__title">{{ 'Popis prác'|t('bozp') }}</h2>
                <p>{{ permit.workOverview|nl2br }}</p>
            </section>
        {% endif %}

        {% if zones is not empty %}
            <section class="bozp-detail-section">
                <h2 class="bozp-detail-section__title">{{ 'Zóny'|t('bozp') }}</h2>
                <ul class="bozp-detail__list">
                    {% for z in zones %}
                        <li>{{ z.name }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section class="bozp-detail-section">
            <h2 class="bozp-detail-section__title">{{ 'Príprava pracoviska'|t('bozp') }}</h2>
            <div class="bozp-detail-list">
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Sú pracovné podmienky vhodné na vykonávanie prác?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.conditionsSuitable) }}</div>
                </div>
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Je náradie a vybavenie v dobrom technickom stave?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.toolsInGoodCondition) }}</div>
                </div>
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Existujú podmienky, pri ktorých je nutné práce zastaviť?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.hasStopConditions) }}</div>
                </div>
                {% if permit.stopConditionsDescription %}
                    <div class="bozp-detail-row">
                        <div class="bozp-detail-row__label">{{ 'Popis podmienok pre zastavenie prác'|t('bozp') }}</div>
                        <div class="bozp-detail-row__value">{{ permit.stopConditionsDescription|nl2br }}</div>
                    </div>
                {% endif %}
                <div class="bozp-detail-row">
                    <div class="bozp-detail-row__label">{{ 'Je zavedený LOTO (uzamknutie / označenie)?'|t('bozp') }}</div>
                    <div class="bozp-detail-row__value">{{ _self.yn(permit.lotoImplemented) }}</div>
                </div>
                {% if permit.emergencyPlan %}
                    <div class="bozp-detail-row">
                        <div class="bozp-detail-row__label">{{ 'Núdzový plán / postup v prípade mimoriadnej udalosti'|t('bozp') }}</div>
                        <div class="bozp-detail-row__value">{{ permit.emergencyPlan|nl2br }}</div>
                    </div>
                {% endif %}
            </div>
        </section>

        <section class="bozp-detail-section">
            <h2 class="bozp-detail-section__title">{{ 'Riziká a OOPP'|t('bozp') }}</h2>
            <table class="bozp-hazards">
                <thead>
                    <tr>
                        <th>{{ 'Kategória'|t('bozp') }}</th>
                        <th>{{ 'Vystavený'|t('bozp') }}</th>
                        <th>{{ 'Opatrenie / OOPP'|t('bozp') }}</th>
                        <th>{{ 'Kontrola počas činnosti'|t('bozp') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cat in hazardCategories %}
                        {% set h = hazards[cat.value] ?? null %}
                        <tr>
                            <th scope="row">{{ cat.label()|t('bozp') }}</th>
                            <td>{{ h ? _self.yn(h.exposed) : '—' }}</td>
                            <td>{{ h and h.measure ? h.measure|nl2br : '—' }}</td>
                            <td>
                                {% if h and h.controlDuringActivity %}
                                    {{ controlLabels[h.controlDuringActivity] ?? h.controlDuringActivity }}
                                    {% if h.controlDuringActivity == 'other' and h.controlDuringActivityOther %}
                                        — {{ h.controlDuringActivityOther }}
                                    {% endif %}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        {# ---------- Approved subpermits — contractor must sign each ------- #}
        {% if subpermits is defined and subpermits|length > 0 %}
            <section class="bozp-detail-section bozp-detail-section--subpermits">
                <h2 class="bozp-detail-section__title">{{ 'Subpermity zvýšeného rizika'|t('bozp') }}</h2>
                <p class="bozp-detail-section__hint">
                    {{ 'Pred začatím prác musíte podpísať každý schválený subpermit.'|t('bozp') }}
                </p>

                {# Build label/appendix lookup maps from SubpermitType enum cases #}
                {% set spLabelMap = {} %}
                {% set spAppendixMap = {} %}
                {% for t in subpermitTypes %}
                    {% set spLabelMap = spLabelMap|merge({(t.value): t.label()}) %}
                    {% set spAppendixMap = spAppendixMap|merge({(t.value): t.appendixNumber()}) %}
                {% endfor %}

                {% for sp in subpermits %}
                    {% set spSigs = subpermitSignatures[sp.id] ?? {} %}
                    {% set contractorSig = spSigs['contractor'] ?? null %}
                    {# Closure signature: prefer new 'issuer_closure' role, fall back to legacy 'issuer'. #}
                    {% set issuerSig = spSigs['issuer_closure'] ?? (spSigs['issuer'] ?? null) %}
                    {% set issuerPreworkSig = spSigs['issuer_prework'] ?? null %}
                    {% set contractorPreworkSig = spSigs['contractor_prework'] ?? null %}
                    {% set preworkComplete = issuerPreworkSig and contractorPreworkSig %}
                    {% set spData = sp.data is string ? sp.data|json_decode : (sp.data ?? {}) %}

                    <article class="bozp-subpermit-card">
                        <header class="bozp-subpermit-card__head">
                            <div class="bozp-subpermit-card__title-block">
                                <span class="bozp-subpermit-card__appendix">
                                    {{ 'Príloha č. {n}'|t('bozp', {n: spAppendixMap[sp.type] ?? '?'}) }}
                                </span>
                                <strong class="bozp-subpermit-card__type">{{ spLabelMap[sp.type] ?? sp.type }}</strong>
                                {% if spData.placeOfWork ?? '' %}
                                    <span class="bozp-subpermit-card__place">— {{ spData.placeOfWork }}</span>
                                {% endif %}
                                <span class="bozp-status bozp-status--{{ sp.status }}">
                                    {{ sp.status|t('bozp') }}
                                </span>
                            </div>
                            <div class="bozp-subpermit-card__meta">
                                <span>{{ 'Platnosť do'|t('bozp') }}:
                                    <strong>{{ sp.expiresAt ? sp.expiresAt|date('d.m.Y H:i') : '—' }}</strong>
                                </span>
                                <a href="{{ url('bozp/c/' ~ token ~ '/subpermits/' ~ sp.id ~ '/pdf') }}"
                                   target="_blank" rel="noopener"
                                   class="bozp-subpermit-card__pdf-link">
                                    ⬇ PDF
                                </a>
                            </div>
                        </header>

                        {% if spData.workDescription ?? '' %}
                            <p class="bozp-subpermit-card__description">{{ spData.workDescription }}</p>
                        {% endif %}

                        <div class="bozp-subpermit-card__signatures">

                            {# ─── Pre-work signatures ────────────────────────── #}
                            <h3 class="bozp-detail-section__subtitle">{{ 'Pred začatím prác'|t('bozp') }}</h3>

                            {# Issuer pre-work #}
                            <div class="bozp-subpermit-card__sig-row">
                                {% if issuerPreworkSig %}
                                    {% set ipAsset = craft.assets().id(issuerPreworkSig.signatureAssetId).one() %}
                                    <span class="bozp-yn bozp-yn--yes">✓ {{ 'Vydavateľ podpísal pred prácou'|t('bozp') }}:</span>
                                    {{ issuerPreworkSig.signerName }}
                                    {% if ipAsset %}
                                        <img src="{{ ipAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                             class="bozp-signature__image">
                                    {% endif %}
                                {% else %}
                                    <span class="bozp-empty">{{ 'Vydavateľ ešte nepodpísal pred prácou.'|t('bozp') }}</span>
                                {% endif %}
                            </div>

                            {# Contractor pre-work #}
                            <div class="bozp-subpermit-card__sig-row">
                                {% if contractorPreworkSig %}
                                    {% set cpAsset = craft.assets().id(contractorPreworkSig.signatureAssetId).one() %}
                                    <span class="bozp-yn bozp-yn--yes">✓ {{ 'Dodávateľ podpísal pred prácou'|t('bozp') }}:</span>
                                    {{ contractorPreworkSig.signerName }}
                                    {% if contractorPreworkSig.signerEmployer %} ({{ contractorPreworkSig.signerEmployer }}){% endif %}
                                    {% if cpAsset %}
                                        <img src="{{ cpAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                             class="bozp-signature__image">
                                    {% endif %}
                                    <p class="bozp-signature__meta">
                                        {{ contractorPreworkSig.signatureDate ? contractorPreworkSig.signatureDate|date('d.m.Y') : '—' }}
                                    </p>
                                {% elseif issuerPreworkSig %}
                                    <form method="post" id="bozp-sp-prework-form-{{ sp.id }}"
                                          action="{{ url('bozp/c/' ~ token ~ '/subpermits/' ~ sp.id ~ '/sign-prework') }}">
                                        {{ csrfInput() }}
                                        <input type="hidden" name="action" value="bozp/contractor/sign-subpermit-prework">
                                        <input type="hidden" name="token" value="{{ token }}">
                                        <input type="hidden" name="id" value="{{ sp.id }}">
                                        <input type="hidden" name="signerName"     id="bozp-sp-pw-name-{{ sp.id }}">
                                        <input type="hidden" name="signerEmployer" id="bozp-sp-pw-employer-{{ sp.id }}">
                                        <input type="hidden" name="signatureDate"  id="bozp-sp-pw-date-{{ sp.id }}">
                                        <input type="hidden" name="signatureData"  id="bozp-sp-pw-data-{{ sp.id }}">
                                    </form>
                                    <p class="bozp-subpermit-card__sig-prompt">
                                        {{ 'Podpíšte pred začatím prác.'|t('bozp') }}
                                    </p>
                                    <button type="button" class="bozp-btn bozp-btn--primary bozp-sp-open-prework"
                                            data-sp-id="{{ sp.id }}"
                                            data-sp-label="{{ spLabelMap[sp.type] ?? sp.type }}">
                                        {{ 'Podpísať pred prácou'|t('bozp') }}
                                    </button>
                                {% else %}
                                    <span class="bozp-empty">{{ 'Po podpise vydavateľa budete môcť podpísať aj vy.'|t('bozp') }}</span>
                                {% endif %}
                            </div>

                            {# ─── Completion / cancel signatures (gated) ────── #}
                            <h3 class="bozp-detail-section__subtitle">{{ 'Pri dokončení / zrušení prác'|t('bozp') }}</h3>

                            {# Issuer completion #}
                            <div class="bozp-subpermit-card__sig-row">
                                {% if issuerSig %}
                                    {% set iAsset = craft.assets().id(issuerSig.signatureAssetId).one() %}
                                    <span class="bozp-yn bozp-yn--yes">✓ {{ 'Vydavateľ podpísal'|t('bozp') }}:</span>
                                    {{ issuerSig.signerName }}
                                    {% if iAsset %}
                                        <img src="{{ iAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                             class="bozp-signature__image">
                                    {% endif %}
                                {% else %}
                                    <span class="bozp-empty">{{ 'Vydavateľ ešte nepodpísal.'|t('bozp') }}</span>
                                {% endif %}
                            </div>

                            {# Contractor completion — gated on prework complete #}
                            <div class="bozp-subpermit-card__sig-row">
                                {% if contractorSig %}
                                    {% set cAsset = craft.assets().id(contractorSig.signatureAssetId).one() %}
                                    <span class="bozp-yn bozp-yn--yes">✓ {{ 'Dodávateľ podpísal'|t('bozp') }}:</span>
                                    {{ contractorSig.signerName }}
                                    {% if contractorSig.signerEmployer %} ({{ contractorSig.signerEmployer }}){% endif %}
                                    {% if cAsset %}
                                        <img src="{{ cAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                             class="bozp-signature__image">
                                    {% endif %}
                                    <p class="bozp-signature__meta">
                                        {{ contractorSig.signatureDate ? contractorSig.signatureDate|date('d.m.Y') : '—' }}
                                    </p>
                                {% elseif preworkComplete %}
                                    {# Hidden form — populated by the dialog JS before submit #}
                                    <form method="post" id="bozp-sp-sign-form-{{ sp.id }}"
                                          action="{{ url('bozp/c/' ~ token ~ '/subpermits/' ~ sp.id ~ '/sign') }}">
                                        {{ csrfInput() }}
                                        <input type="hidden" name="action" value="bozp/contractor/sign-subpermit">
                                        <input type="hidden" name="token" value="{{ token }}">
                                        <input type="hidden" name="id" value="{{ sp.id }}">
                                        <input type="hidden" name="signerName"        id="bozp-sp-sig-name-{{ sp.id }}">
                                        <input type="hidden" name="signerEmployer"    id="bozp-sp-sig-employer-{{ sp.id }}">
                                        <input type="hidden" name="signatureDate"     id="bozp-sp-sig-date-{{ sp.id }}">
                                        <input type="hidden" name="signatureData"     id="bozp-sp-sig-data-{{ sp.id }}">
                                        <input type="hidden" name="closureStatusJson" id="bozp-sp-sig-cs-{{ sp.id }}">
                                        <input type="hidden" name="requiresTestRun"   id="bozp-sp-sig-tr-{{ sp.id }}">
                                    </form>

                                    <p class="bozp-subpermit-card__sig-prompt">
                                        {{ 'Podpíšte dokončenie / zrušenie subpermitu'|t('bozp') }}
                                    </p>
                                    <button type="button" class="bozp-btn bozp-btn--primary bozp-sp-open-sign"
                                            data-sp-id="{{ sp.id }}"
                                            data-sp-label="{{ spLabelMap[sp.type] ?? sp.type }}">
                                        {{ 'Podpísať subpermit'|t('bozp') }}
                                    </button>
                                {% else %}
                                    <span class="bozp-empty">{{ 'Najprv musia byť obidva podpisy pred začatím prác.'|t('bozp') }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}

                {# ---- Shared signature dialog for subpermit contractor signing ---- #}
                <dialog id="bozp-sp-sign-dialog" class="bozp-dialog">
                    <form class="bozp-form bozp-form--sign" method="dialog">

                        {# Stage 1 — warning #}
                        <fieldset class="bozp-form-section bozp-dialog__stage" data-stage="warning">
                            <legend class="bozp-form-section__title" id="bozp-sp-dlg-title">{{ 'Podpis dodávateľa'|t('bozp') }}</legend>
                            <p class="bozp-form-section__hint">{{ 'Podpíšte subpermit ako dodávateľ pred začatím prác.'|t('bozp') }}</p>
                            <p class="bozp-form-section__hint bozp-form-section__hint--warning">
                                <strong>{{ 'Upozornenie'|t('bozp') }}:</strong>
                                {{ 'Podpisom potvrdzujete, že ste oboznámení s podmienkami subpermitu a zaviazali ste sa ich dodržiavať.'|t('bozp') }}
                            </p>
                            <div class="bozp-form__actions">
                                <button type="button" class="bozp-btn bozp-btn--secondary" data-bozp-action="cancel">
                                    {{ 'Zrušiť'|t('bozp') }}
                                </button>
                                <button type="button" class="bozp-btn bozp-btn--primary" data-bozp-action="proceed">
                                    {{ 'Pokračovať k podpisu'|t('bozp') }}
                                </button>
                            </div>
                        </fieldset>

                        {# Stage 2 — signature fields #}
                        <fieldset class="bozp-form-section bozp-dialog__stage" data-stage="form" hidden>
                            <legend class="bozp-form-section__title">{{ 'Podpis dodávateľa'|t('bozp') }}</legend>

                            <div class="bozp-form-row">
                                <label class="bozp-form-row__label">{{ 'Meno a priezvisko'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                                <input type="text" id="bozp-sp-dlg-name"
                                       value="{{ permit.contractorPersonName ?? '' }}" required>
                            </div>

                            <div class="bozp-form-row">
                                <label class="bozp-form-row__label">{{ 'Firma'|t('bozp') }}</label>
                                <input type="text" id="bozp-sp-dlg-employer"
                                       value="{{ permit.contractorCompany ?? '' }}">
                            </div>

                            <div class="bozp-form-row">
                                <label class="bozp-form-row__label">{{ 'Dátum podpisu'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                                <input type="date" id="bozp-sp-dlg-date"
                                       value="{{ 'now'|date('Y-m-d') }}" required>
                            </div>

                            <div class="bozp-form-row">
                                <label class="bozp-form-row__label">{{ 'Podpis'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                                <div class="bozp-sigpad">
                                    <canvas id="bozp-sp-dlg-canvas" width="520" height="180"></canvas>
                                </div>
                                <div class="bozp-form__actions bozp-form__actions--inline">
                                    <button type="button" class="bozp-btn bozp-btn--secondary" id="bozp-sp-dlg-clear">
                                        {{ 'Vyčistiť'|t('bozp') }}
                                    </button>
                                </div>
                            </div>

                            {# Completion-only fields: closure status + trial-operation #}
                            <div id="bozp-sp-dlg-closure-block" class="bozp-form-section__group">
                                <div class="bozp-form-row">
                                    <span class="bozp-form-row__label">{{ 'Stav po dokončení'|t('bozp') }} <span class="bozp-form-row__req">*</span></span>
                                    {% set closureLabels = {
                                        'work_completed':                  'Práce boli dokončené'|t('bozp'),
                                        'equipment_operational':           'Zariadenie je prevádzkyschopné'|t('bozp'),
                                        'equipment_not_operational':       'Zariadenie nie je prevádzkyschopné'|t('bozp'),
                                        'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené'|t('bozp'),
                                        'work_suspended':                  'Práce boli pozastavené'|t('bozp'),
                                    } %}
                                    <div class="bozp-form__checklist">
                                        {% for key, label in closureLabels %}
                                            <label class="bozp-form__check">
                                                <input type="checkbox" class="bozp-sp-dlg-cs" value="{{ key }}">
                                                <div class="custom_checkbox"></div>
                                                <span>{{ label }}</span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                </div>

                                <div class="bozp-form-row">
                                    <span class="bozp-form-row__label">{{ 'Vyžaduje sa skúšobná prevádzka?'|t('bozp') }} <span class="bozp-form-row__req">*</span></span>
                                    <div class="bozp-form__yesno">
                                        <label class="bozp-form__yesno-opt">
                                            <input type="radio" name="bozp-sp-dlg-tr" value="yes" required>
                                            <div class="custom_radio"></div>
                                            <span>{{ 'Áno'|t('bozp') }}</span>
                                        </label>
                                        <label class="bozp-form__yesno-opt">
                                            <input type="radio" name="bozp-sp-dlg-tr" value="no" required>
                                            <div class="custom_radio"></div>
                                            <span>{{ 'Nie'|t('bozp') }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="bozp-form__actions bozp-form__actions--split">
                                <button type="button" class="bozp-btn bozp-btn--secondary" data-bozp-action="back">
                                    {{ 'Späť'|t('bozp') }}
                                </button>
                                <button type="button" class="bozp-btn bozp-btn--primary" id="bozp-sp-dlg-submit">
                                    {{ 'Podpísať a odoslať'|t('bozp') }}
                                </button>
                            </div>
                        </fieldset>
                    </form>
                </dialog>

                <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
                <script>
                    (function () {
                        var dialog    = document.getElementById('bozp-sp-sign-dialog');
                        var stages    = dialog ? dialog.querySelectorAll('.bozp-dialog__stage') : [];
                        var canvas    = document.getElementById('bozp-sp-dlg-canvas');
                        var clearBtn  = document.getElementById('bozp-sp-dlg-clear');
                        var submitBtn = document.getElementById('bozp-sp-dlg-submit');
                        var pad       = null;
                        var activeSpId = null;
                        var activeMode = 'sign'; // 'sign' (completion) or 'prework'

                        function showStage(name) {
                            stages.forEach(function (s) {
                                s.hidden = s.getAttribute('data-stage') !== name;
                            });
                            if (name === 'form') initPad();
                        }

                        function initPad() {
                            if (!window.SignaturePad || !canvas) return;
                            if (pad) { pad.clear(); return; }
                            var ratio = Math.max(window.devicePixelRatio || 1, 1);
                            canvas.width  = canvas.offsetWidth  * ratio;
                            canvas.height = canvas.offsetHeight * ratio;
                            canvas.getContext('2d').scale(ratio, ratio);
                            pad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)', penColor: '#000' });
                        }

                        // Show/hide closure block based on mode
                        function updateClosureBlock() {
                            var block = document.getElementById('bozp-sp-dlg-closure-block');
                            if (block) block.hidden = (activeMode !== 'sign');
                        }

                        function resetClosureFields() {
                            document.querySelectorAll('.bozp-sp-dlg-cs').forEach(function (cb) { cb.checked = false; });
                            var radios = document.getElementsByName('bozp-sp-dlg-tr');
                            for (var i = 0; i < radios.length; i++) radios[i].checked = false;
                        }

                        // Open dialog when a "Podpísať subpermit" button is clicked (completion)
                        document.querySelectorAll('.bozp-sp-open-sign').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                activeSpId = btn.getAttribute('data-sp-id');
                                activeMode = 'sign';
                                resetClosureFields();
                                updateClosureBlock();
                                var label  = btn.getAttribute('data-sp-label') || '';
                                var title  = document.getElementById('bozp-sp-dlg-title');
                                if (title) title.textContent = '{{ 'Podpis dodávateľa'|t('bozp') }}' + (label ? ' — ' + label : '');
                                showStage('warning');
                                dialog.showModal ? dialog.showModal() : dialog.setAttribute('open', '');
                            });
                        });

                        // Open dialog for pre-work signing
                        document.querySelectorAll('.bozp-sp-open-prework').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                activeSpId = btn.getAttribute('data-sp-id');
                                activeMode = 'prework';
                                updateClosureBlock();
                                var label  = btn.getAttribute('data-sp-label') || '';
                                var title  = document.getElementById('bozp-sp-dlg-title');
                                if (title) title.textContent = '{{ 'Podpis dodávateľa — pred prácou'|t('bozp') }}' + (label ? ' — ' + label : '');
                                showStage('warning');
                                dialog.showModal ? dialog.showModal() : dialog.setAttribute('open', '');
                            });
                        });

                        // Stage navigation
                        if (dialog) {
                            dialog.addEventListener('click', function (e) {
                                var action = e.target.closest('[data-bozp-action]');
                                if (!action) return;
                                var a = action.getAttribute('data-bozp-action');
                                if (a === 'cancel') { dialog.close(); activeSpId = null; }
                                if (a === 'proceed') { showStage('form'); }
                                if (a === 'back')    { showStage('warning'); }
                            });
                        }

                        if (clearBtn) clearBtn.addEventListener('click', function () { if (pad) pad.clear(); });

                        if (submitBtn) {
                            submitBtn.addEventListener('click', function () {
                                var nameVal     = document.getElementById('bozp-sp-dlg-name').value.trim();
                                var employerVal = document.getElementById('bozp-sp-dlg-employer').value.trim();
                                var dateVal     = document.getElementById('bozp-sp-dlg-date').value.trim();
                                if (!nameVal) { alert('{{ 'Zadajte meno podpisujúceho.'|t('bozp') }}'); return; }
                                if (!pad || pad.isEmpty()) { alert('{{ 'Podpis je povinný.'|t('bozp') }}'); return; }
                                if (!activeSpId) return;

                                // For completion mode, validate closure fields too
                                var closureStatus = [];
                                var trVal = '';
                                if (activeMode === 'sign') {
                                    document.querySelectorAll('.bozp-sp-dlg-cs:checked').forEach(function (cb) {
                                        closureStatus.push(cb.value);
                                    });
                                    if (closureStatus.length === 0) {
                                        alert('{{ 'Vyberte aspoň jeden stav po dokončení.'|t('bozp') }}');
                                        return;
                                    }
                                    var radios = document.getElementsByName('bozp-sp-dlg-tr');
                                    for (var i = 0; i < radios.length; i++) {
                                        if (radios[i].checked) { trVal = radios[i].value; break; }
                                    }
                                    if (trVal === '') {
                                        alert('{{ 'Označte, či sa vyžaduje skúšobná prevádzka.'|t('bozp') }}');
                                        return;
                                    }
                                }

                                var prefix = activeMode === 'prework' ? 'bozp-sp-pw' : 'bozp-sp-sig';
                                var formId = activeMode === 'prework'
                                    ? ('bozp-sp-prework-form-' + activeSpId)
                                    : ('bozp-sp-sign-form-'    + activeSpId);

                                document.getElementById(prefix + '-name-'     + activeSpId).value = nameVal;
                                document.getElementById(prefix + '-employer-' + activeSpId).value = employerVal;
                                document.getElementById(prefix + '-date-'     + activeSpId).value = dateVal;
                                document.getElementById(prefix + '-data-'     + activeSpId).value = pad.toDataURL('image/png');

                                if (activeMode === 'sign') {
                                    document.getElementById('bozp-sp-sig-cs-' + activeSpId).value = JSON.stringify(closureStatus);
                                    document.getElementById('bozp-sp-sig-tr-' + activeSpId).value = trVal;
                                }

                                dialog.close();
                                document.getElementById(formId).submit();
                            });
                        }
                    })();
                </script>
            </section>
        {% endif %}

        {# ---------- Closure status labels (reused below) ----------------- #}
        {% set completionLabels = {
            'work_completed': 'Práce boli dokončené'|t('bozp'),
            'equipment_operational': 'Zariadenie je prevádzkyschopné'|t('bozp'),
            'equipment_not_operational': 'Zariadenie nie je prevádzkyschopné'|t('bozp'),
            'personnel_and_materials_removed': 'Všetky osoby opustili oblasť a materiály a zariadenia boli z oblasti odstránené'|t('bozp'),
        } %}
        {% set closureLabels = completionLabels|merge({
            'work_suspended': 'Práce boli pozastavené'|t('bozp'),
        }) %}

        {# ---------- Contractor signature (single step): Done or Cancel -- #}
        <section class="bozp-detail-section bozp-detail-section--closure">
            <h2 class="bozp-detail-section__title">{{ 'Dokončenie permitu'|t('bozp') }}</h2>

            {% if recipientClosureSignature %}
                {% set sigAsset = craft.assets().id(recipientClosureSignature.signatureAssetId).one() %}
                <div class="bozp-signature bozp-signature--signed">
                    {% set flags = permit.recipientClosureStatus ?? [] %}
                    {% if flags is iterable and flags|length > 0 %}
                        <ul class="bozp-closure__flags">
                            {% for f in flags %}
                                <li>✓ {{ closureLabels[f] ?? f }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if sigAsset %}
                        <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                             class="bozp-signature__image bozp-signature__image--lg">
                    {% endif %}
                    <div class="bozp-detail-list bozp-signature__meta">
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Podpísal'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ recipientClosureSignature.signerName }}</div>
                        </div>
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Dátum podpisu'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ recipientClosureSignature.signatureDate ? recipientClosureSignature.signatureDate|date('d.m.Y') : '—' }}</div>
                        </div>
                        <div class="bozp-detail-row">
                            <div class="bozp-detail-row__label">{{ 'Zaznamenané'|t('bozp') }}</div>
                            <div class="bozp-detail-row__value">{{ recipientClosureSignature.signedAt|date('d.m.Y H:i') }}</div>
                        </div>
                    </div>
                </div>
            {% elseif canClose or canCancel %}
                {% set ce = closeErrors ?? {} %}
                {% set cv = closeValues ?? {} %}
                {% set checked = cv.closureStatus ?? [] %}
                {% set xe = cancelErrors ?? {} %}
                {% set xv = cancelValues ?? {} %}

                <p class="bozp-detail-section__hint">
                    {{ 'Vyberte jednu z možností: dokončenie alebo zrušenie prác.'|t('bozp') }}
                </p>

                {% if not (allSubpermitsSigned ?? true) %}
                    <div class="bozp-alert bozp-alert--warning">
                        <strong>{{ 'Upozornenie'|t('bozp') }}:</strong>
                        {{ 'Pred uzatvorením permitu musíte podpísať všetky subpermity ({n} nepodpísaných).'|t('bozp', {n: unsignedSubpermitCount}) }}
                    </div>
                {% endif %}

                <div class="bozp-recipient-actions">
                    {% if canClose %}
                        <button type="button" class="bozp-btn bozp-btn--primary"
                                data-bozp-dialog-open="bozp-dialog-close">
                            {{ 'Práce dokončené'|t('bozp') }}
                        </button>
                    {% endif %}
                    {% if canCancel %}
                        <button type="button" class="bozp-btn bozp-btn--danger"
                                data-bozp-dialog-open="bozp-dialog-cancel">
                            {{ 'Práce zrušené'|t('bozp') }}
                        </button>
                    {% endif %}
                </div>

                {# Modal A: Work done — completion checkboxes #}
                {% if canClose %}
                    {% set completionExtra %}
                        <div class="bozp-form-row{% if ce.closureStatus is defined %} bozp-form-row--error{% endif %}">
                            <label class="bozp-form-row__label">{{ 'Stav po dokončení'|t('bozp') }} <span class="bozp-form-row__req">*</span></label>
                            <div class="bozp-form__checklist">
                                {% for key, label in completionLabels %}
                                    <label class="bozp-form__check">
                                        <input type="checkbox" name="closureStatus[]" value="{{ key }}"
                                               {% if key in checked %}checked{% endif %}>
                                        <div class="custom_checkbox"></div>
                                        <span>{{ label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                            {% if ce.closureStatus is defined %}
                                <p class="bozp-form-row__error">{{ ce.closureStatus }}</p>
                            {% endif %}
                        </div>
                    {% endset %}

                    {% include 'bozp/site/_sign-dialog.twig' with {
                        id: 'bozp-dialog-close',
                        action: url('bozp/c/' ~ token ~ '/close'),
                        openOnLoad: ce|length > 0,
                        title: 'Práce dokončené'|t('bozp'),
                        intro: 'Potvrdzujete, že práce na tomto permite boli ukončené. Označte aktuálny stav pracoviska.'|t('bozp'),
                        warning: 'Po podpise dokončenia sa už údaje nedajú meniť.'|t('bozp'),
                        submitLabel: 'Podpísať a potvrdiť'|t('bozp'),
                        showEmployer: false,
                        errors: ce,
                        values: cv,
                        extraFields: completionExtra,
                    } only %}
                {% endif %}

                {# Modal B: Work cancelled — reason textarea #}
                {% if canCancel %}
                    {% set cancelExtra %}
                        <div class="bozp-form-row{% if xe.reason is defined %} bozp-form-row--error{% endif %}">
                            <label class="bozp-form-row__label">{{ 'Dôvod zrušenia'|t('bozp') }}</label>
                            <textarea name="reason" rows="3"
                                      placeholder="{{ 'Krátko popíšte, prečo nie je možné práce vykonať.'|t('bozp') }}">{{ xv.reason ?? '' }}</textarea>
                            {% if xe.reason is defined %}
                                <p class="bozp-form-row__error">{{ xe.reason }}</p>
                            {% endif %}
                        </div>
                    {% endset %}

                    {% include 'bozp/site/_sign-dialog.twig' with {
                        id: 'bozp-dialog-cancel',
                        action: url('bozp/c/' ~ token ~ '/cancel'),
                        openOnLoad: xe|length > 0,
                        title: 'Zrušenie prác'|t('bozp'),
                        intro: 'Potvrdzujete, že práce nemôžu byť vykonané za týchto podmienok a permit má byť zrušený.'|t('bozp'),
                        warning: 'Po podpise zrušenia sa permit uzamkne ako zrušený a nedá sa znova otvoriť.'|t('bozp'),
                        submitLabel: 'Zrušiť a podpísať'|t('bozp'),
                        showEmployer: false,
                        errors: xe,
                        values: xv,
                        extraFields: cancelExtra,
                    } only %}
                {% endif %}
            {% else %}
                <p class="bozp-empty">
                    {{ 'Dokončenie zatiaľ nie je možné.'|t('bozp') }}
                </p>
            {% endif %}
        </section>

        {# ---------- Shared signature_pad runtime (binds all dialogs) ---- #}
        {% if canClose or canCancel %}
            <script src="https://cdn.jsdelivr.net/npm/signature_pad@4/dist/signature_pad.umd.min.js"></script>
            <script>
                (function () {
                    document.querySelectorAll('[data-bozp-dialog-open]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var d = document.getElementById(btn.getAttribute('data-bozp-dialog-open'));
                            if (d) bozpOpenDialog(d, 'warning');
                        });
                    });

                    document.querySelectorAll('.bozp-sign-dialog').forEach(function (dialog) {
                        var stages = dialog.querySelectorAll('.bozp-dialog__stage');
                        var canvas = dialog.querySelector('canvas[data-bozp-sigpad]');
                        var hidden = dialog.querySelector('input[name="signatureData"]');
                        var clearBtn = dialog.querySelector('[data-bozp-sigpad-clear]');
                        var cancelBtn = dialog.querySelector('[data-bozp-action="cancel"]');
                        var proceedBtn = dialog.querySelector('[data-bozp-action="proceed"]');
                        var backBtn = dialog.querySelector('[data-bozp-action="back"]');
                        var pad = null;

                        function showStage(name) {
                            stages.forEach(function (s) {
                                s.hidden = (s.getAttribute('data-stage') !== name);
                            });
                            if (name === 'form') {
                                window.requestAnimationFrame(initPad);
                            }
                        }

                        function initPad() {
                            if (!window.SignaturePad || !canvas) { return; }
                            if (!pad) {
                                pad = new SignaturePad(canvas, {
                                    backgroundColor: 'rgba(255,255,255,1)',
                                    penColor: '#000',
                                });
                            }
                            var ratio = Math.max(window.devicePixelRatio || 1, 1);
                            canvas.width = canvas.offsetWidth * ratio;
                            canvas.height = canvas.offsetHeight * ratio;
                            canvas.getContext('2d').scale(ratio, ratio);
                            pad.clear();
                        }

                        if (cancelBtn) cancelBtn.addEventListener('click', function () { dialog.close(); });
                        if (proceedBtn) proceedBtn.addEventListener('click', function () { showStage('form'); });
                        if (backBtn) backBtn.addEventListener('click', function () { showStage('warning'); });
                        if (clearBtn) clearBtn.addEventListener('click', function () { if (pad) pad.clear(); });

                        dialog.bozpShowStage = showStage;

                        var form = dialog.querySelector('form');
                        if (form) {
                            form.addEventListener('submit', function () {
                                if (hidden) hidden.value = (pad && !pad.isEmpty()) ? pad.toDataURL('image/png') : '';
                            });
                        }

                        var openOnLoad = dialog.getAttribute('data-open-on-load');
                        if (openOnLoad) bozpOpenDialog(dialog, openOnLoad);
                    });

                    function bozpOpenDialog(dialog, initialStage) {
                        if (dialog.bozpShowStage) dialog.bozpShowStage(initialStage || 'warning');
                        if (typeof dialog.showModal === 'function') dialog.showModal();
                        else dialog.setAttribute('open', '');
                    }
                    window.bozpOpenDialog = bozpOpenDialog;
                })();
            </script>
        {% endif %}

        {# ---------- Control visits list ---------------------------------- #}
        {% if controls is defined and controls|length > 0 %}
            {% set resultLabels = {
                'ok':      'V poriadku'|t('bozp'),
                'issues':  'Zistené nedostatky'|t('bozp'),
                'stopped': 'Práce zastavené'|t('bozp'),
            } %}
            <section class="bozp-detail-section bozp-detail-section--controls">
                <h2 class="bozp-detail-section__title">{{ 'Kontroly prevádzky'|t('bozp') }}</h2>
                <table class="bozp-detail-table">
                    <thead>
                        <tr>
                            <th>{{ 'Dátum a čas'|t('bozp') }}</th>
                            <th>{{ 'Kontrolór'|t('bozp') }}</th>
                            <th>{{ 'Výsledok'|t('bozp') }}</th>
                            <th>{{ 'Podpis'|t('bozp') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in controls %}
                            <tr>
                                <td>{{ c.controlledAt|date('d.m.Y H:i') }}</td>
                                <td>{{ c.controllerName }}</td>
                                <td>
                                    <span class="bozp-status bozp-status--{{ c.result }}">
                                        {{ resultLabels[c.result] ?? c.result }}
                                    </span>
                                    {% if c.notes %}
                                        <p class="bozp-detail-table__note">{{ c.notes }}</p>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if c.signatureAssetId %}
                                        {% set sigAsset = craft.assets().id(c.signatureAssetId).one() %}
                                        {% if sigAsset %}
                                            <img src="{{ sigAsset.url }}" alt="{{ 'Podpis'|t('bozp') }}"
                                                 class="bozp-signature__image bozp-signature__image--sm">
                                        {% endif %}
                                    {% else %}
                                        <span class="bozp-empty">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endif %}

        {# ---------- Attachments: list + upload --------------------------- #}
        <section class="bozp-detail-section bozp-detail-section--uploads">
            <h2 class="bozp-detail-section__title">{{ 'Prílohy dodávateľa'|t('bozp') }}</h2>

            {% if attachments is not empty %}
                <ul class="bozp-attachments">
                    {% for a in attachments %}
                        {% set asset = craft.assets().id(a.assetId).one() %}
                        <li>
                            {% if asset %}
                                <a href="{{ asset.url }}" target="_blank" rel="noopener">{{ asset.filename }}</a>
                                <span class="bozp-attachments__meta">
                                    · {{ a.dateCreated|date('d.m.Y H:i') }}
                                </span>
                            {% else %}
                                <span class="bozp-attachments__missing">{{ 'Súbor nie je dostupný'|t('bozp') }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="bozp-attachments__empty">{{ 'Zatiaľ neboli nahrané žiadne prílohy.'|t('bozp') }}</p>
            {% endif %}

            {# Upload form is locked once the contractor has signed the permit
               (either complete or cancel). Server-side check mirrors this. #}
            {% if recipientClosureSignature %}
                <p class="bozp-empty">
                    {{ 'Permit je uzamknutý — ďalšie prílohy už nie je možné pridávať.'|t('bozp') }}
                </p>
            {% else %}
                <form method="post"
                      action="{{ url('bozp/c/' ~ token ~ '/upload') }}"
                      enctype="multipart/form-data"
                      class="bozp-form bozp-form--upload"
                      novalidate>
                    {{ csrfInput() }}

                    <div class="bozp-form-row">
                        <label for="attachment" class="bozp-form-row__label">{{ 'Nahrať súbor (PDF, DOCX, JPG, PNG, max 10 MB)'|t('bozp') }}</label>
                        <input type="file"
                               id="attachment"
                               name="attachment"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png"
                               required>
                    </div>

                    <div class="bozp-form__actions">
                        <button type="submit" class="bozp-btn bozp-btn--primary">
                            {{ 'Nahrať'|t('bozp') }}
                        </button>
                    </div>
                </form>
            {% endif %}
        </section>

    </section>
{% endblock %}
