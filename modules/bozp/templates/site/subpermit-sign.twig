{% extends 'bozp/site/_layout.twig' %}

{#
  Public subpermit signing page — no login required.
  Variables:
    request       SubpermitSigningRequestRecord
    subpermit     SubpermitRecord
    permit        PermitRecord
    role          SubpermitSigningRole|null
    data          array  (decoded subpermit JSON data)
    alreadySigned bool
    errors        array<string, string>
    values        array  (re-populated on validation failure)
#}

{% set subpermitTypeLabel = subpermit.type|capitalize %}
{% set dialogId = 'bozp-sp-sign-dialog' %}

{% block title %}
    {% if alreadySigned %}
        {{ 'Podpis bol zaznamenaný'|t('bozp') }}
    {% else %}
        {{ 'Podpis subpermitu — permit {n}'|t('bozp', {n: permit.permitNumber}) }}
    {% endif %}
{% endblock %}

{% block content %}
<section class="bozp-page bozp-page--subpermit-sign">

    {# ── Header ────────────────────────────────────────────────────────── #}
    <header class="bozp-page__header">
        <p class="bozp-page__eyebrow">
            {{ 'Elektronický podpis subpermitu'|t('bozp') }}
        </p>
        <h1>
            {{ 'Permit'|t('bozp') }} {{ permit.permitNumber }}
        </h1>
        {% if permit.workLocation %}
            <p style="margin:0 0 12px;color:#444;font-size:14px;">{{ permit.workLocation }}</p>
        {% endif %}

        {# PDF preview — gives the signer the full subpermit document before they sign. #}
        <a href="{{ url('sign/' ~ request.token ~ '/pdf') }}"
           target="_blank"
           rel="noopener"
           class="bozp-btn bozp-btn--primary bozp-btn--sm bozp-btn--pdf">
            ⬇ {{ 'Zobraziť PDF subpermitu'|t('bozp') }}
        </a>
    </header>

    {# ── Already signed ────────────────────────────────────────────────── #}
    {% if alreadySigned %}
        <div class="bozp-alert bozp-alert--success">
            <p>
                ✓ {{ 'Podpis bol úspešne zaznamenaný'|t('bozp') }}
            </p>
            {% if request.signerName %}
                <p>
                    {{ 'Podpísal/a: {name}'|t('bozp', {name: request.signerName}) }}
                </p>
            {% endif %}
            {% if request.signedAt %}
                <p>
                    {{ request.signedAt|date('d.m.Y H:i') }}
                </p>
            {% endif %}
        </div>
        <p>
            {{ 'Túto záložku môžete zavrieť. Ďakujeme.'|t('bozp') }}
        </p>

    {# ── Signing form (opens as modal) ─────────────────────────────────── #}
    {% else %}

        {# Role badge #}
        {% if role %}
            <div style="display:inline-block;padding:4px 12px;border-radius:20px;
                        background:#4F2170;color:#FEFFFD;font-size:13px;font-weight:700;margin-bottom:20px;">
                {{ role.label() }}
            </div>
        {% endif %}

        {# General error #}
        {% if errors.general is defined %}
            <div class="bozp-alert bozp-alert--danger"
                 style="background:#fff1f1;border-left:4px solid #000000;padding:12px 16px;border-radius:4px;margin-bottom:20px;">
                {{ errors.general }}
            </div>
        {% endif %}

        {# Permit + subpermit summary #}
        <div style="background:#FEFFFD;border:1px solid #4F2170;border-radius:6px;padding:16px 20px;margin-bottom:24px;">
            <p style="margin:0 0 10px;font-size:13px;font-weight:700;color:#4F2170;text-transform:uppercase;letter-spacing:1px;">
                {{ 'Prehľad povolenia'|t('bozp') }}
            </p>
            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <tr>
                    <td style="padding:3px 0;color:#555;width:160px;">{{ 'Číslo povolenia'|t('bozp') }}</td>
                    <td style="padding:3px 0;font-weight:700;">{{ permit.permitNumber }}</td>
                </tr>
                {% if permit.contractorCompany %}
                    <tr>
                        <td style="padding:3px 0;color:#555;">{{ 'Dodávateľ'|t('bozp') }}</td>
                        <td style="padding:3px 0;">{{ permit.contractorCompany }}</td>
                    </tr>
                {% endif %}
                {% if permit.workLocation %}
                    <tr>
                        <td style="padding:3px 0;color:#555;">{{ 'Miesto práce'|t('bozp') }}</td>
                        <td style="padding:3px 0;">{{ permit.workLocation }}</td>
                    </tr>
                {% endif %}
                {% if data.voltageLevel is defined and data.voltageLevel %}
                    <tr>
                        <td style="padding:3px 0;color:#555;">{{ 'Napätie'|t('bozp') }}</td>
                        <td style="padding:3px 0;">{{ data.voltageLevel }} V</td>
                    </tr>
                {% endif %}
                {% if data.circuitId is defined and data.circuitId %}
                    <tr>
                        <td style="padding:3px 0;color:#555;">{{ 'Obvod / rozvádzač'|t('bozp') }}</td>
                        <td style="padding:3px 0;">{{ data.circuitId }}</td>
                    </tr>
                {% endif %}
                {% if data.workDescription is defined and data.workDescription %}
                    <tr>
                        <td style="padding:3px 0;color:#555;">{{ 'Popis práce'|t('bozp') }}</td>
                        <td style="padding:3px 0;">{{ data.workDescription }}</td>
                    </tr>
                {% endif %}
            </table>
        </div>

        {% if not (parentApproved ?? true) %}
            {# General permit not yet HSE-approved — signing locked. #}
            <div class="bozp-alert bozp-alert--warning"
                 style="background:#fff4e0;border-left:4px solid #d97706;padding:12px 16px;color:#7a3e00;margin-bottom:16px;">
                {{ 'Podpis bude možný až po schválení hlavného permitu zo strany HSE. Skúste to prosím neskôr.'|t('bozp') }}
            </div>
        {% else %}
        {# Trigger button — opens the shared signature modal. #}
        <div class="bozp-form__actions">
            <button type="button"
                    class="bozp-btn bozp-btn--primary"
                    data-bozp-open-dialog="{{ dialogId }}">
                {{ 'Podpísať'|t('bozp') }}
            </button>
        </div>

        {# Shared signature modal — includes legal acknowledgment. #}
        {% set roleLabel = role ? role.label() : subpermit.type %}
        {% set introText = 'Podpisom potvrdzujete, že ste si preštudovali podmienky subpermitu a súhlasíte s nimi v roli <strong>{role}</strong>.'|t('bozp', {role: roleLabel}) %}
        {% set warningText = 'Elektronický podpis je právne záväzný. Uistite sa, že vypĺňate správne údaje.'|t('bozp') %}

        {% include 'bozp/site/_sign-dialog.twig' with {
            id:           dialogId,
            action:       url('sign/submit'),
            openOnLoad:   errors is not empty,
            title:        'Podpis subpermitu'|t('bozp'),
            intro:        introText,
            warning:      warningText,
            submitLabel:  'Podpísať'|t('bozp'),
            showEmployer: false,
            showJobTitle: true,
            showDate:     false,
            errors:       errors ?? {},
            values:       values ?? {},
            extraFields:  '<input type="hidden" name="action" value="bozp/subpermit-signing/sign"><input type="hidden" name="token" value="' ~ request.token ~ '">',
        } only %}
        {% endif %}
    {% endif %}

</section>

{# ── Dialog + signature-pad JS ─────────────────────────────────────────── #}
{% if not alreadySigned %}
<script>
(function () {
    const dialog = document.getElementById('{{ dialogId }}');
    if (!dialog) return;

    const openBtns  = document.querySelectorAll('[data-bozp-open-dialog="{{ dialogId }}"]');
    const stages    = dialog.querySelectorAll('[data-stage]');
    const proceedBt = dialog.querySelector('[data-bozp-action="proceed"]');
    const cancelBt  = dialog.querySelector('[data-bozp-action="cancel"]');
    const backBt    = dialog.querySelector('[data-bozp-action="back"]');
    const canvas    = dialog.querySelector('[data-bozp-sigpad]');
    const clearBt   = dialog.querySelector('[data-bozp-sigpad-clear]');
    const sigInput  = dialog.querySelector('input[name="signatureData"]');
    const form      = dialog.querySelector('form');

    function showStage(name) {
        stages.forEach(function (s) {
            s.hidden = s.getAttribute('data-stage') !== name;
        });
    }

    function open(stage) {
        if (typeof dialog.showModal === 'function') {
            dialog.showModal();
        } else {
            dialog.setAttribute('open', '');
        }
        showStage(stage || 'warning');
    }

    function close() {
        if (typeof dialog.close === 'function') {
            dialog.close();
        } else {
            dialog.removeAttribute('open');
        }
    }

    openBtns.forEach(function (b) { b.addEventListener('click', function () { open('warning'); }); });
    if (proceedBt) proceedBt.addEventListener('click', function () { showStage('form'); });
    if (backBt)    backBt.addEventListener('click', function () { showStage('warning'); });
    if (cancelBt)  cancelBt.addEventListener('click', function () { close(); });

    // Auto-open on validation re-render.
    if (dialog.hasAttribute('data-open-on-load')) {
        open(dialog.getAttribute('data-open-on-load') || 'form');
    }

    // ── Signature pad ───────────────────────────────────────────────
    if (!canvas || !sigInput) return;
    const ctx = canvas.getContext('2d');
    let drawing = false;
    let hasMark = false;

    function pos(e) {
        const r = canvas.getBoundingClientRect();
        const scaleX = canvas.width  / r.width;
        const scaleY = canvas.height / r.height;
        const src = e.touches ? e.touches[0] : e;
        return [(src.clientX - r.left) * scaleX, (src.clientY - r.top) * scaleY];
    }

    ctx.strokeStyle = '#000';
    ctx.lineWidth   = 2;
    ctx.lineCap     = 'round';
    ctx.lineJoin    = 'round';

    function start(e) {
        e.preventDefault();
        drawing = true;
        const [x, y] = pos(e);
        ctx.beginPath();
        ctx.moveTo(x, y);
    }
    function move(e) {
        if (!drawing) return;
        e.preventDefault();
        const [x, y] = pos(e);
        ctx.lineTo(x, y);
        ctx.stroke();
        hasMark = true;
    }
    function stop() {
        if (!drawing) return;
        drawing = false;
        if (hasMark) {
            sigInput.value = canvas.toDataURL('image/png');
        }
    }

    canvas.addEventListener('mousedown',  start);
    canvas.addEventListener('mousemove',  move);
    canvas.addEventListener('mouseup',    stop);
    canvas.addEventListener('mouseleave', stop);
    canvas.addEventListener('touchstart', start, { passive: false });
    canvas.addEventListener('touchmove',  move,  { passive: false });
    canvas.addEventListener('touchend',   stop);

    if (clearBt) {
        clearBt.addEventListener('click', function () {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            sigInput.value = '';
            hasMark = false;
        });
    }

    // Block submit if no signature drawn.
    if (form) {
        form.addEventListener('submit', function (e) {
            if (!hasMark || !sigInput.value) {
                e.preventDefault();
                alert('{{ "Prosím, podpíšte sa pred odoslaním."|t("bozp") }}');
            }
        });
    }
})();
</script>
{% endif %}
{% endblock %}
